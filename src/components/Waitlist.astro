---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  id?: string;
}

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const { id = 'waitlist' } = Astro.props;
const messages = {
  ok: t('waitlist.ok'),
  invalid: t('waitlist.invalid'),
  'slow-down': t('waitlist.slow-down'),
  error: t('waitlist.error'),
  sending: t('waitlist.sending'),
};
---

<form class="waitlist" method="post" action="/api/waitlist" data-messages={JSON.stringify(messages)}>
  <input type="hidden" name="locale" value={lang} />
  <div class="honeypot" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <label class="visually-hidden" for={`${id}-email`}>{t('waitlist.label')}</label>
  <div class="row">
    <input
      id={`${id}-email`}
      class="field"
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder={t('waitlist.placeholder')}
    />
    <button class="btn" type="submit">{t('waitlist.cta')}</button>
  </div>
  <p class="status" role="status" aria-live="polite">{t('waitlist.note')}</p>
</form>

<style>
  .waitlist {
    width: 100%;
    max-width: 460px;
  }
  .row {
    display: flex;
    gap: 8px;
  }
  .field {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 16px;
    font: inherit;
    color: var(--ink);
    background: var(--paper-light);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--motion-fast) ease,
      box-shadow var(--motion-fast) ease;
  }
  .field::placeholder {
    color: var(--ink-tertiary);
  }
  .field:focus {
    outline: none;
    border-color: var(--moss);
    box-shadow: 0 0 0 3px var(--moss-wash);
  }
  .status {
    margin-top: 12px;
    font-size: var(--text-body-sm);
    color: var(--ink-tertiary);
  }
  .waitlist[data-state='ok'] .status {
    color: var(--moss-dark);
  }
  .waitlist[data-state='ok'] .row {
    display: none;
  }
  .honeypot {
    position: absolute;
    left: -9999px;
  }
  @media (max-width: 480px) {
    .row {
      flex-direction: column;
    }
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.waitlist')) {
    const messages = JSON.parse(form.dataset.messages ?? '{}');
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = messages.sending;
      let outcome = 'error';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        outcome = (await res.json()).outcome ?? 'error';
      } catch {
        // Network failure: fall through to the generic error message.
      }
      form.dataset.state = outcome;
      status.textContent = messages[outcome] ?? messages.error;
      button.disabled = false;
    });
  }
</script>
