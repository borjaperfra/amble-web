---
import Base from '../layouts/Base.astro';
import Blocks from './manifesto/Blocks.astro';
import { manifesto } from '../content/pages';
import type { Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const c = manifesto[lang];
---

<Base title={c.meta.title} description={c.meta.description} path="manifesto">
  <main class="manifesto container">
    <header class="head">
      <p class="kicker">{c.kicker}</p>
      <h1 class="display title">{c.title}</h1>
      <p class="thesis">
        <span>{c.thesis[0]}</span>
        <em>{c.thesis[1]}</em>
      </p>
    </header>

    <div class="essay">
      <Blocks blocks={c.intro} figures={c.figures} />
    </div>

    <p class="kicker principles-label">{c.principlesLabel}</p>
    <ol class="principles" role="list">
      {
        c.principles.map((p, i) => (
          <li class="principle" data-reveal>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="heading p-title">{p.title}</h2>
            <p class="p-body">{p.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="essay future">
      <Blocks blocks={c.future} figures={c.figures} />
    </div>
  </main>
</Base>

<style>
  .manifesto {
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
    padding-block: var(--space-9) var(--space-section);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 52rem;
  }
  .title {
    font-size: var(--text-display-xl);
  }
  .thesis {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-heading-lg);
    line-height: var(--leading-heading);
  }
  .thesis em {
    color: var(--color-accent-strong);
  }
  .essay {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 46rem;
    margin-top: var(--space-9);
  }
  .principles-label {
    margin-top: var(--space-10);
  }
  .principles {
    margin-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
  .principle {
    display: grid;
    gap: var(--space-2) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  @media (min-width: 860px) {
    .principle {
      grid-template-columns: 5rem minmax(0, 5fr) minmax(0, 6fr);
      align-items: baseline;
    }
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-accent-strong);
  }
  .p-title {
    font-size: var(--text-heading-lg);
  }
  .p-body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
</style>
