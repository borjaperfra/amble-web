---
// For companies: the problem first (the people you want aren't applying),
// then mutual intent, the silent negotiation, the salary rule, and an
// early-access waitlist (audience "company").
import Base from '../layouts/Base.astro';
import Waitlist from './Waitlist.astro';
import Symbol from './Symbol.astro';
import SectionIntro from './SectionIntro.astro';
import DotField from './DotField.astro';
import AgentLine from './AgentLine.astro';
import RangeFigure from './companies/RangeFigure.astro';
import { companies } from '../content/companies';
import type { Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const c = companies[lang];
---

<Base title={c.meta.title} description={c.meta.description} path="companies" joinHref="#company-join" joinLabel={c.cta}>
  <main>
    <!-- Hero: the thesis, and the inbox that can't see who matters -->
    <section class="hero container" id="company-join" aria-labelledby="co-title">
      <p class="badge">{c.badge}</p>
      <p class="kicker">{c.kicker}</p>
      <h1 class="display title" id="co-title">
        {c.title[0]}
        <br />
        <em>{c.title[1]}</em>
      </h1>
      <p class="lede">
        {c.lede[0]}
        <br />
        <strong>{c.lede[1]}</strong>
      </p>
      <div class="form"><Waitlist id="company-hero" audience="company" cta={c.cta} note={c.formPrivacy} /></div>
      <p class="note">{c.formNote}</p>
      <div class="inbox-field">
        <DotField variant="inbox" inboxLabel={`${c.inbox.inbox} · ${c.inbox.applied}`} outsideTags={[c.inbox.tags[2], c.inbox.tags[0], c.inbox.tags[3]]} />
      </div>
    </section>

    <!-- The problem -->
    <section class="problem" aria-labelledby="co-problem">
      <div class="container problem-inner">
        <h2 class="display p-title" id="co-problem" data-reveal>
          {c.problem.title[0]}
          <br />
          <em>{c.problem.title[1]}</em>
        </h2>
        <div class="p-body">
          {c.problem.body.map((p, i) => <p data-reveal style={`--i:${i}`}>{p}</p>)}
          <p class="p-closer heading" data-reveal>{c.problem.closer}</p>
        </div>
      </div>
    </section>

    <!-- Mutual intent -->
    <section class="section container pitch" aria-labelledby="co-pitch">
      <div class="pitch-grid">
        <div>
          <h2 class="display pitch-title" id="co-pitch" data-reveal>
            {c.pitch.title[0]}
            <br />
            <em>{c.pitch.title[1]}</em>
          </h2>
          {c.pitch.body.map((p) => <p class="pitch-p" data-reveal>{p}</p>)}
          <p class="pitch-after" data-reveal>{c.pitch.after}</p>
        </div>
        <div class="shift" data-scene aria-label={`${c.funnel.old[0]} → ${c.funnel.next.join(' ')}`}>
          <p class="q-swap">
            <span class="q old heading">{c.funnel.old[0]}</span>
            <span class="q new heading">{c.funnel.next[0]}</span>
          </p>
          <p class="q-then">{c.funnel.next[1]}</p>
          <p class="q-then">{c.funnel.next[2]}</p>
        </div>
      </div>

      <ol class="sequence" role="list" data-scene>
        {
          c.sequence.steps.map((st, i) => (
            <li class:list={{ last: i === c.sequence.steps.length - 1 }} style={`--i:${i}`}>
              {st}
            </li>
          ))
        }
      </ol>
      <ul class="nos" role="list">
        {c.sequence.nos.map((n, i) => <li data-reveal style={`--i:${i}`}><span class="x" aria-hidden="true">✕</span>{n}</li>)}
      </ul>
      <p class="seq-closer display" data-reveal>
        {c.sequence.closer[0]}
        <br />
        <em>{c.sequence.closer[1]}</em>
      </p>
    </section>

    <!-- Agent ↔ Rep -->
    <section class="section container nego-section" aria-labelledby="co-nego">
      <SectionIntro id="co-nego" kicker={c.negotiation.kicker} title={c.negotiation.title} align="center" level="observation" />
      <div class="nego-line">
        <AgentLine left={c.negotiation.agent} right={c.negotiation.rep} signals={c.negotiation.signals} result={c.negotiation.mutual} note={c.negotiation.question} />
      </div>
    </section>

    <!-- The salary rule -->
    <section class="salary" aria-labelledby="co-salary">
      <div class="container salary-grid">
        <div>
          <p class="kicker s-kicker">{c.salary.kicker}</p>
          <h2 class="display s-title" id="co-salary">{c.salary.title}</h2>
          <p class="s-body">{c.salary.body}</p>
          <ul class="rules" role="list">
            {c.salary.rules.map((r) => <li><span class="tick" aria-hidden="true">✓</span>{r}</li>)}
          </ul>
        </div>
        <RangeFigure c={c.salary} />
      </div>
    </section>

    <!-- What it never does -->
    <section class="never" aria-labelledby="co-never">
      <div class="container never-grid">
        <SectionIntro id="co-never" kicker={c.never.kicker} title={c.never.title} />
        <ul class="never-list" role="list">
          {c.never.items.map((it, i) => <li data-reveal style={`--i:${i}`}><span class="x" aria-hidden="true">✕</span>{it}</li>)}
        </ul>
      </div>
    </section>

    <!-- Close -->
    <section class="finale container" aria-labelledby="co-finale">
      <Symbol size={40} breathe />
      <h2 class="display f-title" id="co-finale">{c.finale.title}</h2>
      <p class="lede">{c.finale.body}</p>
      <div class="form"><Waitlist id="company-finale" audience="company" cta={c.cta} note={c.formPrivacy} /></div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-10) var(--space-section);
  }
  .badge {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1.5px dashed var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .hero .kicker {
    margin-top: var(--space-7);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-thesis);
  }
  .inbox-field {
    width: 100%;
    max-width: var(--width-wide);
    margin-top: var(--space-9);
  }
  .hero .lede {
    max-width: 38rem;
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
  }
  .hero .lede strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .form {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-7);
  }
  .note {
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* The problem, in a sunken band */
  .problem {
    padding-block: var(--space-section);
    background: var(--color-surface-sunken);
  }
  .problem-inner {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  @media (min-width: 900px) {
    .problem-inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-9);
    }
  }
  .p-title,
  .pitch-title {
    font-size: var(--text-chapter);
  }
  /* Who applied? → Who should we talk to? Typography, not a diagram. */
  .shift {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .q-swap {
    display: grid;
  }
  .q {
    grid-area: 1 / 1;
    font-size: var(--text-observation);
    transition:
      opacity 0.7s ease,
      translate 0.8s var(--ease-standard),
      text-decoration-color 0.4s ease;
  }
  .q.old {
    color: var(--color-text-faint);
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--color-retracted);
    opacity: 0;
  }
  .q.new {
    color: var(--color-accent-strong);
  }
  .q-then {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-text-muted);
    transition: opacity 0.7s ease;
  }
  :global(.motion) .shift .q.old {
    opacity: 1;
    text-decoration-color: transparent;
    transition-delay: 0s, 0s, 0.5s;
  }
  :global(.motion) .shift.is-playing .q.old {
    text-decoration-color: var(--color-retracted);
    opacity: 0;
    translate: 0 -8px;
    transition-delay: 1.2s, 1.2s, 0.5s;
  }
  :global(.motion) .shift:not(.is-playing) .q.new {
    opacity: 0;
    translate: 0 8px;
  }
  :global(.motion) .shift .q.new {
    transition-delay: 1.7s;
  }
  :global(.motion) .shift:not(.is-playing) .q-then {
    opacity: 0;
  }
  .shift .q-then:nth-of-type(2) {
    transition-delay: 2.4s;
  }
  .shift .q-then:nth-of-type(3) {
    transition-delay: 2.9s;
  }
  .nego-line {
    margin-top: var(--space-scene);
  }
  .p-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .p-closer {
    margin-top: var(--space-2);
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
  }

  /* Mutual intent */
  .pitch {
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  .pitch-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 900px) {
    .pitch-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-9);
    }
  }
  .pitch-p {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .pitch-after {
    margin-top: var(--space-5);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-medium);
  }
  .sequence {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-9);
    text-align: center;
  }
  .sequence li {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    transition:
      opacity 0.5s ease,
      translate 0.6s var(--ease-standard);
    transition-delay: calc(var(--i) * 0.35s);
  }
  .sequence li + li::before {
    content: '↓';
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-body);
    color: var(--color-accent);
  }
  .sequence li.last {
    color: var(--color-accent-strong);
    font-size: var(--text-heading-lg);
  }
  :global(.motion) .sequence:not(.is-playing) li {
    opacity: 0;
    translate: 0 8px;
  }
  .nos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .nos li,
  .never-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .nos li {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .x {
    flex: none;
    font-size: var(--text-body-sm);
    color: var(--color-retracted);
  }
  .seq-closer {
    margin-top: var(--space-7);
    text-align: center;
    font-size: var(--text-observation);
  }
  .seq-closer em {
    color: var(--color-accent-strong);
  }

  /* The salary rule: the page's moss moment */
  .salary {
    padding-block: var(--space-section);
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
  }
  .salary-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 960px) {
    .salary-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-9);
    }
  }
  .s-kicker {
    color: var(--color-accent-soft);
  }
  .s-title {
    margin-top: var(--space-4);
    font-size: var(--text-chapter);
  }
  .s-body {
    margin-top: var(--space-5);
    max-width: 34rem;
    font-size: var(--text-body-lg);
    color: var(--color-accent-soft);
  }
  .rules {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .rules li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.15em;
    font-size: var(--text-label);
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
    border-radius: var(--radius-full);
  }

  /* What it never does: a sunken band */
  .never {
    padding-block: var(--space-section);
    background: var(--color-surface-sunken);
  }
  .never-grid {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  @media (min-width: 900px) {
    .never-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }
  .never-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .never-list li {
    padding-block: var(--space-3);
    font-size: var(--text-body-lg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .finale {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    padding-block: var(--space-section) var(--space-8);
  }
  .f-title {
    max-width: 22ch;
    font-size: var(--text-observation);
  }
</style>
