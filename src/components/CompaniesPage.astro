---
// For companies: the people you want aren't applying; how your role becomes
// an agent that finds them, checks their evidence and asks their Rep (one
// pinned scene); the brief that reaches you; and an early-access waitlist.
import Base from '../layouts/Base.astro';
import Waitlist from './Waitlist.astro';
import Symbol from './Symbol.astro';
import SectionIntro from './SectionIntro.astro';
import InboxFigure from './companies/InboxFigure.astro';
import FlowScene from './companies/FlowScene.astro';
import { companies } from '../content/companies';
import type { Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const c = companies[lang];
---

<Base title={c.meta.title} description={c.meta.description} path="companies" og="companies" joinHref="#company-join" joinLabel={c.cta}>
  <main>
    <!-- Hero: the thesis, and the inbox that can't see who matters -->
    <section class="hero container" id="company-join" aria-labelledby="co-title">
      <p class="badge">{c.badge}</p>
      <p class="kicker">{c.kicker}</p>
      <h1 class="display title" id="co-title">
        {c.title[0]}
        <br />
        <em>{c.title[1]}</em>
      </h1>
      <p class="lede">
        <strong>{c.lede[0]}</strong>
        <br />
        {c.lede[1]}
      </p>
      <div class="form"><Waitlist id="company-hero" audience="company" cta={c.cta} note={c.formPrivacy} /></div>
      <p class="note">{c.formNote}</p>
      <InboxFigure c={c.inbox} />
    </section>

    <!-- The problem -->
    <section class="problem" aria-labelledby="co-problem">
      <div class="container problem-inner">
        <h2 class="display p-title" id="co-problem" data-reveal>
          {c.problem.title[0]}
          <br />
          <em>{c.problem.title[1]}</em>
        </h2>
        <div class="p-body">
          {c.problem.body.map((p, i) => <p data-reveal style={`--i:${i}`}>{p}</p>)}
          <p class="p-closer heading" data-reveal>{c.problem.closer}</p>
        </div>
      </div>
    </section>

    <!-- How it works: your role becomes an agent -->
    <FlowScene c={c.flow} />

    <!-- What reaches you: the brief -->
    <section class="section container brief-section" aria-labelledby="co-brief">
      <SectionIntro id="co-brief" kicker={c.brief.kicker} title={c.brief.title} body={c.brief.line} align="center" />
      <article class="brief" data-scene>
        <header class="brief-head">
          <span class="brief-who">
            <span class="brief-name heading">{c.brief.name}</span>
            <span class="brief-role">{c.brief.role}</span>
          </span>
          <span class="brief-status">{c.brief.status}</span>
        </header>
        <p class="brief-label">{c.brief.whyLabel}</p>
        <ul class="brief-why" role="list">
          {c.brief.why.map((w, i) => (
            <li style={`--i:${i}`}>
              <span>{w.text}</span>
              <span class="brief-src">{w.src}</span>
            </li>
          ))}
        </ul>
        <p class="brief-range"><span aria-hidden="true">🔒</span>{c.brief.range}</p>
        <div class="brief-consider">
          <p class="brief-label caution">{c.brief.considerLabel}</p>
          <p>{c.brief.consider}</p>
        </div>
        <p class="brief-actions" aria-hidden="true">
          <span class="btn-dark">{c.brief.actions[0]}</span>
          <span class="btn-quiet">{c.brief.actions[1]}</span>
        </p>
      </article>
    </section>

    <!-- What it never does -->
    <section class="never" aria-labelledby="co-never">
      <div class="container never-grid">
        <SectionIntro id="co-never" kicker={c.never.kicker} title={c.never.title} />
        <ul class="never-list" role="list">
          {c.never.items.map((it, i) => <li data-reveal style={`--i:${i}`}><span class="x" aria-hidden="true" />{it}</li>)}
        </ul>
      </div>
    </section>

    <!-- Close -->
    <section class="finale container" aria-labelledby="co-finale">
      <Symbol size={40} breathe />
      <h2 class="display f-title" id="co-finale">{c.finale.title}</h2>
      <p class="lede">{c.finale.body}</p>
      <div class="form"><Waitlist id="company-finale" audience="company" cta={c.cta} note={c.formPrivacy} /></div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-10) var(--space-section);
  }
  .badge {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1.5px dashed var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .hero .kicker {
    margin-top: var(--space-7);
  }
  .title {
    max-width: 22ch;
    margin-top: var(--space-4);
    font-size: clamp(2.4rem, 1.4rem + 4.2vw, 4.5rem);
    line-height: 1.04;
  }
  .hero .lede {
    max-width: 38rem;
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
  }
  .hero .lede strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .form {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-7);
  }
  .note {
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* The problem, in a sunken band */
  .problem {
    padding-block: var(--space-section);
    background: var(--color-surface-sunken);
  }
  .problem-inner {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  @media (min-width: 900px) {
    .problem-inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-9);
    }
  }
  .p-title {
    font-size: var(--text-chapter);
  }
  .p-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .p-closer {
    margin-top: var(--space-2);
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
  }

  .never-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  /* A moss point: what you get, and what it promises. */
  .x {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* What reaches you: one brief, as a sheet of paper. */
  .brief-section {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brief {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: min(100%, 620px);
    margin-top: var(--space-scene);
    padding: clamp(var(--space-5), 1rem + 2vw, var(--space-7));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px rgb(37 37 31 / 0.05),
      0 14px 36px rgb(37 37 31 / 0.08);
    rotate: -0.4deg;
  }
  .brief-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .brief-who {
    display: flex;
    flex-direction: column;
  }
  .brief-name {
    font-size: var(--text-heading-lg);
  }
  .brief-role {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .brief-status {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    color: var(--color-text-inverse);
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }
  .brief-label {
    margin-top: var(--space-2);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }
  .brief-label.caution {
    margin-top: 0;
    color: var(--color-caution);
  }
  .brief-why {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .brief-why li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent-soft);
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.2s + var(--i) * 0.2s);
  }
  .brief-src {
    font-size: var(--text-label);
    color: var(--color-accent-strong);
  }
  .brief-range {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
    border-radius: var(--radius-md);
  }
  .brief-consider {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-body-sm);
    background: var(--color-caution-soft);
    border-radius: var(--radius-md);
  }
  .brief-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .btn-dark,
  .btn-quiet {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-full);
  }
  .btn-dark {
    color: var(--color-text-inverse);
    background: var(--color-action);
  }
  .btn-quiet {
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
  }
  :global(.motion) .brief:not(.is-playing) .brief-why li {
    opacity: 0;
    translate: 0 8px;
  }

  /* What it never does: a sunken band */
  .never {
    padding-block: var(--space-section);
    background: var(--color-surface-sunken);
  }
  .never-grid {
    display: grid;
    gap: var(--space-7);
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  @media (min-width: 900px) {
    .never-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }
  .never-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .never-list li {
    padding-block: var(--space-3);
    font-size: var(--text-body-lg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .finale {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    padding-block: var(--space-section) var(--space-8);
  }
  .f-title {
    max-width: 22ch;
    font-size: var(--text-observation);
  }
</style>
