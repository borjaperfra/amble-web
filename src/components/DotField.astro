---
// A field of tiny ink dots on the paper. Two readings of the same market:
//
//   field  A few people are looking (a hairline ring around them). Most aren't.
//          The eye drifts through with the scroll; beside the dots it passes,
//          what would make them move appears — right work, remote, the number.
//   inbox  A small hairline rectangle holds the few who applied. Everyone
//          else is outside it, and so is the eye.
//
// Positions live in 0–1 space and are laid out as percentages, so the field
// recomposes for any aspect ratio (it is taller on phones, and sparser).
import Symbol from './Symbol.astro';

interface Props {
  variant?: 'field' | 'inbox';
  lookingLabel?: string;
  conditions?: string[];
  inboxLabel?: string;
  outsideTags?: string[];
  caption?: string;
  statement?: string;
  size?: 'small' | 'large';
}

const {
  variant = 'field',
  lookingLabel = '',
  conditions = [],
  inboxLabel = '',
  outsideTags = [],
  caption,
  statement,
  size = 'small',
} = Astro.props;

// Deterministic scatter on a jittered grid, so server and client agree and
// dots never pile up.
let seed = variant === 'field' ? 11 : 29;
const rand = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const cols = 12;
const rows = 5;
type Dot = {
  x: number;
  y: number;
  sparse: boolean;
  kind: 'plain' | 'looking' | 'cond' | 'inside' | 'lit';
  label?: string;
  flip?: boolean; // label on the left, near the right edge
  m?: [number, number]; // position on phones, when it differs
  hideM?: boolean; // hidden on phones (it would sit under a label)
};
const dots: Dot[] = [];

if (variant === 'field') {
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const x = (c + 0.5 + (rand() - 0.5) * 0.8) / cols;
      const y = 0.22 + ((r + 0.5 + (rand() - 0.5) * 0.7) / rows) * 0.74;
      dots.push({ x, y, sparse: (r + c) % 2 === 1, kind: 'plain' });
    }
  }
  // The few who are looking: up top, together.
  [
    [0.07, 0.07],
    [0.12, 0.12],
    [0.16, 0.05],
    [0.2, 0.11],
  ].forEach(([x, y]) => dots.push({ x, y, sparse: false, kind: 'looking' }));
  // Conditions, spread along the path of the eye. Fewer when the field is small.
  const at =
    size === 'large'
      ? [
          [0.2, 0.4],
          [0.36, 0.74],
          [0.53, 0.44],
          [0.7, 0.78],
          [0.86, 0.46],
        ]
      : [
          [0.22, 0.46],
          [0.52, 0.78],
          [0.84, 0.5],
        ];
  // On a phone the labels take most of the width: a loose column instead,
  // still ordered left to right so the eye meets them one by one.
  const atM: [number, number][] =
    size === 'large'
      ? [
          [0.06, 0.3],
          [0.22, 0.44],
          [0.1, 0.58],
          [0.3, 0.72],
          [0.14, 0.86],
        ]
      : [
          [0.08, 0.42],
          [0.3, 0.62],
          [0.14, 0.82],
        ];
  conditions.slice(0, at.length).forEach((label, i) => {
    const [x, y] = at[i];
    dots.push({ x, y, sparse: false, kind: 'cond', label, flip: x > 0.66, m: atM[i] });
  });
} else {
  // Inside the inbox: a handful.
  for (let i = 0; i < 6; i++) {
    dots.push({ x: 0.1 + (i % 3) * 0.045, y: 0.48 + Math.floor(i / 3) * 0.12, sparse: false, kind: 'inside' });
  }
  // Everyone else.
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const x = (c + 0.5 + (rand() - 0.5) * 0.85) / cols;
      const y = ((r + 0.5 + (rand() - 0.5) * 0.8) / rows) * 0.96 + 0.02;
      if (x < 0.26 && y > 0.3 && y < 0.82) continue; // keep the inbox clear
      dots.push({ x, y, sparse: (r * cols + c) % 3 === 0, kind: 'plain' });
    }
  }
  const litAt = [
    [0.44, 0.22],
    [0.56, 0.62],
    [0.9, 0.34],
  ];
  // On a phone the field is nearly square: the labels stack clear of the inbox.
  const litAtM: [number, number][] = [
    [0.46, 0.12],
    [0.44, 0.52],
    [0.08, 0.9],
  ];
  outsideTags.slice(0, litAt.length).forEach((label, i) => {
    const [x, y] = litAt[i];
    dots.push({ x, y, sparse: false, kind: 'lit', label, flip: x > 0.66, m: litAtM[i] });
  });
}
// Keep the paper clear under every label: no plain dot runs through the words.
const labelled = dots.filter((d) => d.label);
const underLabel = (d: Dot) =>
  labelled.some((l) => {
    const [from, to] = l.flip ? [l.x - 0.26, l.x + 0.02] : [l.x - 0.02, l.x + 0.26];
    return d.x > from && d.x < to && Math.abs(d.y - l.y) < 0.07;
  });
// On a phone a label spans more of the width, and the field is taller.
const underLabelM = (d: Dot) =>
  labelled.some((l) => {
    const [lx, ly] = l.m ?? [l.x, l.y];
    const flip = l.m ? false : l.flip;
    const [from, to] = flip ? [lx - 0.62, lx + 0.03] : [lx - 0.03, lx + 0.62];
    return d.x > from && d.x < to && Math.abs(d.y - ly) < 0.05;
  });
for (let i = dots.length - 1; i >= 0; i--) {
  const d = dots[i];
  if (d.kind !== 'plain') continue;
  if (underLabel(d)) dots.splice(i, 1);
  else if (underLabelM(d)) d.hideM = true;
}
const pct = (n: number) => `${(n * 100).toFixed(2)}%`;
---

<figure class:list={['dotfield', variant, size]} data-scene data-dotfield={variant}>
  <div class="canvas">
    {variant === 'field' && lookingLabel && <span class="note looking-note">{lookingLabel}</span>}
    {
      variant === 'inbox' && (
        <span class="inbox-box" aria-hidden="true">
          <span class="note inbox-note">{inboxLabel}</span>
        </span>
      )
    }
    {
      dots.map((d, i) => (
        <span
          class:list={['dot', d.kind, { sparse: d.sparse, flip: d.flip, 'hide-m': d.hideM, 'has-m': d.m }]}
          style={`left:${pct(d.x)};top:${pct(d.y)};--i:${i}` + (d.m ? `;--mx:${pct(d.m[0])};--my:${pct(d.m[1])}` : '')}
          data-x={d.x.toFixed(3)}
          data-mx={d.m?.[0].toFixed(3)}
        >
          {d.label && <span class="note label">{d.label}</span>}
        </span>
      ))
    }
    <span class="eye" aria-hidden="true" style={variant === 'inbox' ? 'left:78%;top:78%' : undefined}>
      <Symbol size={size === 'large' ? 30 : 24} watch={variant === 'inbox'} />
    </span>
  </div>
  {
    (caption || statement) && (
      <figcaption>
        {caption && <span class="caption">{caption}</span>}
        {statement && <span class="statement">{statement}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .dotfield {
    width: 100%;
  }
  .canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 2.1;
  }
  .small .canvas {
    aspect-ratio: 5 / 2.6;
  }
  .inbox .canvas {
    aspect-ratio: 5 / 2;
  }
  @media (max-width: 640px) {
    .canvas,
    .small .canvas,
    .inbox .canvas {
      aspect-ratio: 1 / 1.05;
    }
    .dot.sparse,
    .dot.hide-m {
      display: none;
    }
    .dot.has-m {
      left: var(--mx) !important;
      top: var(--my) !important;
    }
    .dotfield .dot.has-m .label {
      left: 12px;
      right: auto;
    }
  }

  .dot {
    position: absolute;
    width: 5px;
    height: 5px;
    translate: -50% -50%;
    border-radius: var(--radius-full);
    background: var(--color-text-faint);
    opacity: 0.5;
    transition:
      opacity 0.8s ease,
      background 0.8s ease,
      scale 0.8s var(--ease-standard);
  }
  .dot.looking,
  .dot.inside {
    background: var(--color-text);
    opacity: 1;
  }
  .dot.looking::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--color-text-faint);
    border-radius: var(--radius-full);
  }
  .dot.cond,
  .dot.lit {
    background: var(--color-accent);
    opacity: 1;
    scale: 1.3;
  }

  .note {
    position: absolute;
    font-size: var(--text-label);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--color-text-faint);
  }
  .looking-note {
    left: 23%;
    top: 5%;
  }
  .label {
    left: 12px;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-body-sm);
    color: var(--color-accent-strong);
    transition: opacity 0.8s ease;
  }
  .large .label {
    font-size: var(--text-body);
  }
  .dot.flip .label {
    left: auto;
    right: 12px;
  }

  .inbox-box {
    position: absolute;
    left: 6%;
    top: 36%;
    width: 17%;
    height: 38%;
    border: 1px solid var(--color-text);
    border-radius: 2px;
  }
  .inbox-note {
    left: 0;
    top: -26px;
    color: var(--color-text-muted);
  }
  @media (max-width: 640px) {
    .inbox-box {
      width: 30%;
      left: 4%;
    }
  }

  .eye {
    position: absolute;
    left: 4%;
    top: 52%;
    translate: -50% -50%;
    color: var(--color-text);
    z-index: 1;
    will-change: left, top;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    text-align: center;
  }
  .caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-heading-sm);
    color: var(--color-text-muted);
  }
  .statement {
    font-family: var(--font-display);
    font-size: var(--text-observation);
    transition:
      opacity 0.8s ease,
      translate 0.8s var(--ease-standard);
  }

  /* Before the eye passes: conditions are plain dots, labels unseen. The
     script clears these as the eye goes by; without it, the field shows the
     resolved state. */
  :global(.motion) .dotfield.field .dot.cond:not(.is-seen) {
    background: var(--color-text-faint);
    opacity: 0.55;
    scale: 1;
  }
  :global(.motion) .dotfield.field .dot.cond:not(.is-seen) .label {
    opacity: 0;
  }
  :global(.motion) .dotfield.field:not(.is-done) .statement {
    opacity: 0;
    translate: 0 6px;
  }
  /* Inbox: everyone fades in, then the few who'd move light up. */
  :global(.motion) .dotfield.inbox:not(.is-playing) .dot {
    opacity: 0;
  }
  .dotfield.inbox .dot {
    transition-delay: calc(var(--i) * 18ms);
  }
  :global(.motion) .dotfield.inbox:not(.is-playing) .dot.lit .label {
    opacity: 0;
  }
  .dotfield.inbox .dot.lit .label {
    transition-delay: 1.6s;
  }
</style>

<script>
  // The eye drifts across the field with the scroll; conditions appear as it
  // passes them. Measured against the field's own passage through the viewport.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const field of document.querySelectorAll<HTMLElement>('[data-dotfield="field"]')) {
    const eye = field.querySelector<HTMLElement>('.eye')!;
    const conds = [...field.querySelectorAll<HTMLElement>('.dot.cond')];
    const phone = window.matchMedia('(max-width: 640px)');
    const at = (c: HTMLElement) => Number((phone.matches && c.dataset.mx) || c.dataset.x);
    const place = (p: number) => {
      const x = 0.04 + p * 0.92;
      const y = 0.52 + Math.sin(p * Math.PI * 2) * 0.12;
      eye.style.left = `${(x * 100).toFixed(2)}%`;
      eye.style.top = `${(y * 100).toFixed(2)}%`;
      for (const c of conds) c.classList.toggle('is-seen', x >= at(c) - 0.015);
      field.classList.toggle('is-done', p > 0.9);
    };
    if (calm) {
      place(1);
      continue;
    }
    const update = () => {
      const r = field.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the field's top enters the lower third, 1 when its bottom passes the middle.
      const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (r.height + vh * 0.3)));
      place(p);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
