---
// The broken machine: AI → applications → filters → ATS → screening → more
// noise, and an arrow looping back to the top. As it plays, applications
// multiply and filters multiply to meet them, until the loop is cut.
// Conceptual: no numbers.
import type { ManifestoContent } from '../../content/pages';

interface Props {
  c: ManifestoContent['figures']['loop'];
}

const { c } = Astro.props;
const apps = Array.from({ length: 18 }, (_, i) => i);
---

<figure class="loop" data-scene>
  <div class="machine">
    <p class="node">{c.ai}</p>
    <p class="arrow" aria-hidden="true">↓</p>
    <p class="node">{c.applications}</p>
    <div class="chips" aria-hidden="true">
      {apps.map((i) => <span class="chip app" style={`--k:${i}`}>{c.application}</span>)}
    </div>
    <p class="arrow" aria-hidden="true">↓</p>
    <div class="chips filters" aria-hidden="true">
      {c.filters.map((f, i) => <span class="chip filter" style={`--k:${i}`}>{f}</span>)}
    </div>
    <p class="arrow" aria-hidden="true">↓</p>
    <p class="node noise">{c.noise}</p>

    <svg class="back" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M8 96 C 56 96, 56 4, 8 4" pathLength="1" />
      <path class="head" d="M14 0 L8 4 L14 8" />
    </svg>
    <span class="cut" aria-hidden="true"></span>
  </div>

  <figcaption>
    <p class="lines">
      <span>{c.lines[0]}</span>
      <span>{c.lines[1]}</span>
    </p>
    <p class="final display">{c.cut}</p>
  </figcaption>
</figure>

<style>
  .loop {
    margin-block: var(--space-6);
    padding: clamp(var(--space-5), 1rem + 3vw, var(--space-8));
    background: var(--color-surface-sunken);
    border-radius: var(--radius-xl);
  }
  .machine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-right: 72px;
  }
  .node {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .noise {
    color: var(--color-retracted);
  }
  .arrow {
    color: var(--color-text-faint);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    max-width: 34rem;
  }
  .chip {
    padding: 2px var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    border-radius: var(--radius-sm);
    transition:
      opacity 0.4s ease,
      scale 0.4s var(--ease-standard);
  }
  .app {
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border);
    transition-delay: calc(0.2s + var(--k) * 0.12s);
  }
  .filter {
    color: var(--color-text-inverse);
    background: var(--color-text-faint);
    transition-delay: calc(0.8s + var(--k) * 0.3s);
  }
  :global(.motion) .loop:not(.is-playing) .chip {
    opacity: 0;
    scale: 0.8;
  }

  /* The loop back to the top, and the moss cut through it. */
  .back {
    position: absolute;
    top: 8px;
    right: 0;
    bottom: 8px;
    width: 60px;
    height: calc(100% - 16px);
    overflow: visible;
  }
  .back path {
    fill: none;
    stroke: var(--color-text-faint);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s var(--ease-standard) 2.4s;
  }
  .back .head {
    stroke-dasharray: none;
  }
  :global(.motion) .loop:not(.is-playing) .back path:first-child {
    stroke-dashoffset: 1;
  }
  .cut {
    position: absolute;
    right: 8px;
    top: 50%;
    width: 64px;
    height: 3px;
    background: var(--color-accent);
    border-radius: 2px;
    rotate: -30deg;
    transform-origin: center;
    transition: scale 0.5s var(--ease-standard) 4.2s;
  }
  :global(.motion) .loop:not(.is-playing) .cut {
    scale: 0 1;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-6);
    text-align: center;
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-text-muted);
  }
  .final {
    font-size: var(--text-heading-xl);
    color: var(--color-accent-strong);
    transition:
      opacity 0.6s ease 4.6s,
      translate 0.7s var(--ease-standard) 4.6s;
  }
  :global(.motion) .loop:not(.is-playing) .final {
    opacity: 0;
    translate: 0 8px;
  }
</style>
