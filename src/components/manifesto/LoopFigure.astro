---
// "More applications. More filters. More noise." — told by the page itself.
// The screen holds still while you scroll: one application, then more, then
// filters and screens among them, until the paper is uncomfortable. Then it
// all clears, and two lines are left. No numbers, no diagram.
import type { ManifestoContent } from '../../content/pages';

interface Props {
  c: ManifestoContent['figures']['loop'];
}

const { c } = Astro.props;

let seed = 5;
const rand = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const words: { text: string; x: number; y: number; t: number; kind: 'app' | 'filter'; r: number }[] = [];
// The first one, alone, near the middle.
words.push({ text: c.application, x: 46, y: 46, t: 0, kind: 'app', r: 0 });
for (let i = 1; i < 60; i++) {
  const filter = i > 22 && i % 3 === 0;
  words.push({
    text: filter ? c.filters[i % c.filters.length] : c.application,
    x: 4 + rand() * 84,
    y: 8 + rand() * 82,
    // Slow at first, then faster: density accelerates.
    t: Math.pow(i / 60, 0.8) * 0.7,
    kind: filter ? 'filter' : 'app',
    r: (rand() - 0.5) * 6,
  });
}
---

<figure class="noise" data-noise>
  <div class="stick">
    <div class="field" aria-hidden="true">
      {
        words.map((w) => (
          <span class:list={['w', w.kind]} style={`left:${w.x}%;top:${w.y}%;rotate:${w.r.toFixed(1)}deg`} data-t={w.t.toFixed(3)}>
            {w.text}
          </span>
        ))
      }
    </div>
    <div class="clear">
      <p class="before">{c.before}</p>
      <p class="statement display">{c.statement}</p>
    </div>
  </div>
</figure>

<style>
  /* Full-bleed and tall: the scroll is what fills the page. */
  .noise {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 260vh;
  }
  .stick {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .field {
    position: absolute;
    inset: 64px 4% 0;
  }
  @media (max-width: 640px) {
    /* Room for a word centred at either edge; a third fewer words. */
    .field {
      inset: 64px 14% 0;
    }
    .w:nth-child(3n) {
      display: none;
    }
  }
  .w {
    position: absolute;
    translate: -50% -50%;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .w.on {
    opacity: 0.85;
  }
  .w.filter {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-heading-sm);
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-retracted);
  }
  .clear {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--gutter);
    text-align: center;
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.8s ease,
      translate 0.8s var(--ease-standard);
    pointer-events: none;
  }
  .before {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .statement {
    max-width: 22ch;
    font-size: var(--text-chapter);
    text-wrap: balance;
  }
  .noise.is-clear .w {
    opacity: 0;
    transition-duration: 0.6s;
  }
  .noise.is-clear .clear {
    opacity: 1;
    translate: none;
  }

  /* Without motion: no crowd, just the two lines. */
  :global(html:not(.motion)) .noise {
    height: auto;
    padding-block: var(--space-8);
  }
  :global(html:not(.motion)) .stick {
    position: static;
    height: auto;
  }
  :global(html:not(.motion)) .field {
    display: none;
  }
  :global(html:not(.motion)) .clear {
    position: static;
    opacity: 1;
    translate: none;
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-noise]')) {
    if (!document.documentElement.classList.contains('motion')) continue;
    const words = [...fig.querySelectorAll<HTMLElement>('.w')].map((el) => ({ el, t: Number(el.dataset.t) }));
    const update = () => {
      const r = fig.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / span));
      for (const w of words) w.el.classList.toggle('on', p >= w.t + 0.02);
      fig.classList.toggle('is-clear', p > 0.82);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
