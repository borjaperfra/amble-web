---
// The close, as in the launch film: one line from you to the company, with
// everything the old system puts in between. The middle empties, word by word;
// the ends draw together, point at each other, and the statement is left.
import type { ManifestoContent } from '../../content/pages';

interface Props {
  c: ManifestoContent['figures']['remove'];
}

const { c } = Astro.props;
---

<figure class="remove" data-scene>
  <p class="chain" aria-hidden="true">
    <span class="end">{c.you}</span>
    <span class="join left"><span class="dash" /><span class="arrow">→</span></span>
    {
      c.middle.map((m, i) => (
        <span class="step" style={`--i:${i}`}>
          <span class="step-word">{m}</span>
        </span>
      ))
    }
    <span class="join right"><span class="arrow">←</span><span class="dash" /></span>
    <span class="end">{c.company}</span>
  </p>
  <figcaption class="final display">
    {c.final[0]} <em>{c.final[1]}</em>
  </figcaption>
</figure>

<style>
  .remove {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
    margin-block: var(--space-9) var(--space-8);
    text-align: center;
  }
  .chain {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.6rem + 1.6vw, 1.9rem);
    white-space: nowrap;
  }
  .end {
    color: var(--color-text);
  }
  /* A middle step: it fades, then gives its room back, so the ends meet. */
  .step {
    display: inline-block;
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    color: var(--color-text-muted);
  }
  .step-word {
    padding-inline: 0.45em;
  }
  .join {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    margin-inline: 0.4em;
    color: var(--color-accent-strong);
  }
  .dash {
    display: inline-block;
    width: 1.1em;
    height: 1.5px;
    background: var(--color-text-faint);
  }
  .arrow {
    display: inline-block;
    font-family: var(--font-body);
  }
  .final {
    font-size: var(--text-thesis);
    line-height: 1.02;
  }
  .final em {
    color: var(--color-accent-strong);
  }

  /* Live: the full chain first; then each step goes, in order, and the room
     closes; the arrows appear once they've met; then the line. */
  :global(.motion) .remove .step {
    max-width: 12em;
    opacity: 1;
    transition:
      opacity 0.5s ease,
      max-width 0.7s var(--ease-standard);
  }
  :global(.motion) .remove.is-playing .step {
    max-width: 0;
    opacity: 0;
    transition-delay: calc(0.6s + var(--i) * 0.55s), calc(0.95s + var(--i) * 0.55s);
  }
  :global(.motion) .remove .arrow {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      opacity 0.4s ease 3.1s,
      max-width 0.4s ease 3.1s;
  }
  :global(.motion) .remove.is-playing .arrow {
    max-width: 1em;
    opacity: 1;
  }
  :global(.motion) .remove .final {
    transition:
      opacity 0.8s ease 3.6s,
      translate 1s var(--ease-standard) 3.6s;
  }
  :global(.motion) .remove:not(.is-playing) .final {
    opacity: 0;
    translate: 0 10px;
  }
</style>
