---
// The close, physically: the old chain from company to person, the
// application and the screening struck and falling away, and the two ends
// meeting as intent ↔ evidence ↔ intent.
import type { ManifestoContent } from '../../content/pages';

interface Props {
  c: ManifestoContent['figures']['remove'];
}

const { c } = Astro.props;
---

<figure class="remove" data-scene>
  <div class="stage">
    <ol class="before" role="list">
      {
        c.before.map((b, i) => (
          <li class:list={{ struck: c.struck.includes(i) }} style={`--i:${i}`}>
            <span>{b}</span>
          </li>
        ))
      }
    </ol>
    <ol class="after" role="list">
      {
        c.after.map((a, i) => (
          <li class:list={{ middle: i === 1 }} style={`--i:${i}`}>
            <span>{a}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption>
    <span class="middle-line">{c.middle}</span>
    <span class="final display">{c.final}</span>
  </figcaption>
</figure>

<style>
  .remove {
    margin-block: var(--space-7);
    padding: clamp(var(--space-5), 1rem + 3vw, var(--space-8));
    text-align: center;
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sheet);
  }
  .stage {
    display: grid;
    min-height: 360px;
    align-items: center;
  }
  .before,
  .after {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .before li,
  .after li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .before li + li::before,
  .after li + li::before {
    content: '↓';
    margin-bottom: var(--space-2);
    color: var(--color-text-faint);
  }
  .after li + li::before {
    content: '↕';
    color: var(--color-accent);
  }
  .before span,
  .after span {
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: var(--radius-md);
  }
  .before span {
    background: var(--color-surface-sunken);
  }
  .after span {
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
  }
  .after .middle span {
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
  }

  /* Choreography: strike, fall away, the chain fades, the new one arrives. */
  .before {
    transition: opacity 0.6s ease 2.4s;
  }
  .before span {
    text-decoration-line: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
  }
  .struck {
    transition:
      translate 0.9s cubic-bezier(0.5, 0, 0.75, 0) 1.3s,
      rotate 0.9s ease 1.3s,
      opacity 0.9s ease 1.3s;
  }
  .struck span {
    transition: text-decoration-color 0.4s ease 0.6s;
  }
  .remove.is-playing .struck span {
    text-decoration-color: var(--color-retracted);
  }
  .remove.is-playing .struck {
    translate: 40px 60px;
    rotate: 12deg;
    opacity: 0;
  }
  .remove.is-playing .before {
    opacity: 0;
  }
  .after li {
    transition:
      opacity 0.6s ease,
      translate 0.7s var(--ease-standard);
    transition-delay: calc(3s + var(--i) * 0.25s);
  }
  :global(.motion) .remove:not(.is-playing) .after li {
    opacity: 0;
    translate: 0 8px;
  }
  /* Without motion, show where it ends. */
  :global(html:not(.motion)) .before {
    display: none;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .middle-line {
    color: var(--color-text-muted);
  }
  .final {
    font-size: var(--text-display-lg);
    color: var(--color-accent-strong);
  }
  figcaption > * {
    transition: opacity 0.6s ease 4s;
  }
  :global(.motion) .remove:not(.is-playing) figcaption > * {
    opacity: 0;
  }
</style>
