---
// The close, as one line of words on the page: company, job, application,
// screening, person. The application and the screening are struck and fall
// away; the ends draw together as intent ↔ evidence ↔ intent.
import type { ManifestoContent } from '../../content/pages';

interface Props {
  c: ManifestoContent['figures']['remove'];
}

const { c } = Astro.props;
---

<figure class="remove" data-scene>
  <div class="stage">
    <p class="row before">
      {
        c.before.map((b, i) => (
          <>
            {i > 0 && <span class:list={['rule', { gone: c.struck.includes(i) || c.struck.includes(i - 1) }]} aria-hidden="true" />}
            <span class:list={['word', { struck: c.struck.includes(i) }]}>{b}</span>
          </>
        ))
      }
    </p>
    <p class="row after">
      {
        c.after.map((a, i) => (
          <>
            {i > 0 && <span class="link" aria-hidden="true">↔</span>}
            <span class:list={['word', { middle: i === 1 }]}>{a}</span>
          </>
        ))
      }
    </p>
  </div>
  <figcaption>
    <span class="middle-line">{c.middle}</span>
    <span class="final display">{c.final}</span>
  </figcaption>
</figure>

<style>
  .remove {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-block: var(--space-9) var(--space-7);
    text-align: center;
  }
  .stage {
    display: grid;
    align-items: center;
    min-height: 90px;
    padding-inline: var(--gutter);
  }
  .row {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
  }
  .word {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
  }
  .rule {
    width: 36px;
    height: 1px;
    background: var(--color-text-faint);
  }
  .after .word {
    color: var(--color-accent-strong);
  }
  .after .word.middle {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
    text-transform: none;
  }
  .link {
    color: var(--color-accent);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
  .middle-line {
    color: var(--color-text-muted);
  }
  .final {
    font-size: var(--text-thesis);
    color: var(--color-accent-strong);
  }

  /* Resolved by default: the new line only. */
  .before {
    display: none;
  }
  :global(.motion) .remove .before {
    display: flex;
    transition: opacity 0.6s ease 2.3s;
  }
  :global(.motion) .remove .word.struck {
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: transparent;
    transition:
      text-decoration-color 0.4s ease 0.6s,
      translate 0.9s cubic-bezier(0.5, 0, 0.75, 0) 1.3s,
      rotate 0.9s ease 1.3s,
      opacity 0.9s ease 1.3s;
  }
  :global(.motion) .remove .rule.gone {
    transition: opacity 0.5s ease 1.3s;
  }
  :global(.motion) .remove.is-playing .word.struck {
    text-decoration-color: var(--color-retracted);
    translate: 0 40px;
    rotate: 8deg;
    opacity: 0;
  }
  :global(.motion) .remove.is-playing .rule.gone {
    opacity: 0;
  }
  :global(.motion) .remove.is-playing .before {
    opacity: 0;
  }
  :global(.motion) .remove .after > * {
    transition:
      opacity 0.7s ease,
      translate 0.8s var(--ease-standard);
    transition-delay: 2.9s;
  }
  :global(.motion) .remove .after .link {
    transition-delay: 3.3s;
  }
  :global(.motion) .remove:not(.is-playing) .after > * {
    opacity: 0;
  }
  :global(.motion) .remove:not(.is-playing) .after .word:first-child {
    translate: -24px 0;
  }
  :global(.motion) .remove:not(.is-playing) .after .word:last-child {
    translate: 24px 0;
  }
  :global(.motion) .remove figcaption > * {
    transition: opacity 0.8s ease 3.8s;
  }
  :global(.motion) .remove:not(.is-playing) figcaption > * {
    opacity: 0;
  }
  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      gap: var(--space-2);
    }
    .rule {
      width: 1px;
      height: 16px;
    }
    .link {
      rotate: 90deg;
    }
    .stage {
      min-height: 240px;
    }
  }
</style>
