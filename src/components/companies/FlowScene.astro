---
// How it works, as one pinned scene in five beats, in the home's paper:
//
//   0  your role, as a sheet: the work, the conditions, a private range
//   1  the sheet folds into your agent
//   2  the agent reaches people who aren't applying and checks the evidence
//   3  their Reps check your range, privately; one more drops out
//   4  the ones who fit, and are interested: schedule the interview
//
// Without motion, the scene renders its last beat, statements first.
import Symbol from '../Symbol.astro';
import type { CompaniesContent } from '../../content/companies';

interface Props {
  c: CompaniesContent['flow'];
}

const { c } = Astro.props;
const words = (s: string) => s.split(' ');
const ys = [10, 30, 50, 70, 90];
---

<section class="flow" aria-labelledby="flow-title" data-step="4">
  <div class="pin container">
    <div class="head">
      <p class="kicker">{c.kicker}</p>
      <h2 class="visually-hidden" id="flow-title">{c.title}</h2>
      <div class="says">
        {
          c.statements.map((s, i) => (
            <p class="say display" data-say={i}>
              {words(s).map((w, j) => (
                <span class="w" style={`--w:${j}`}>
                  {w}{' '}
                </span>
              ))}
            </p>
          ))
        }
      </div>
    </div>

    <div class="stage">
      <svg class="threads" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {
          c.candidates.map((p, i) => (
            <line class:list={['thread', { out: p.out }]} data-out={p.out} style={`--i:${i}`} x1="30.5" y1="50" x2="48.5" y2={ys[i]} />
          ))
        }
      </svg>

      <article class="sheet offer">
        <p class="offer-label">{c.offer.label}</p>
        <p class="offer-title heading">{c.offer.title}</p>
        <p class="offer-company">{c.offer.company}</p>
        <ul class="offer-lines" role="list">
          {c.offer.lines.map((l) => <li>{l}</li>)}
        </ul>
        <p class="offer-range">
          <span>{c.offer.rangeLabel}</span>
          <span class="range-value">{c.offer.range}</span>
          <span class="lock">🔒 {c.offer.private}</span>
        </p>
      </article>

      <article class="sheet agent">
        <p class="agent-head">
          <span class="agent-eye"><Symbol size={36} class="mirror" /></span>
          {c.agent.name}
        </p>
        <p class="agent-for">{c.agent.lookingFor}</p>
        <ul class="agent-items" role="list">
          {c.agent.items.map((it) => <li class="heading">{it}</li>)}
        </ul>
        <p class="agent-status">
          <span class="breath" />
          <span class="status-grid">
            <span class="st sourcing">{c.agent.status}</span>
            <span class="st done">{c.agent.done}</span>
          </span>
        </p>
      </article>

      {
        c.candidates.map((p, i) => (
          <article class:list={['sheet', 'cand', p.out ? `out${p.out}` : 'fits']} style={`--dy:${ys[i]}%;--i:${i}`}>
            <span class="cand-who">
              <span class="cand-name heading">{p.name}</span>
              <span class="cand-role">
                {p.role} · <span class="nl">{c.notLooking}</span>
              </span>
            </span>
            <span class="cand-tags">
              <span class:list={['pill', 'check', p.out === 2 ? 'bad' : 'good']}>{p.evidence}</span>
              {p.range && <span class:list={['pill', 'range', p.out === 3 ? 'bad' : 'good']}>{p.range}</span>}
              {!p.out && (
                <span class="ready">
                  <span class="pill interested">{c.interested}</span>
                  <span class="schedule">{c.schedule}</span>
                </span>
              )}
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .flow {
    padding-block: var(--space-section);
  }
  .pin {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .says {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }
  .say {
    max-width: 26ch;
    font-size: var(--text-chapter);
    text-wrap: balance;
  }

  /* ---------- Stage ---------- */
  .stage {
    position: relative;
    width: 100%;
    height: 480px;
  }
  .sheet {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--cw);
    translate: -50% -50%;
    scale: var(--s, 1);
    opacity: var(--o, 1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-5);
    text-align: left;
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
    transition:
      left 1.1s var(--ease-standard),
      top 1.1s var(--ease-standard),
      scale 1.1s var(--ease-standard),
      opacity var(--motion-slow) ease;
  }

  /* The role, as a document. Static: gone (it became the agent). */
  .offer {
    --cw: 380px;
    --x: 18%;
    --y: 50%;
    --s: 0.5;
    --o: 0;
    z-index: 2;
  }
  .offer-label,
  .agent-for {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .offer-title {
    margin-top: var(--space-2);
    font-size: var(--text-heading-lg);
  }
  .offer-company {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .offer-lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    width: 100%;
    font-size: var(--text-body-sm);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .offer-range {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-body-sm);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .range-value {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
  }
  .lock {
    margin-left: auto;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    color: var(--color-caution);
  }

  /* Your agent: the role, working. */
  .agent {
    --cw: 260px;
    --x: 18%;
    --y: 50%;
    gap: var(--space-2);
    padding-bottom: 0;
    overflow: hidden;
    z-index: 1;
  }
  .agent-head {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-medium);
  }
  .agent-eye {
    display: inline-flex;
    color: var(--color-text-muted);
  }
  .agent-eye :global(.mirror) {
    transform: scaleX(-1);
  }
  .agent-eye :global(.iris) {
    animation: scan 5s ease-in-out infinite;
  }
  @keyframes scan {
    0%,
    100% {
      translate: 0 0;
    }
    20%,
    32% {
      translate: -4.5px 0.5px;
    }
    58%,
    72% {
      translate: 4.5px 0.5px;
    }
  }
  .agent-for {
    margin-top: var(--space-2);
  }
  .agent-items {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .agent-items li {
    font-size: var(--text-heading-sm);
    font-style: italic;
  }
  .agent-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    align-self: stretch;
    margin: var(--space-3) calc(var(--space-5) * -1) 0;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
    border-top: var(--border-width) solid var(--color-accent-soft);
  }
  .status-grid {
    display: grid;
  }
  .st {
    grid-area: 1 / 1;
    transition: opacity 0.5s ease;
  }
  .st.sourcing {
    opacity: 0;
  }
  .breath {
    position: relative;
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .breath::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    animation: ripple 2.4s ease-out infinite;
  }
  @keyframes ripple {
    from {
      scale: 1;
      opacity: 0.9;
    }
    to {
      scale: 2.8;
      opacity: 0;
    }
  }

  /* Threads from the agent to each person. */
  .threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .thread {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transition: opacity var(--motion-slow) ease;
    transition-delay: calc(var(--i) * 0.12s);
  }
  .thread.out {
    opacity: 0;
  }
  .thread:not(.out) {
    stroke-dasharray: none;
  }

  /* People who aren't applying. */
  .cand {
    --cw: 470px;
    --x: 73%;
    --y: var(--dy);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    transition-delay: calc(var(--i) * 0.1s);
  }
  .cand-who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cand-name {
    font-size: var(--text-heading-sm);
    white-space: nowrap;
  }
  .cand-role {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .nl {
    color: var(--color-text-faint);
  }
  .cand-tags {
    display: grid;
    justify-items: end;
    text-align: right;
  }
  .cand-tags > * {
    grid-area: 1 / 1;
    transition: opacity 0.5s ease;
  }
  .pill {
    padding: 2px var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    border-radius: var(--radius-full);
    opacity: 0;
  }
  .pill.good {
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
  }
  .pill.bad {
    color: var(--color-retracted);
    background: var(--color-retracted-soft);
  }
  .pill.interested {
    color: var(--color-text-inverse);
    background: var(--color-accent);
  }
  .ready {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    opacity: 0;
  }
  .ready .pill {
    opacity: 1;
  }
  .schedule {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-radius: var(--radius-md);
    white-space: nowrap;
  }
  /* Static (last beat): the ones who fit, ready; everyone else out. */
  .cand:not(.fits) {
    --o: 0.18;
  }
  .cand.fits {
    border-color: var(--color-accent);
    box-shadow:
      0 0 0 4px var(--color-accent-wash),
      var(--shadow-sheet);
  }
  .cand .ready {
    opacity: 1;
  }

  /* ---------- Live: five beats ---------- */
  .flow.is-live {
    padding-block: 0;
  }
  .is-live .pin {
    justify-content: center;
    min-height: 100svh;
    padding-block: calc(64px + var(--space-5)) var(--space-6);
  }
  .is-live .says {
    grid-template-areas: 'say';
    align-items: end;
  }
  .is-live .say {
    grid-area: say;
  }
  .is-live .say .w {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .is-live[data-step='0'] [data-say='0'] .w,
  .is-live[data-step='1'] [data-say='1'] .w,
  .is-live[data-step='2'] [data-say='2'] .w,
  .is-live[data-step='3'] [data-say='3'] .w,
  .is-live[data-step='4'] [data-say='4'] .w {
    opacity: 1;
    transition-delay: calc(0.25s + var(--w) * 0.07s);
  }

  /* The fold (beat 0 → 1): the role glides left and shrinks, fading out as it
     lands; the agent opens where it landed. Slower than the other moves. */
  .is-live .offer {
    transition:
      left 1.6s var(--ease-standard),
      top 1.6s var(--ease-standard),
      scale 1.6s var(--ease-standard),
      opacity 0.6s ease 1.1s;
  }
  .is-live[data-step='1'] .agent {
    transition:
      left 1.1s var(--ease-standard),
      top 1.1s var(--ease-standard),
      scale 0.8s var(--ease-standard) 1.1s,
      opacity 0.6s ease 1.1s;
  }
  .is-live[data-step='0'] .offer {
    transition:
      left 1.2s var(--ease-standard),
      top 1.2s var(--ease-standard),
      scale 1.2s var(--ease-standard),
      opacity 0.4s ease;
  }

  /* Beat 0: the role, alone, in the middle. */
  .is-live[data-step='0'] .offer {
    --x: 50%;
    --s: 1;
    --o: 1;
  }
  .is-live[data-step='0'] .agent {
    --s: 0.85;
    --o: 0;
  }
  /* Before beat 2: nobody reached yet. */
  /* (.stage raises these above the beats 1–3 rules below.) */
  .is-live:is([data-step='0'], [data-step='1']) .stage .cand {
    --o: 0;
    --x: 80%;
  }
  .is-live:is([data-step='0'], [data-step='1']) .stage .thread {
    opacity: 0;
  }
  /* Beats 1–3: the agent is sourcing. */
  .is-live:not([data-step='4']) .st.sourcing {
    opacity: 1;
  }
  .is-live:not([data-step='4']) .st.done {
    opacity: 0;
  }
  .is-live:not([data-step='4']) .cand {
    --o: 1;
    border-color: var(--color-border-subtle);
    box-shadow: var(--shadow-sheet);
  }
  .is-live:not([data-step='4']) .ready {
    opacity: 0;
  }
  .is-live:not([data-step='4']) .thread.out {
    opacity: 1;
  }
  /* Beat 2: the evidence check. */
  .is-live[data-step='2'] .pill.check {
    opacity: 1;
    transition-delay: calc(0.6s + var(--i) * 0.2s);
  }
  .is-live[data-step='2'] .cand.out2 {
    --o: 0.35;
    transition-delay: calc(0.9s + var(--i) * 0.2s);
  }
  .is-live[data-step='2'] .thread[data-out='2'] {
    opacity: 0.15;
  }
  /* Beat 3: the range, privately; the evidence drops stay out. */
  .is-live[data-step='3'] .cand.out2 {
    --o: 0.2;
  }
  .is-live[data-step='3'] .thread[data-out='2'] {
    opacity: 0;
  }
  .is-live[data-step='3'] .pill.range {
    opacity: 1;
    transition-delay: calc(0.4s + var(--i) * 0.2s);
  }
  .is-live[data-step='3'] .cand.out3 {
    --o: 0.35;
    transition-delay: 1.2s;
  }
  .is-live[data-step='3'] .thread[data-out='3'] {
    opacity: 0.15;
  }
  /* Beat 4: the ones who fit, interested. */
  .is-live[data-step='4'] .ready {
    transition-delay: 0.6s;
  }

  /* ---------- Phones: a column ---------- */
  /* On phones: the agent is just its head and status, and each person one
     line — a name and what the agent found. */
  @media (max-width: 760px) {
    .pin {
      gap: var(--space-5);
    }
    .say {
      font-size: clamp(1.6rem, 1rem + 3vw, 2.1rem);
    }
    .stage {
      height: 470px;
    }
    .threads,
    .agent-for,
    .agent-items,
    .cand-role,
    .pill.interested {
      display: none;
    }
    .offer {
      --cw: 92%;
      --x: 50%;
      --y: 50%;
    }
    .agent {
      --cw: 92%;
      --x: 50%;
      --y: 12%;
    }
    .cand {
      --cw: 100%;
      --x: 50%;
      --y: calc(34% + var(--i) * 15%);
      padding: var(--space-3);
    }
    .is-live[data-step='0'] .offer {
      --x: 50%;
      --y: 50%;
    }
    .is-live:is([data-step='0'], [data-step='1']) .stage .cand {
      --x: 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .agent-eye :global(.iris),
    .breath::after {
      animation: none;
    }
  }
</style>

<script>
  import { steppedScene, reducedMotion } from '../../scripts/motion';

  const scene = document.querySelector<HTMLElement>('.flow');
  if (scene && !reducedMotion) {
    scene.classList.add('is-live');
    scene.dataset.step = '0';
    steppedScene({
      trigger: scene,
      pin: scene.querySelector<HTMLElement>('.pin')!,
      steps: 5,
      // Beat 1 folds the role into the agent; 2 and 3 check five people one by one.
      hold: (n) => [900, 2000, 2000, 2000, 1400][n],
      onStep: (n) => {
        if (scene.dataset.step !== String(n)) scene.dataset.step = String(n);
      },
    });
  }
</script>
