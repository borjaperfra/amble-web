---
// Two ranges nobody reveals: the company's and the person's, both blurred.
// The agents only find out that they overlap.
import type { CompaniesContent } from '../../content/companies';

interface Props {
  c: CompaniesContent['salary'];
}

const { c } = Astro.props;
---

<figure class="ranges" data-scene>
  <div class="track company">
    <p class="who">{c.company}</p>
    <div class="bar"><span class="fill" /></div>
    <p class="private">{c.privateRange}</p>
  </div>
  <div class="overlap" aria-hidden="true">
    <span class="zone" />
    <span class="dot" />
    <span class="label">{c.overlap}</span>
  </div>
  <div class="track person">
    <p class="who">{c.person}</p>
    <div class="bar"><span class="fill" /></div>
    <p class="private">{c.privateFloor}</p>
  </div>
  <figcaption class="heading">{c.works}</figcaption>
</figure>

<style>
  .ranges {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    color: var(--color-text);
    background: var(--color-surface-raised);
    border-radius: var(--radius-xl);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.25);
  }
  .track {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    column-gap: var(--space-4);
  }
  .who {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .bar {
    position: relative;
    height: 22px;
    background: var(--color-surface-sunken);
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius-full);
    filter: blur(2px);
  }
  .company .fill {
    left: 30%;
    width: 50%;
    background: repeating-linear-gradient(45deg, var(--color-other) 0 6px, var(--color-other-soft) 6px 12px);
  }
  .person .fill {
    left: 55%;
    right: 0;
    background: repeating-linear-gradient(45deg, var(--color-accent) 0 6px, var(--color-accent-soft) 6px 12px);
  }
  .private {
    grid-column: 2;
    margin-top: 2px;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .overlap {
    position: relative;
    height: 44px;
    margin-left: calc(6rem + var(--space-4));
  }
  .zone {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 55%;
    width: 25%;
    background: var(--color-accent-wash);
    border-inline: 1.5px dashed var(--color-accent);
  }
  .dot {
    position: absolute;
    top: 50%;
    left: 67.5%;
    width: 16px;
    height: 16px;
    translate: -50% -50%;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 5px var(--color-accent-soft);
  }
  .label {
    position: absolute;
    top: 50%;
    left: calc(67.5% + 18px);
    translate: 0 -50%;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-strong);
  }
  figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
  }
  .overlap,
  figcaption {
    transition:
      opacity 0.6s ease,
      translate 0.7s var(--ease-standard);
  }
  .overlap {
    transition-delay: 1s;
  }
  figcaption {
    transition-delay: 1.8s;
  }
  :global(.motion) .ranges:not(.is-playing) :is(.overlap, figcaption) {
    opacity: 0;
    translate: 0 6px;
  }
</style>
