---
// Two hairline ranges drawn straight on the moss, numbers obscured. All the
// agents learn is that they overlap.
import type { CompaniesContent } from '../../content/companies';

interface Props {
  c: CompaniesContent['salary'];
}

const { c } = Astro.props;
---

<figure class="ranges" data-scene>
  <div class="tracks">
    <div class="track">
      <span class="who">{c.company}</span>
      <span class="line"><span class="span company"><span class="num">€ •••</span><span class="num">€ •••</span></span></span>
    </div>
    <div class="track">
      <span class="who">{c.person}</span>
      <span class="line"><span class="span person"><span class="num">€ •••</span></span></span>
    </div>
    <span class="overlap" aria-hidden="true"><span class="overlap-label">{c.overlap}</span></span>
  </div>
  <figcaption>
    <span class="works heading">{c.works}</span>
    <span class="sub">{c.worksSub}</span>
  </figcaption>
</figure>

<style>
  .ranges {
    --col: 6rem;
  }
  .tracks {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .track {
    display: grid;
    grid-template-columns: var(--col) 1fr;
    align-items: center;
    gap: var(--space-4);
  }
  .who {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }
  .line {
    position: relative;
    height: 1px;
    background: rgb(221 227 216 / 0.3);
  }
  .span {
    position: absolute;
    top: -1px;
    height: 3px;
    display: flex;
    justify-content: space-between;
    background: var(--color-text-inverse);
    border-radius: 2px;
  }
  .span.company {
    left: 25%;
    width: 50%;
  }
  .span.person {
    left: 58%;
    right: 4%;
  }
  .num {
    position: relative;
    top: -22px;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    color: var(--color-accent-soft);
    filter: blur(1.5px);
    user-select: none;
  }
  /* Numbers sit outside the overlap: the company's at its ends, above the
     line; the person's floor just before it, below the line. */
  .company .num:first-child {
    translate: calc(-100% - 6px) 0;
  }
  .company .num:last-child {
    translate: calc(100% + 6px) 0;
  }
  .company .num {
    top: -9px;
  }
  .person .num {
    top: -9px;
    translate: calc(-100% - 6px) 0;
  }

  /* The overlap: a faint band where both lines agree. */
  .overlap {
    position: absolute;
    top: -14px;
    bottom: -14px;
    left: calc(var(--col) + var(--space-4) + (100% - var(--col) - var(--space-4)) * 0.58);
    width: calc((100% - var(--col) - var(--space-4)) * 0.17);
    border-inline: 1px dashed var(--color-accent-soft);
    background: rgb(221 227 216 / 0.04);
    transition: opacity 0.8s ease 0.8s;
  }
  .overlap-label {
    position: absolute;
    bottom: -22px;
    left: 50%;
    translate: -50% 0;
    font-size: var(--text-label);
    white-space: nowrap;
    color: var(--color-text-inverse);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-8);
    transition: opacity 0.8s ease 1.4s;
  }
  .works {
    font-size: var(--text-observation);
    color: var(--color-text-inverse);
  }
  .sub {
    color: var(--color-accent-soft);
  }
  :global(.motion) .ranges:not(.is-playing) :is(.overlap, figcaption) {
    opacity: 0;
  }
</style>
