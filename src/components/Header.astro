---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  path?: string;
  // The home already has the form in the hero; other pages link back to it.
  joinHref?: string;
}

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const { path = '', joinHref = `${getRelativeLocaleUrl(lang)}#join` } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<header class="header container">
  <Logo />
  <nav class="nav" aria-label={t('nav.label')}>
    <a class="lang text-link" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>
      {t('nav.otherLang')}
    </a>
    <a class="join text-link" href={joinHref}>{t('nav.join')} <span aria-hidden="true">→</span></a>
  </nav>
</header>

<!-- A slim bar that floats in once the page header has scrolled away. -->
<div class="float" data-float inert>
  <div class="container float-inner">
    <Logo size="sm" />
    <a class="btn float-join" href={joinHref}>{t('nav.join')}</a>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-5);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-body-sm);
  }
  .join {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .float {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgb(244 241 234 / 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
    translate: 0 -100%;
    transition: translate var(--motion-slow) var(--ease-standard);
  }
  .float.is-shown {
    translate: 0 0;
  }
  .float-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .float-join {
    height: 38px;
    padding: 0 var(--space-4);
    font-size: var(--text-body-sm);
  }

  /* On phones the language switch lives in the footer. */
  @media (max-width: 480px) {
    .lang {
      display: none;
    }
  }
</style>

<script>
  // Show the floating bar once the page header is out of sight.
  const bar = document.querySelector<HTMLElement>('[data-float]');
  const header = document.querySelector<HTMLElement>('.header');
  if (bar && header) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    }).observe(header);
  }
</script>
