---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_MODE } from 'astro:env/server';
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  path?: string;
  // The home already has the form in the hero; other pages link back to it.
  joinHref?: string;
  // The agent's loop, on the home: shown in the floating bar as you scroll.
  stages?: { id: string; label: string }[];
  joinLabel?: string;
}

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const { path = '', joinHref = `${getRelativeLocaleUrl(lang)}#join`, stages, joinLabel = t('nav.join') } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const launch = SITE_MODE === 'launch';
const pages = [
  { path: 'companies', label: t('nav.companies') },
  { path: 'manifesto', label: t('nav.manifesto') },
  { path: 'how-its-built', label: t('nav.howBuilt') },
];
---

<header class="header container">
  <Logo />
  <nav class="nav" aria-label={t('nav.label')}>
    {
      !launch && (
        <>
          {pages.map((p) => (
            <a class="page text-link" href={getRelativeLocaleUrl(lang, p.path)}>{p.label}</a>
          ))}
        </>
      )
    }
    <a class="lang text-link" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>
      {t('nav.otherLang')}
    </a>
    {!launch && <a class="join text-link" href={joinHref}>{joinLabel} <span aria-hidden="true">→</span></a>}
    {
      !launch && (
        <button class="menu-btn" type="button" aria-label={t('nav.menu')} aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" data-menu-open>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      )
    }
  </nav>
</header>

<!-- A slim bar that floats in once the page header has scrolled away. -->
<div class="float" data-float inert>
  <div class="container float-inner">
    <Logo size="sm" />
    {
      stages && (
        <nav class="loop" aria-label="Amble">
          <ol role="list">
            {stages.map((st, i) => (
              <li data-stage-link={st.id}>
                <a href={`#stage-${st.id}`}>
                  <span class="loop-n">{i + 1}</span>
                  {st.label}
                </a>
              </li>
            ))}
          </ol>
          <span class="loop-now" aria-hidden="true"><span class="loop-now-n" /><span class="loop-now-label" /></span>
        </nav>
      )
    }
    <a class="btn float-join" href={joinHref}>{joinLabel}</a>
    {
      !launch && (
        <button class="menu-btn" type="button" aria-label={t('nav.menu')} aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" data-menu-open>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      )
    }
  </div>
</div>

{
  !launch && (
    <dialog class="menu" id="site-menu" aria-label={t('nav.menu')}>
      <div class="container menu-head">
        <Logo />
        <button class="menu-btn" type="button" aria-label={t('nav.close')} data-menu-close autofocus>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
      <nav class="container menu-nav" aria-label={t('nav.label')}>
        <ul class="menu-pages" role="list">
          {pages.map((p) => (
            <li>
              <a href={getRelativeLocaleUrl(lang, p.path)} aria-current={p.path === path ? 'page' : undefined}>
                {p.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="menu-foot">
          <a class="btn menu-join" href={joinHref}>{joinLabel}</a>
          <a class="text-link" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>
            {t('nav.otherLang')}
          </a>
        </div>
      </nav>
    </dialog>
  )
}

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-5);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-body-sm);
  }
  .join {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .float {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: rgb(244 241 234 / 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
    translate: 0 -100%;
    transition: translate var(--motion-slow) var(--ease-standard);
  }
  .float.is-shown {
    translate: 0 0;
  }
  .float-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  /* The loop: where you are in what the Rep does. */
  .loop {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .loop ol {
    display: flex;
    gap: var(--space-1);
  }
  .loop a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition:
      color var(--motion-default) ease,
      background var(--motion-default) ease;
  }
  .loop a:hover {
    color: var(--color-text);
  }
  .loop-n {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    line-height: 1;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all var(--motion-default) ease;
  }
  .loop li.is-past .loop-n {
    color: var(--color-accent-strong);
    border-color: var(--color-accent-soft);
    background: var(--color-accent-wash);
  }
  .loop li.is-active a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    background: var(--color-accent-wash);
  }
  .loop li.is-active .loop-n {
    color: var(--color-text-inverse);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .loop-now {
    display: none;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent-strong);
  }
  @media (max-width: 1080px) {
    .loop ol {
      display: none;
    }
    .loop-now {
      display: inline;
    }
  }

  .float-join {
    flex: none;
    height: 38px;
    padding: 0 var(--space-4);
    font-size: var(--text-body-sm);
  }
  /* The step number always shows; the stage's name gives way first. */
  .loop-now {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .loop-now-label:not(:empty)::before {
    content: ' · ';
    white-space: pre;
  }

  /* ---------- Menu: on narrow screens the pages leave the header for it ---------- */
  .menu-btn {
    display: none;
    flex: none;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    margin-right: calc(var(--space-2) * -1);
    padding: 0;
    color: var(--color-text);
    background: none;
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
  }
  .menu-btn:hover {
    background: var(--color-accent-wash);
  }
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    background: var(--color-bg);
    border: 0;
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-slow) var(--ease-standard),
      overlay var(--motion-slow) allow-discrete,
      display var(--motion-slow) allow-discrete;
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .menu[open] {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-5);
  }
  .menu-head .menu-btn {
    display: grid;
  }
  .menu-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    padding-block: var(--space-5) var(--space-7);
  }
  .menu-pages li + li {
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .menu-pages a {
    display: block;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-heading-lg);
    line-height: 1.15;
    color: var(--color-text);
    text-decoration: none;
  }
  .menu-pages a[aria-current='page'] {
    color: var(--color-accent-strong);
  }
  .menu-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .menu-join {
    width: 100%;
  }

  /* The page's own logo travels between pages (view transitions). */
  .header :global(.logo) {
    view-transition-name: logo;
  }
  /* On small screens the other pages and the language switch live in the footer. */
  @media (max-width: 1080px) {
    .page {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (max-width: 480px) {
    .lang {
      display: none;
    }
    .nav,
    .float-inner {
      gap: var(--space-3);
    }
    .float-join {
      padding: 0 var(--space-3);
    }
    /* In the bar the eye alone says Amble: the step and the button need the room. */
    .float :global(.logo .word) {
      display: none;
    }
  }
</style>

<script>
  // The loop: the stage whose section holds the middle of the screen is active.
  const links = [...document.querySelectorAll<HTMLElement>('[data-stage-link]')];
  const now = document.querySelector<HTMLElement>('.loop-now');
  if (links.length) {
    const order = links.map((l) => l.dataset.stageLink!);
    const setActive = (id: string | null) => {
      const at = id ? order.indexOf(id) : -1;
      links.forEach((l, i) => {
        l.classList.toggle('is-active', i === at);
        l.classList.toggle('is-past', at >= 0 && i < at);
      });
      if (now) {
        now.children[0].textContent = at >= 0 ? `${at + 1}/${order.length}` : '';
        now.children[1].textContent = at >= 0 ? (links[at].textContent?.replace(/^\s*\d+/, '').trim() ?? '') : '';
      }
    };
    // On each scroll: the stage whose section holds the middle of the screen.
    const sections = [...document.querySelectorAll<HTMLElement>('[data-stage]')];
    const update = () => {
      const mid = window.innerHeight / 2;
      const hit = sections.find((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= mid && r.bottom >= mid;
      });
      setActive(hit?.dataset.stage ?? null);
    };
    // Six rectangles per scroll event: cheap enough to run directly.
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  // Show the floating bar once the page header is out of sight.
  const bar = document.querySelector<HTMLElement>('[data-float]');
  const header = document.querySelector<HTMLElement>('.header');
  if (bar && header) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('is-shown', show);
      bar.inert = !show;
    }).observe(header);
  }

  // The menu: a modal dialog, so focus stays inside and Escape closes it. The
  // page behind doesn't scroll while it's open; pages with smooth scrolling
  // hear about it through amble:scroll-lock.
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-menu-open]')];
  if (menu) {
    let opener: HTMLElement | null = null;
    let locked = false;
    const lock = (on: boolean) => {
      if (on === locked) return;
      locked = on;
      document.documentElement.classList.toggle('menu-open', on);
      window.dispatchEvent(new CustomEvent('amble:scroll-lock', { detail: on }));
      openers.forEach((b) => b.setAttribute('aria-expanded', String(on)));
    };
    // Unlocked right away rather than on the dialog's close event, which some
    // browsers deliver late: an in-page link needs the page free to scroll.
    const shut = (refocus = true) => {
      if (menu.open) menu.close();
      lock(false);
      if (refocus) opener?.focus({ preventScroll: true });
    };
    for (const b of openers) {
      b.addEventListener('click', () => {
        opener = b;
        menu.showModal();
        lock(true);
      });
    }
    menu.addEventListener('cancel', () => shut()); // Escape
    menu.addEventListener('close', () => lock(false));
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => shut());
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) shut(false);
    });
    // Wide enough for the header's own links: the menu goes.
    window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
      if (e.matches) shut(false);
    });
  }
</script>
