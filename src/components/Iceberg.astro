---
// The market, drawn as a diagram: a few people above the line are looking and
// visible to the application system; far more below it aren't. When a
// condition fits, some of them turn moss — and the eye watches down there,
// outside the set everyone else is looking at. Conceptual: no real numbers.
import Symbol from './Symbol.astro';

interface Props {
  looking: string;
  notLooking: string;
  question: string;
  // Large (manifesto) adds the conditions and the ≠ line.
  tags?: string[];
  statement?: string;
  size?: 'small' | 'large';
}

const { looking, notLooking, question, tags, statement, size = 'small' } = Astro.props;

// Deterministic scatter, so server and client agree.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const above = Array.from({ length: 6 }, (_, i) => ({ x: 250 + (i % 3) * 34 + rand() * 12, y: 58 + Math.floor(i / 3) * 26 + rand() * 6 }));
const below: { x: number; y: number; lit: number }[] = [];
const litOrder = [11, 23, 38, 47, 58];
for (let r = 0; r < 5; r++) {
  for (let c = 0; c < 13; c++) {
    const i = r * 13 + c;
    below.push({
      x: 40 + c * 42 + (r % 2) * 18 + rand() * 10,
      y: 160 + r * 38 + rand() * 10,
      lit: litOrder.indexOf(i),
    });
  }
}
const eyeAt = below[litOrder[2]];
---

<figure class:list={['iceberg', size]} data-scene>
  <div class="art">
    <svg viewBox="0 0 600 370" role="img" aria-label={`${looking} / ${notLooking}: ${question}`}>
      <text class="label" x="0" y="30">{looking.toUpperCase()}</text>
      {above.map((d) => <circle class="dot up" cx={d.x} cy={d.y} r="7" />)}
      <line class="water" x1="0" y1="124" x2="600" y2="124" />
      <text class="label" x="0" y="150">{notLooking.toUpperCase()}</text>
      {
        below.map((d, i) => (
          <circle
            class:list={['dot', 'down', { lit: d.lit >= 0 }]}
            cx={d.x}
            cy={d.y}
            r="7"
            style={`--n:${i};--l:${d.lit}`}
          />
        ))
      }
    </svg>
    <span class="eye" style={`left:${(eyeAt.x / 600) * 100}%;top:${((eyeAt.y - 34) / 370) * 100}%`}>
      <Symbol size={size === 'large' ? 34 : 26} />
    </span>
  </div>
  <figcaption class="caption">
    <span class="question">{question}</span>
    {tags && <span class="tags">{tags.join(' · ')}</span>}
    {statement && <span class="statement">{statement}</span>}
  </figcaption>
</figure>

<style>
  .iceberg {
    width: 100%;
  }
  .art {
    position: relative;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .label {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: var(--color-text-faint);
  }
  .water {
    stroke: var(--color-text);
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .dot.up {
    fill: var(--color-text);
  }
  .dot.down {
    fill: var(--color-border);
    transition:
      fill 0.8s ease,
      opacity 0.6s ease;
  }
  .iceberg.is-playing .dot.lit {
    fill: var(--color-accent);
    transition-delay: calc(0.8s + var(--l) * 0.45s);
  }
  :global(.motion) .iceberg:not(.is-playing) .dot.down {
    opacity: 0;
  }
  .iceberg .dot.down {
    transition-delay: calc(var(--n) * 12ms);
  }
  .eye {
    position: absolute;
    translate: -50% -50%;
    color: var(--color-text);
    transition: opacity 0.6s ease 2.4s;
  }
  :global(.motion) .iceberg:not(.is-playing) .eye {
    opacity: 0;
  }
  .caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    text-align: center;
  }
  .question {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-heading-sm);
    color: var(--color-text-muted);
  }
  .tags {
    font-size: var(--text-body-sm);
    color: var(--color-accent-strong);
  }
  .statement {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-heading-xl);
    color: var(--color-text);
  }
</style>
