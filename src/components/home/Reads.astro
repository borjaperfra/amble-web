---
import SectionIntro from '../SectionIntro.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['reads'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="reads-title">
  <div class="split">
    <SectionIntro id="reads-title" kicker={c.kicker} title={c.title} body={c.body} />

    <figure class="sheet">
      <p class="heading sheet-title">{c.sheetTitle}</p>

      <ul class="sources" role="list">
        {
          c.sources.map((s, i) => (
            <li class="source" data-reveal style={`--i:${i}`}>
              <span class="source-type">{s.type}</span>
              <span class="source-name">{s.name}</span>
              <span class="check" aria-hidden="true">✓</span>
            </li>
          ))
        }
      </ul>

      <dl class="found">
        {
          c.discoveries.map((d, i) => (
            <div class="found-item" data-reveal style={`--i:${i + c.sources.length}`}>
              <dt>{d.label}</dt>
              <dd class="heading">{d.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="closing" data-reveal style={`--i:${c.sources.length + c.discoveries.length}`}>
        {c.closing}
      </p>
    </figure>
  </div>
</section>

<style>
  .sheet-title {
    font-size: var(--text-heading-md);
  }
  .sources {
    margin-top: var(--space-5);
  }
  .source {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
    font-size: var(--text-body-sm);
  }
  .source-type {
    font-weight: var(--weight-medium);
  }
  .source-name {
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .check {
    color: var(--color-accent);
  }
  .found {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .found-item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
  }
  .found-item dd {
    font-size: var(--text-heading-lg);
    line-height: 1;
  }
  .found-item dt {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-tight);
  }
  .closing {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border-subtle);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    line-height: var(--leading-tight);
    text-wrap: pretty;
  }
  @media (max-width: 520px) {
    .found {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-5);
    }
    .source {
      grid-template-columns: 4.5rem 1fr auto;
    }
  }
</style>
