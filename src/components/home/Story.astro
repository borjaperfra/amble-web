---
// Chapter 1, "It gets to know you": Source → Claim → Evidence → Capability,
// the product's core idea, told as one pinned scene in four steps.
//
//   0  the sources arrive
//   1  the Rep picks out claims; each gets a badge for where it was read
//   2  the claims fly out of the documents into the capability they support
//   3  each capability shows the strength of its evidence, and what's unknown
//
// The server renders the final state (claims inside their capabilities), so
// without JavaScript or with reduced motion the scene reads complete. The
// script moves each claim back into its source line and plays the steps as the
// chapter scrolls by. Claims are real elements moved with GSAP Flip: the words
// you see fly are the same words you read in the CV, badge and all.
import EvidenceDots from '../EvidenceDots.astro';
import SourceIcon from '../SourceIcon.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['story'];
  strength: HomeContent['strength'];
  sourceNames: HomeContent['sourceNames'];
}

const { c, strength, sourceNames } = Astro.props;

const claims = c.sources.flatMap((src) =>
  src.lines.flatMap((line) => (line.claim ? [{ ...line.claim, text: line.text, source: src.source }] : [])),
);
---

<section class="story" data-step="3" data-layout="group" aria-labelledby="story-title">
  <!-- On phones the title comes first and scrolls away, so the steps get the screen. -->
  <div class="container chapter-lead" aria-hidden="true"><p class="display chapter">{c.chapter}</p></div>
  <div class="story-pin">
    <div class="container story-grid">
      <div class="captions">
        <h2 class="display chapter" id="story-title">{c.chapter}</h2>
        <ol class="progress" role="list" aria-hidden="true">
          {c.steps.map((_, i) => <li data-i={i}>{String(i + 1).padStart(2, '0')}</li>)}
        </ol>
        <div class="caption-stack">
          {
            c.steps.map((step, i) => (
              <div class="caption" data-i={i}>
                <p class="kicker">{step.kicker}</p>
                <p class="heading caption-title">{step.title}</p>
                <p class="lede caption-body">{step.body}</p>
                {i === 1 && (
                  <p class="legend">
                    <span class="legend-item">
                      <span class="legend-mark">Aa</span> {c.legend.claim}
                    </span>
                    <span class="legend-item">
                      <span class="claim-badge">
                        <SourceIcon source="cv" size={12} />
                      </span>
                      {c.legend.source}
                    </span>
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div class="stage-wrap">
        <div class="stage">
          <div class="docs">
            {
              c.sources.map((src, d) => (
                <article class="doc" data-doc={src.id} style={`--d:${d}`}>
                  <header class="doc-head">
                    <span class:list={['doc-source', src.source]}>
                      <SourceIcon source={src.source} size={18} />
                      {sourceNames[src.source]}
                    </span>
                    <span class="doc-title">{src.title}</span>
                  </header>
                  <div class="doc-body">
                    {src.lines.map((line) => (
                      <p class:list={['doc-line', line.kind]} data-slot={line.claim?.id}>
                        <span class="line-text">{line.text}</span>
                      </p>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>

          <div class="caps">
            {
              c.caps.map((cap, k) => (
                <section class="cap" data-cap={cap.id} style={`--k:${k}`}>
                  <header class="cap-head">
                    <h3 class="cap-name">{cap.name}</h3>
                    <p class="cap-meta">
                      <EvidenceDots strength={cap.strength} label={strength[cap.strength]} />
                      <span class="cap-count">{cap.count}</span>
                    </p>
                  </header>
                  <div class="cap-claims" data-list={cap.id}>
                    {claims
                      .filter((cl) => cl.cap === cap.id)
                      .map((cl) => (
                        <div class="claim" data-claim={cl.id} data-cap={cl.cap} style={`--ci:${claims.indexOf(cl)}`}>
                          <span class="claim-badge" title={sourceNames[cl.source]}>
                            <SourceIcon source={cl.source} size={12} />
                          </span>
                          <span class="claim-body">
                            <span class="claim-text">{cl.text}</span>
                            <span class="claim-tags">
                              <span class="claim-source">{sourceNames[cl.source]}</span>
                              {cl.assisted && <span class="assisted">⚠ {c.assisted}</span>}
                            </span>
                          </span>
                        </div>
                      ))}
                  </div>
                </section>
              ))
            }
            <section class="cap unknown">
              <p class="unknown-label">{c.unknown.label}</p>
              <header class="cap-head">
                <h3 class="cap-name">{c.unknown.name}</h3>
                <p class="cap-meta">
                  <EvidenceDots strength={c.unknown.strength} label={strength[c.unknown.strength]} />
                </p>
              </header>
              <p class="unknown-note">{c.unknown.note}</p>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Frame ---------- */
  .story {
    position: relative;
  }
  .chapter-lead {
    display: none;
  }
  .story-pin {
    display: flex;
    align-items: center;
    min-height: 100svh;
    /* room for the floating header bar */
    padding-block: calc(60px + var(--space-4)) var(--space-6);
  }
  .story-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .story-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
    }
  }

  /* ---------- Captions ---------- */
  .captions {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* The chapter's title holds at the top while its four steps play below. */
  .chapter {
    max-width: 14ch;
    font-size: var(--text-chapter);
    line-height: 1.05;
  }
  @media (min-width: 960px) {
    .story.is-live .captions {
      align-self: stretch;
    }
    .story.is-live .progress {
      margin-top: auto;
    }
    .story.is-live .caption-stack {
      margin-bottom: auto;
    }
  }
  .progress {
    display: flex;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-text-faint);
  }
  .progress li {
    position: relative;
    padding-top: var(--space-3);
    min-width: 2.5rem;
    transition: color var(--motion-slow) ease;
  }
  .progress li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--color-border);
    transition: background var(--motion-slow) ease;
  }
  .caption-stack {
    display: grid;
  }
  .caption {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .caption-title {
    font-size: var(--text-heading-xl);
  }
  .caption-body {
    max-width: 24rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-2);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .legend-mark {
    padding: 0 0.3em;
    font-weight: var(--weight-medium);
    color: var(--color-text);
    background: linear-gradient(transparent 55%, var(--color-accent-soft) 55%);
  }

  /* Live: one caption at a time, the progress follows the step. */
  .story.is-live .caption {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--motion-slow) ease,
      transform var(--motion-arrive) var(--ease-standard);
    pointer-events: none;
  }
  .story.is-live[data-step='-1'] .caption[data-i='0'],
  .story.is-live[data-step='0'] .caption[data-i='0'],
  .story.is-live[data-step='1'] .caption[data-i='1'],
  .story.is-live[data-step='2'] .caption[data-i='2'],
  .story.is-live[data-step='3'] .caption[data-i='3'] {
    opacity: 1;
    transform: none;
    transition-delay: 120ms;
    pointer-events: auto;
  }
  .story.is-live[data-step='0'] .progress li[data-i='0'],
  .story.is-live[data-step='1'] .progress li:is([data-i='0'], [data-i='1']),
  .story.is-live[data-step='2'] .progress li:is([data-i='0'], [data-i='1'], [data-i='2']),
  .story.is-live[data-step='3'] .progress li {
    color: var(--color-accent-strong);
  }
  .story.is-live[data-step='0'] .progress li[data-i='0']::before,
  .story.is-live[data-step='1'] .progress li:is([data-i='0'], [data-i='1'])::before,
  .story.is-live[data-step='2'] .progress li:is([data-i='0'], [data-i='1'], [data-i='2'])::before,
  .story.is-live[data-step='3'] .progress li::before {
    background: var(--color-accent);
  }
  /* Not live (no JS, reduced motion): every caption, in order. */
  .story:not(.is-live) .caption-stack {
    gap: var(--space-6);
  }
  .story:not(.is-live) .caption {
    grid-area: auto;
  }
  .story:not(.is-live) .caption:not(:first-child) .caption-title {
    font-size: var(--text-heading-md);
  }
  .story:not(.is-live) .progress {
    display: none;
  }

  /* ---------- Stage: a scene that scales like an illustration ---------- */
  .stage-wrap {
    width: min(100%, calc(86svh / 0.92));
    justify-self: center;
  }
  .stage {
    position: relative;
    container: stage / size;
    width: 100%;
    aspect-ratio: 100 / 92;
    --doc-font: max(13.5px, 2.1cqw);
    --cap-font: max(20px, 3.5cqw);
  }

  /* Documents: position (x, y, w, r) when read; (gx, gy, gr, gs) when piled aside. */
  .doc {
    position: absolute;
    left: calc(var(--x) * 1cqw);
    top: calc(var(--y) * 1cqw);
    width: calc(var(--w) * 1cqw);
    /* A wide left margin: the source badges sit in it, on the paper. */
    padding: 3cqw 3.2cqw 3cqw calc(2.3em + 1.4cqw);
    font-size: var(--doc-font);
    line-height: 1.5;
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: 1.6cqw;
    box-shadow:
      0 1px 2px rgb(37 37 31 / 0.05),
      0 14px 36px rgb(37 37 31 / 0.08);
    transform-origin: top left;
    transform: rotate(calc(var(--r) * 1deg));
    transition:
      transform 1.1s var(--ease-standard),
      translate var(--motion-arrive) var(--ease-standard),
      opacity var(--motion-arrive) ease;
    transition-delay: calc(var(--d) * 90ms);
  }
  .doc[data-doc='cv'] { --x: 0; --y: 2; --w: 56; --r: -1.2; --gx: 0; --gy: 2; --gr: -2.5; --gs: 0.56; z-index: 1; }
  .doc[data-doc='gh'] { --x: 59; --y: 0; --w: 41; --r: 1.4; --gx: 5; --gy: 32; --gr: 3; --gs: 0.6; }
  .doc[data-doc='web'] { --x: 61; --y: 32; --w: 39; --r: -0.8; --gx: 1; --gy: 47; --gr: -2.2; --gs: 0.6; }
  .doc[data-doc='li'] { --x: 57; --y: 61; --w: 43; --r: 1; --gx: 6; --gy: 61; --gr: 1.4; --gs: 0.6; }

  .doc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqw;
    padding-bottom: 1.5cqw;
    margin: 0 0 1.5cqw calc(1.8cqw - 2.3em);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .doc-source {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.9em;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .doc-source :global(.source-icon) {
    width: 1.35em;
    height: 1.35em;
  }
  .doc-title {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .doc-line {
    position: relative;
    color: var(--color-text-muted);
    padding-block: 0.22em;
  }
  .doc-line.name {
    font-family: var(--font-display);
    font-size: 1.65em;
    line-height: 1.1;
    color: var(--color-text);
  }
  .doc-line.meta {
    margin-top: 0.45em;
    font-size: 0.9em;
    color: var(--color-text-faint);
  }
  .line-text {
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-radius: 3px;
    transition:
      color var(--motion-slow) ease,
      background-color var(--motion-slow) ease,
      opacity var(--motion-slow) ease;
  }

  /* Piled aside, the documents keep their shape but lose their words: text
     becomes lines, the way a page reads from across a desk. */
  .story[data-layout='group'] .doc .line-text {
    color: transparent;
    background-color: var(--color-border);
  }
  .story[data-layout='group'] .doc .name .line-text {
    background-color: var(--color-text-faint);
  }
  .story[data-layout='group'] .doc .doc-title {
    opacity: 0;
  }

  /* ---------- Claims ---------- */
  /* Badge | text, with the tags tucked under the text. */
  .claim {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 0.6em;
    row-gap: 0.15em;
    font-size: var(--doc-font);
    line-height: 1.4;
    color: var(--color-text);
  }
  .claim > .claim-badge {
    margin-top: -0.05em;
  }
  /* Text and tags share one flow, so the source name sits at the end of the line. */
  .claim-body > .claim-tags {
    display: inline-flex;
    margin-left: 0.6em;
    vertical-align: 0.05em;
  }
  /* The badge: where this claim was read. It travels with the claim. */
  .claim-badge {
    display: inline-grid;
    place-items: center;
    width: 1.55em;
    height: 1.55em;
    flex: none;
    color: var(--color-text-inverse);
    background: var(--color-accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 2px var(--color-surface-raised);
  }
  .claim-badge :global(.source-icon) {
    width: 0.95em;
    height: 0.95em;
  }
  .claim-tags {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .claim-source {
    font-size: 0.86em;
    font-weight: var(--weight-medium);
    color: var(--color-accent-strong);
  }
  .assisted {
    font-size: 0.86em;
    color: var(--color-caution);
  }

  /* A claim sitting in its source line: laid over the line's text, badge in the gutter. */
  .doc-line > .claim {
    position: absolute;
    top: 0.22em;
    left: 0;
    right: 0;
    display: block;
    color: var(--color-text);
    opacity: 0;
    transition: opacity var(--motion-slow) ease;
    transition-delay: calc(var(--ci) * 110ms);
  }
  .doc-line > .claim .claim-badge {
    position: absolute;
    left: -2.1em;
    top: 0.05em;
    scale: 0.4;
    opacity: 0;
    transition:
      scale 0.5s cubic-bezier(0.3, 1.5, 0.5, 1),
      opacity 0.3s ease;
    transition-delay: calc(0.35s + var(--ci) * 110ms);
  }
  .doc-line > .claim .claim-text {
    background-image: linear-gradient(var(--color-accent-soft), var(--color-accent-soft));
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 0% 46%;
    transition: background-size 0.8s var(--ease-standard);
    transition-delay: calc(var(--ci) * 110ms);
  }
  .doc-line > .claim .claim-tags {
    display: none !important;
  }
  .story[data-step='1'] .doc-line > .claim {
    opacity: 1;
  }
  .story[data-step='1'] .doc-line > .claim .claim-text {
    background-size: 100% 46%;
  }
  .story[data-step='1'] .doc-line > .claim .claim-badge {
    scale: 1;
    opacity: 1;
  }
  /* The line underneath goes quiet once the claim has been picked out. */
  .story[data-step='1'] .doc-line[data-slot] > .line-text {
    opacity: 0;
    transition-delay: calc(var(--ci, 0) * 110ms);
  }

  /* ---------- Capabilities ---------- */
  .caps {
    position: absolute;
    top: 0;
    left: 40cqw;
    width: 60cqw;
    display: flex;
    flex-direction: column;
    gap: 3.2cqw;
  }
  .cap-head {
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    margin-bottom: 1.4cqw;
  }
  .cap-name {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--cap-font);
    line-height: 1.1;
    letter-spacing: var(--tracking-heading);
  }
  .cap-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em 1em;
    font-size: var(--text-body-sm);
  }
  .cap-meta :global(.evidence) {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  .cap-meta :global(.dot) {
    width: 9px;
    height: 9px;
  }
  .cap-count {
    font-size: var(--text-body-sm);
    color: var(--color-accent-strong);
  }
  .cap-claims {
    display: flex;
    flex-direction: column;
    gap: 1cqw;
    padding-left: 1.8cqw;
    border-left: 2px solid var(--color-accent-soft);
  }
  .unknown {
    padding-top: 2.4cqw;
    border-top: 1.5px dashed var(--color-border);
  }
  .unknown-label {
    margin-bottom: 1cqw;
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-caution);
  }
  .unknown-note {
    font-size: var(--doc-font);
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  /* ---------- Step choreography (live only; not-live shows the final state) ---------- */
  .story.is-live[data-step='-1'] .doc {
    opacity: 0;
    translate: 0 5cqw;
  }
  .story.is-live[data-layout='group'] .doc,
  .story:not(.is-live) .doc {
    transform: translate(calc((var(--gx) - var(--x)) * 1cqw), calc((var(--gy) - var(--y)) * 1cqw))
      rotate(calc(var(--gr) * 1deg)) scale(var(--gs));
  }
  .story.is-live[data-layout='group'] .doc {
    transition-delay: 0ms;
  }

  .story.is-live .cap-head {
    transition: opacity var(--motion-slow) ease;
  }
  .story.is-live[data-layout='read'] .cap-head {
    opacity: 0;
  }
  .story.is-live[data-layout='group'] .cap-head {
    opacity: 1;
    transition-delay: calc(0.35s + var(--k) * 120ms);
  }
  .story.is-live .cap-meta,
  .story.is-live .unknown {
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
  }
  .story.is-live:not([data-step='3']) .cap-meta,
  .story.is-live:not([data-step='3']) .unknown {
    opacity: 0;
    translate: 0 1cqw;
  }
  .story.is-live[data-step='3'] .cap-meta {
    transition-delay: calc(var(--k) * 140ms);
  }
  .story.is-live[data-step='3'] .unknown {
    transition-delay: 520ms;
  }

  /* ---------- Narrow stage (phones, small tablets) ---------- */
  @media (max-width: 959px) {
    .story-pin {
      align-items: flex-start;
      padding-block: calc(60px + var(--space-3)) var(--space-4);
    }
    .story-grid {
      gap: var(--space-4);
    }
    .captions {
      gap: var(--space-4);
    }
    .caption-title {
      font-size: var(--text-heading-lg);
    }
    .caption-body {
      font-size: var(--text-body);
    }
    .stage-wrap {
      width: min(100%, calc(64svh / 1.76));
    }
    .stage {
      aspect-ratio: 100 / 176;
      --doc-font: max(13px, 3.5cqw);
      --cap-font: max(18px, 5.4cqw);
    }
    .doc {
      padding: 4cqw 4cqw 4cqw calc(2.3em + 1.4cqw);
      border-radius: 3cqw;
    }
    /* On phones the sources stack like a deck: the CV in front, the others'
       headers peeking out behind it. */
    .doc[data-doc='li'] { --x: 8; --y: 0; --w: 84; --r: 1.2; --gx: 73; --gy: 2; --gr: 1.8; --gs: 0.3; z-index: 1; }
    .doc[data-doc='web'] { --x: 5; --y: 9; --w: 90; --r: -1; --gx: 49; --gy: 0; --gr: -1.5; --gs: 0.3; z-index: 2; }
    .doc[data-doc='gh'] { --x: 2; --y: 18; --w: 96; --r: 0.8; --gx: 25; --gy: 1; --gr: 2; --gs: 0.3; z-index: 3; }
    .doc[data-doc='cv'] { --x: 0; --y: 27; --w: 100; --r: -0.6; --gx: 0; --gy: 0; --gr: -2; --gs: 0.3; z-index: 4; }
    .doc-head {
      margin-left: calc(2.6cqw - 2.3em);
    }
    .caps {
      top: 28cqw;
      left: 0;
      width: 100%;
      gap: 3.4cqw;
    }
    /* Without motion the stage holds the final state: the pile, then the
       capabilities under it, as tall as they need. */
    .story:not(.is-live) .stage-wrap {
      width: 100%;
    }
    .story:not(.is-live) .stage {
      container: stage / inline-size;
      aspect-ratio: auto;
    }
    .story:not(.is-live) .docs {
      position: relative;
      height: 28cqw;
    }
    .story:not(.is-live) .caps {
      position: static;
    }
    .cap-claims {
      gap: 1.4cqw;
      padding-left: 3cqw;
    }
    .unknown-note {
      display: none;
    }
    .cap-head {
      margin-bottom: 2cqw;
    }
    /* On phones the badge says where it came from; the name would cost a line. */
    .caps .claim-source {
      display: none;
    }
    .caps .claim-tags:not(:has(.assisted)) {
      display: none;
    }

    /* Live, the scene has to fit one screen. The title plays first and scrolls
       away; the kicker numbers the steps; the stage takes what's left. */
    .story.is-live .chapter-lead {
      display: block;
      padding-top: var(--space-8);
    }
    .story.is-live .story-pin {
      height: 100svh;
    }
    .story.is-live .story-grid {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
    }
    .story.is-tight .caption-body,
    .story.is-live .captions .chapter,
    .story.is-live .progress {
      display: none;
    }
    .story.is-live .stage-wrap {
      flex: 1;
      min-height: 0;
      width: 100%;
    }
    .story.is-live .stage {
      height: 100%;
      aspect-ratio: auto;
      transform-origin: top center;
    }
    /* A tighter deck, and only the lines that matter: the ones claims come from. */
    .story.is-live .doc[data-doc='web'] { --y: 7; }
    .story.is-live .doc[data-doc='gh'] { --y: 14; }
    .story.is-live .doc[data-doc='cv'] { --y: 21; }
    .story.is-live .doc-line:not([data-slot], .name, .meta) {
      display: none;
    }
    /* In the capabilities a claim is its badge: the words were read a step ago,
       and the phone has room for the count, not the sentences. */
    .story.is-live .caps .claim-body {
      display: none;
    }
    .story.is-live .cap-claims {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2cqw;
      padding-left: 0;
      border-left: 0;
    }
    .story.is-live .cap-head {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      column-gap: 3cqw;
    }
    .story.is-live .cap-count {
      display: none;
    }
  }
</style>

<script>
  import { ScrollTrigger, Flip, reducedMotion, steppedScene } from '../../scripts/motion';

  const story = document.querySelector<HTMLElement>('.story');

  if (story && !reducedMotion) {
    const claims = [...story.querySelectorAll<HTMLElement>('.claim')];
    const slot = (el: HTMLElement) => story.querySelector<HTMLElement>(`[data-slot="${el.dataset.claim}"]`)!;
    const list = (el: HTMLElement) => story.querySelector<HTMLElement>(`[data-list="${el.dataset.cap}"]`)!;

    story.classList.add('is-live');

    // On phones the scene must fit one screen, whatever is left under the
    // captions. The text can't shrink below its minimum size, so when the
    // stage is short the whole stage scales down to fit: measured once with the
    // claims in their capabilities (as rendered), and again for the documents.
    const stage = story.querySelector<HTMLElement>('.stage')!;
    const caps = story.querySelector<HTMLElement>('.caps')!;
    const cv = story.querySelector<HTMLElement>('.doc[data-doc="cv"]')!;
    const narrow = window.matchMedia('(max-width: 959px)');
    const capsBottom = () => caps.offsetTop + caps.offsetHeight;
    let groupH = capsBottom();
    const fit = () => {
      stage.style.scale = '';
      if (!narrow.matches) return;
      if (story.dataset.layout === 'group') groupH = capsBottom();
      const need = Math.max(groupH, cv.offsetTop + cv.offsetHeight) + 8;
      const scaleFor = () => stage.clientHeight / need;
      // A short screen first gives up the captions' second line, then scales.
      story.classList.remove('is-tight');
      if (scaleFor() < 0.8) story.classList.add('is-tight');
      const k = scaleFor();
      if (k < 1) stage.style.scale = String(k);
    };

    // Start from the beginning: every claim back in its source line.
    for (const el of claims) {
      const line = slot(el);
      line.style.setProperty('--ci', el.style.getPropertyValue('--ci'));
      line.append(el);
    }
    story.dataset.layout = 'read';
    story.dataset.step = '-1';

    let step = -1;
    let flight: ReturnType<typeof Flip.from> | undefined;

    // Claims fly into their capability. They join the list's layout straight
    // away and are only transformed from where they were, so the headings
    // below never collapse while the claims are in the air.
    const toCapabilities = () => {
      flight?.progress(1);
      const state = Flip.getState(claims);
      story.dataset.layout = 'group';
      for (const el of claims) list(el).append(el);
      flight = Flip.from(state, {
        duration: 1.1,
        ease: 'power3.inOut',
        stagger: 0.06,
        simple: true,
      });
    };

    const toSources = () => {
      flight?.progress(1);
      story.dataset.layout = 'read';
      for (const el of claims) slot(el).append(el);
    };

    const setStep = (next: number) => {
      if (next === step) return;
      if (step < 2 && next >= 2) toCapabilities();
      if (step >= 2 && next < 2) toSources();
      step = next;
      story.dataset.step = String(next);
    };

    // The documents arrive as the chapter comes into view.
    ScrollTrigger.create({
      trigger: story,
      start: 'top 75%',
      onEnter: () => step < 0 && setStep(0),
    });

    // Then the scene holds still while its steps play, at the reader's pace.
    fit();
    ScrollTrigger.addEventListener('refreshInit', () => (stage.style.scale = ''));
    ScrollTrigger.addEventListener('refresh', fit);

    const pin = story.querySelector<HTMLElement>('.story-pin')!;
    steppedScene({ trigger: pin, pin, steps: 4, onStep: setStep });
  }
</script>
