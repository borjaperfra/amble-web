---
// Revealed intent (PRODUCT_SPEC §15.1) as a deck: three offers, each a real
// trade-off. The candidate answers one at a time; every answer leaves a rule in
// "What I learned". The server renders the finished deck, answers and rules
// visible; with motion allowed, the script stacks the cards and plays the
// answers when the scene comes into view.
import SectionIntro from '../SectionIntro.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['triage'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="triage-title">
  <SectionIntro id="triage-title" kicker={c.kicker} title={c.title} body={c.line} align="center" />

  <div class="scene" data-scene data-triage>
    <ol class="deck" role="list">
      {
        c.offers.map((o, i) => (
          <li class="offer" style={`--i:${i}`}>
            <p class="offer-role heading">{o.role}</p>
            <p class="offer-company">{o.company}</p>
            <ul class="facts" role="list">
              {o.facts.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <div class="verdicts" aria-hidden="true">
              {c.verdicts.map((v) => (
                <span class:list={['verdict', { chosen: v === o.verdict }]}>{v}</span>
              ))}
            </div>
            <p class="reason">
              <span class="who">{c.who}</span>
              <span class="heading">{o.reason}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <div class="learned">
      <p class="kicker learned-label">{c.learnedLabel}</p>
      <ul class="rules" role="list">
        {
          c.offers.map((o, i) => (
            <li class="rule" style={`--i:${i}`}>
              <span class="rule-type">{o.learned.type}</span>
              <span class="rule-text heading">{o.learned.text}</span>
            </li>
          ))
        }
      </ul>
      <a class="text-link to-listening" href="#stage-listens">{c.toListening}</a>
    </div>
  </div>
</section>

<style>
  .scene {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    max-width: var(--width-wide);
    margin: var(--space-8) auto 0;
  }
  @media (min-width: 900px) {
    .scene {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-9);
    }
  }

  /* ---------- The offers ---------- */
  .deck {
    display: grid;
    gap: var(--space-4);
  }
  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: clamp(var(--space-5), 1rem + 1.5vw, var(--space-6));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
  }
  .offer-role {
    font-size: var(--text-heading-md);
  }
  .offer-company {
    color: var(--color-text-muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .facts li {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-body-sm);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-full);
  }
  .verdicts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .verdict {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      background var(--motion-default) ease,
      color var(--motion-default) ease,
      border-color var(--motion-default) ease,
      transform var(--motion-fast) ease;
  }
  .verdict.chosen,
  .offer.is-answered .verdict.chosen {
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-color: var(--color-action);
  }
  .reason {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .who {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
  }
  .reason .heading {
    font-size: var(--text-heading-sm);
    line-height: var(--leading-tight);
  }

  /* Live: the offers become a deck, answered one by one. */
  .scene.is-live .deck {
    position: relative;
    display: block;
    min-height: var(--deck-height, 380px);
  }
  .scene.is-live .offer {
    position: absolute;
    inset: 0 0 auto 0;
    transform-origin: 50% 0;
  }
  .scene.is-live .offer .verdict.chosen {
    color: var(--color-text-muted);
    background: transparent;
    border-color: var(--color-border);
  }
  .scene.is-live .offer.is-answered .verdict.chosen {
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-color: var(--color-action);
    transform: scale(0.96);
  }

  /* ---------- What I learned ---------- */
  .learned {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .learned-label {
    color: var(--color-accent-strong);
  }
  .rules {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .rule {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 76px;
    padding: var(--space-4) var(--space-5);
    background: var(--color-accent-wash);
    border: var(--border-width) solid var(--color-accent-soft);
    border-radius: var(--radius-md);
  }
  .rule-type {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }
  .rule-text {
    font-size: var(--text-heading-sm);
  }
  /* Empty slots wait, dashed, until an answer fills them. */
  .scene.is-live .rule {
    background: transparent;
    border-style: dashed;
    border-color: var(--color-border);
  }
  .scene.is-live .rule > * {
    opacity: 0;
  }
  .scene.is-live .rule.is-filled {
    background: var(--color-accent-wash);
    border-style: solid;
    border-color: var(--color-accent-soft);
    transition:
      background var(--motion-slow) ease,
      border-color var(--motion-slow) ease;
  }
  .scene.is-live .rule.is-filled > * {
    opacity: 1;
    transition: opacity var(--motion-slow) ease 0.15s;
  }
  .to-listening {
    align-self: flex-start;
    color: var(--color-accent-strong);
    font-weight: var(--weight-medium);
  }
  .scene.is-live .to-listening {
    opacity: 0;
    transition: opacity var(--motion-slow) ease;
  }
  .scene.is-live:has(.rule:last-child.is-filled) .to-listening {
    opacity: 1;
    transition-delay: 0.4s;
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  const scene = document.querySelector<HTMLElement>('[data-triage]');

  if (scene && !reducedMotion) {
    const deck = scene.querySelector<HTMLElement>('.deck')!;
    const offers = [...scene.querySelectorAll<HTMLElement>('.offer')];
    const rules = [...scene.querySelectorAll<HTMLElement>('.rule')];

    scene.classList.add('is-live');

    // The deck is as tall as its tallest card, plus room for the cards behind it.
    const measure = () => {
      const tallest = Math.max(...offers.map((o) => o.offsetHeight));
      deck.style.setProperty('--deck-height', `${tallest + 56}px`);
    };

    const stack = () => {
      offers.forEach((o, i) => {
        o.classList.remove('is-answered');
        gsap.set(o, { x: 0, y: i * 26, scale: 1 - i * 0.04, rotate: 0, opacity: 1, zIndex: offers.length - i });
        gsap.set(o.querySelector('.reason'), { opacity: 0, y: 6 });
      });
      rules.forEach((r) => r.classList.remove('is-filled'));
    };

    const play = () => {
      stack();
      const tl = gsap.timeline({ delay: 0.3 });
      offers.forEach((o, i) => {
        const at = i * 3.1;
        tl.call(() => o.classList.add('is-answered'), [], at + 0.9);
        tl.to(o.querySelector('.reason'), { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, at + 1.3);
        tl.call(() => rules[i].classList.add('is-filled'), [], at + 2.0);
        if (i < offers.length - 1) {
          tl.to(o, { x: '-6%', y: -24, rotate: -4, opacity: 0, duration: 0.7, ease: 'power2.in' }, at + 2.7);
          offers.slice(i + 1).forEach((next, j) => {
            tl.to(next, { y: j * 26, scale: 1 - j * 0.04, duration: 0.6, ease: 'power3.out' }, at + 2.9);
          });
        }
      });
    };

    measure();
    stack();
    window.addEventListener('resize', measure, { passive: true });
    scene.addEventListener('scene:play', play, { once: true });
  }
</script>
