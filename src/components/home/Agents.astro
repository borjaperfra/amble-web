---
// Agent to agent (v2): the company's agent asks, Maya's Rep answers with
// evidence, keeps what's private private, and the conversation ends with both
// sides wanting to talk — and Maya deciding. Marked as coming.
import SectionIntro from '../SectionIntro.astro';
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['agents'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="agents-title">
  <p class="badge-row" data-reveal><span class="version-badge">{c.badge}</span></p>
  <SectionIntro id="agents-title" kicker={c.kicker} title={c.title} body={c.line} align="center" />

  <div class="scene" data-scene>
    <header class="sides">
      <p class="side theirs">
        <span class="face other"><Symbol size={30} class="mirror" /></span>
        {c.theirs}
      </p>
      <span class="wire" aria-hidden="true"></span>
      <p class="side yours">
        {c.yours}
        <span class="face"><Symbol size={30} /></span>
      </p>
    </header>

    <ol class="talk" role="list">
      {
        c.messages.map((m, i) => (
          <li class:list={['msg', m.from]} style={`--i:${i}`}>
            <p class="bubble">{m.text}</p>
            {m.evidence && <p class="evidence">✓ {m.evidence}</p>}
            {m.private && (
              <p class="private">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <rect x="5" y="10.5" width="14" height="10" rx="2" />
                  <path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" />
                </svg>
                {m.private} · € ••••
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <p class="outcome" style={`--i:${c.messages.length}`}>
      <span class="outcome-faces" aria-hidden="true">
        <span class="face other"><Symbol size={22} class="mirror" /></span>
        <span class="face"><Symbol size={22} /></span>
      </span>
      {c.outcome}
    </p>
  </div>
</section>

<style>
  .badge-row {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .version-badge {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1.5px dashed var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .scene {
    max-width: 760px;
    margin: var(--space-8) auto 0;
    padding: clamp(var(--space-5), 1rem + 2vw, var(--space-7));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sheet);
  }

  .sides {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .side {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-semibold);
  }
  .side.theirs {
    color: var(--color-other);
  }
  .wire {
    flex: 1;
    height: 2px;
    background-image: linear-gradient(to right, var(--color-border) 50%, transparent 0);
    background-size: 8px 2px;
  }
  .face {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-text);
    background: var(--color-accent-wash);
    border-radius: var(--radius-full);
  }
  .face.other {
    --symbol-iris: var(--color-other);
    color: var(--color-other);
    background: var(--color-other-soft);
  }
  .face :global(.mirror) {
    scale: -1 1;
  }

  .talk {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .msg {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 78%;
  }
  .msg.theirs {
    align-self: flex-start;
  }
  .msg.yours {
    align-self: flex-end;
    align-items: flex-end;
  }
  .bubble {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-body);
    line-height: var(--leading-tight);
    border-radius: 18px;
  }
  .theirs .bubble {
    color: var(--color-text);
    background: var(--color-other-soft);
    border-bottom-left-radius: 6px;
  }
  .yours .bubble {
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
    border-bottom-right-radius: 6px;
  }
  .evidence,
  .private {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
  }
  .evidence {
    color: var(--color-accent-strong);
  }
  .private {
    padding: 2px var(--space-3);
    color: var(--color-caution);
    background: var(--color-caution-soft);
    border-radius: var(--radius-full);
  }
  .private svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .outcome {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .outcome-faces {
    display: inline-flex;
  }
  .outcome-faces .face {
    width: 36px;
    height: 36px;
    box-shadow: 0 0 0 3px var(--color-surface-raised);
  }
  .outcome-faces .face + .face {
    margin-left: -8px;
  }

  /* One message after another, at the pace of a conversation. */
  .js .scene :is(.msg, .outcome) {
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.3s + var(--i) * 0.75s);
  }
  .js .scene:not(.is-playing) :is(.msg, .outcome) {
    opacity: 0;
    translate: 0 10px;
  }
  @media (max-width: 560px) {
    .msg {
      max-width: 92%;
    }
    .side {
      font-size: var(--text-body-sm);
    }
  }
</style>
