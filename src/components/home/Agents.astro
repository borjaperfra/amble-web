---
// A glimpse of where Amble goes (v2): the company's agent and your Rep settle
// it between them, quietly, and only then do people talk. Short on purpose.
import AgentLine from '../AgentLine.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['agents'];
}

const { c } = Astro.props;
---

<section class="agents container" aria-labelledby="agents-title">
  <p class="badge" data-reveal>{c.badge}</p>
  <h2 class="display title" id="agents-title" data-reveal>{c.title}</h2>
  <p class="line heading" data-reveal>{c.line}</p>

  <div class="scene">
    <AgentLine left={c.theirs} right={c.yours} signals={c.signals} result={c.steps[0]} note={c.privateLine} />
  </div>

  <p class="closer" data-reveal>{c.closer}</p>
</section>

<style>
  .agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
  }
  .badge {
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1px dashed var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .title {
    max-width: 16ch;
    font-size: var(--text-chapter);
  }
  .line {
    margin-top: var(--space-3);
    font-size: var(--text-heading-md);
    font-style: italic;
    color: var(--color-accent-strong);
  }
  .scene {
    width: 100%;
    margin-top: var(--space-scene);
  }
  .closer {
    max-width: 30rem;
    margin-top: var(--space-6);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
</style>
