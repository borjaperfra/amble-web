---
// A glimpse of where Amble goes (v2): the company's agent asks, your Rep
// answers, the salary is checked without revealing her floor, and only then
// do humans talk. Short on purpose.
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['agents'];
}

const { c } = Astro.props;
---

<section class="agents container" aria-labelledby="agents-title">
  <p class="badge" data-reveal>{c.badge}</p>
  <p class="kicker" data-reveal>{c.kicker}</p>
  <h2 class="display title" id="agents-title" data-reveal>{c.title}</h2>
  <p class="line heading" data-reveal>{c.line}</p>

  <figure class="scene" data-scene>
    <header class="sides">
      <p class="side theirs">
        <span class="face other"><Symbol size={30} class="mirror" /></span>
        {c.theirs}
      </p>
      <p class="side yours">
        {c.yours}
        <span class="face"><Symbol size={30} /></span>
      </p>
    </header>

    <ol class="exchange" role="list">
      {
        c.exchange.map((x, i) => (
          <li class="row" style={`--i:${i}`}>
            <span class="ask">{x.ask}</span>
            <span class="wire" aria-hidden="true">
              <span class="to" />
              <span class="back" />
            </span>
            <span class="answer">✓ {x.answer}</span>
          </li>
        ))
      }
    </ol>

    <div class="salary" style={`--i:${c.exchange.length}`}>
      <p class="range">
        <span class="range-label">{c.range.label}</span>
        <span class="range-value">{c.range.value}</span>
      </p>
      <p class="overlap" aria-hidden="true"><span /></p>
      <p class="range hidden">
        <span class="range-label">{c.range.floorLabel}</span>
        <span class="range-value blur">€ ••••</span>
      </p>
      <p class="private">{c.privateLine}</p>
    </div>

    <ol class="steps" role="list">
      {c.steps.map((st, i) => <li style={`--i:${c.exchange.length + 1 + i}`}>↓ <span>{st}</span></li>)}
    </ol>
  </figure>

  <p class="closer" data-reveal>{c.closer}</p>
</section>

<style>
  .agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
  }
  .badge {
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1.5px dashed var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .title {
    max-width: 16ch;
    margin-top: var(--space-4);
    font-size: var(--text-display-lg);
  }
  .line {
    margin-top: var(--space-4);
    font-size: var(--text-heading-md);
    font-style: italic;
    color: var(--color-accent-strong);
  }

  .scene {
    width: 100%;
    max-width: 720px;
    margin-top: var(--space-8);
    padding: clamp(var(--space-5), 1rem + 2vw, var(--space-7));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sheet);
  }
  .sides {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .side {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-semibold);
  }
  .theirs {
    color: var(--color-other);
  }
  .face {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-text);
    background: var(--color-accent-wash);
    border-radius: var(--radius-full);
  }
  .face.other {
    --symbol-iris: var(--color-other);
    color: var(--color-other);
    background: var(--color-other-soft);
  }
  .face :global(.mirror) {
    scale: -1 1;
  }

  /* Each question travels right, the answer comes back. */
  .exchange {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr 9rem;
    align-items: center;
    gap: var(--space-3);
  }
  .ask {
    justify-self: start;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-body-sm);
    color: var(--color-text);
    background: var(--color-other-soft);
    border-radius: var(--radius-md);
  }
  .answer {
    justify-self: end;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
    border-radius: var(--radius-md);
  }
  .wire {
    position: relative;
    height: 14px;
  }
  .wire .to,
  .wire .back {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    transform-origin: left;
  }
  .wire .to {
    top: 3px;
    background: var(--color-other);
  }
  .wire .back {
    bottom: 3px;
    background: var(--color-accent);
    transform-origin: right;
  }

  .salary {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }
  .range {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .range-label {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .range-value {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
  }
  .blur {
    filter: blur(6px);
    user-select: none;
  }
  .overlap {
    position: relative;
    height: 10px;
    margin: var(--space-1) 0;
    background: linear-gradient(to right, var(--color-other-soft) 0 70%, transparent 0) 0 0 / 100% 4px no-repeat,
      linear-gradient(to right, transparent 0 45%, var(--color-accent-soft) 0) 0 6px / 100% 4px no-repeat;
  }
  .overlap span {
    position: absolute;
    left: 57%;
    top: 50%;
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 4px var(--color-accent-wash);
  }
  .private {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-accent-strong);
  }
  .steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--color-text-faint);
  }
  .steps span {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-text);
  }
  .steps li:last-child span {
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
  }
  .closer {
    max-width: 30rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  /* Choreography: one exchange after another, then the salary, then the steps. */
  .row,
  .salary,
  .steps li {
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.3s + var(--i) * 0.8s);
  }
  .wire .to,
  .wire .back {
    transition: transform 0.5s var(--ease-standard);
  }
  .wire .to {
    transition-delay: calc(0.45s + var(--i) * 0.8s);
  }
  .wire .back {
    transition-delay: calc(0.75s + var(--i) * 0.8s);
  }
  :global(.motion) .scene:not(.is-playing) :is(.row, .salary, .steps li) {
    opacity: 0;
    translate: 0 8px;
  }
  :global(.motion) .scene:not(.is-playing) .wire :is(.to, .back) {
    transform: scaleX(0);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>
