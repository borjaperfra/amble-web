---
// The end: back to paper and the eye. One line about who it's for, the
// headline again, the form, and "Remove applications." Nothing else.
import Symbol from '../Symbol.astro';
import Waitlist from '../Waitlist.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['finale'];
  hero: HomeContent['hero'];
}

const { c, hero } = Astro.props;
---

<section class="finale container" aria-labelledby="finale-title">
  <div class="inner" data-reveal>
    <p class="pre heading">{c.pre}</p>
    <Symbol size={64} watch breathe />
    <h2 class="display title" id="finale-title">
      {hero.title[0]}
      <br />
      <em>Amble</em>{' '}{hero.title[1]}
    </h2>
    <div class="form">
      <Waitlist id="finale" cta={c.cta} />
    </div>
    <p class="small">{c.small}</p>
    <p class="remove display">{c.remove}</p>
  </div>
</section>

<style>
  .finale {
    padding-block: var(--space-section) var(--space-7);
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }
  .pre {
    margin-bottom: var(--space-6);
    font-size: var(--text-heading-lg);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .title {
    font-size: var(--text-chapter);
  }
  .form {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-4);
  }
  .small {
    max-width: 30rem;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .remove {
    margin-top: var(--space-10);
    font-size: var(--text-thesis);
    color: var(--color-accent-strong);
  }
</style>
