---
// Defence questions (PRODUCT_SPEC §10.2), shown on the code itself: a line from
// co-produced work, the claim the Rep drew from it, the question, the answer
// typed out, and the verdict stamped. One stays; one is struck and kept on
// record as retracted.
import SectionIntro from '../SectionIntro.astro';
import Symbol from '../Symbol.astro';
import SourceIcon from '../SourceIcon.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['defence'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="defence-title">
  <SectionIntro id="defence-title" kicker={c.kicker} title={c.title} body={c.line} align="center" />

  <div class="cases" data-scene data-defence>
    {
      c.cases.map((k, i) => (
        <article class:list={['case', k.verdict]} style={`--n:${i}`}>
          <div class="code">
            <p class="code-head">
              <span class="file">
                <SourceIcon source="gh" size={14} /> {k.file}
              </span>
              <span class="assisted">⚠ {k.assisted}</span>
            </p>
            <pre>
              {k.code.map((line) => (
                <code class:list={['code-line', { key: line.key }]}>{line.text}</code>
              ))}
            </pre>
          </div>

          <p class="claim">
            <span class="claim-text">{k.claim}</span>
          </p>

          <div class="thread">
            <p class="bubble rep">
              <Symbol size={18} />
              <span>{k.ask}</span>
            </p>
            <p class="bubble person" data-type={k.answer}>
              {k.answer}
            </p>
          </div>

          <p class="outcome">{k.outcome}</p>

          <p class="stamp" aria-label={k.stamp}>
            <span aria-hidden="true">{k.verdict === 'defended' ? '✓' : '⊘'}</span> {k.stamp}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: var(--space-6);
    max-width: var(--width-wide);
    margin: var(--space-8) auto 0;
  }
  @media (min-width: 860px) {
    .cases {
      grid-template-columns: 1fr 1fr;
    }
  }
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 1rem + 1.6vw, var(--space-6));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
  }

  /* The code the claim came from */
  .code {
    overflow: hidden;
    background: var(--color-code-bg);
    border-radius: var(--radius-md);
    transition: opacity var(--motion-slow) ease;
  }
  .code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-code-faint);
    border-bottom: var(--border-width) solid rgb(250 248 243 / 0.08);
  }
  .file {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
  .assisted {
    font-size: var(--text-body-sm);
    color: var(--color-code-caution);
  }
  pre {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-3) 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: 1.7;
    white-space: normal;
  }
  .code-line {
    display: block;
    padding: 0 var(--space-4);
    color: var(--color-code-text);
    white-space: pre;
    background-image: linear-gradient(90deg, var(--color-code-mark), var(--color-code-mark));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: background-size 0.8s var(--ease-standard);
  }
  .code-line.key {
    color: var(--color-text-inverse);
    box-shadow: inset 2px 0 0 var(--color-accent-soft);
    background-size: 100% 100%;
  }

  /* The claim drawn from it */
  .claim-text {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    line-height: var(--leading-tight);
    text-decoration-line: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    transition:
      text-decoration-color var(--motion-slow) ease,
      color var(--motion-slow) ease;
  }

  /* Question and answer */
  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .bubble {
    max-width: 90%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-body);
    line-height: var(--leading-tight);
  }
  .bubble.rep {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    border-bottom-left-radius: var(--radius-sm);
  }
  .bubble.person {
    align-self: flex-end;
    min-height: 2.9em;
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-bottom-right-radius: var(--radius-sm);
  }
  .bubble.person.is-typing::after {
    content: '▍';
    margin-left: 1px;
    opacity: 0.6;
    animation: caret 0.9s steps(2) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* Verdict */
  .outcome {
    padding-top: var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .defended .outcome {
    color: var(--color-accent-strong);
  }
  .retracted .outcome {
    color: var(--color-retracted);
  }
  .stamp {
    position: absolute;
    top: 44%;
    right: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border: 2px solid currentColor;
    border-radius: var(--radius-md);
    rotate: -8deg;
    box-shadow: 0 6px 18px rgb(37 37 31 / 0.12);
  }
  .defended .stamp {
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
  }
  .retracted .stamp {
    color: var(--color-retracted);
    background: var(--color-retracted-soft);
  }
  .retracted .claim-text {
    color: var(--color-text-faint);
    text-decoration-color: var(--color-retracted);
  }
  .retracted .code {
    opacity: 0.55;
  }

  /* ---------- Choreography ---------- */
  .js .cases :is(.claim, .bubble, .outcome) {
    transition:
      opacity var(--motion-arrive) ease,
      translate var(--motion-arrive) var(--ease-standard);
  }
  .js .cases:not(.is-playing) :is(.claim, .bubble, .outcome) {
    opacity: 0;
    translate: 0 8px;
  }
  .js .cases:not(.is-playing) .stamp {
    opacity: 0;
    scale: 1.8;
  }
  .js .cases:not(.is-playing) .code-line.key {
    background-size: 0% 100%;
  }
  .js .cases:not(.is-playing) .retracted .claim-text {
    color: var(--color-text);
    text-decoration-color: transparent;
  }
  .js .cases:not(.is-playing) .retracted .code {
    opacity: 1;
  }
  .js .cases .code-line.key {
    transition-delay: calc(0.2s + var(--n) * 1.1s);
  }
  .js .cases .claim {
    transition-delay: calc(0.5s + var(--n) * 1.1s);
  }
  .js .cases .bubble.rep {
    transition-delay: calc(0.9s + var(--n) * 1.1s);
  }
  .js .cases .bubble.person {
    transition-delay: calc(1.4s + var(--n) * 1.1s);
  }
  .js .cases .stamp {
    transition:
      opacity 0.2s ease,
      scale 0.42s cubic-bezier(0.25, 1.6, 0.5, 1);
    transition-delay: calc(2.9s + var(--n) * 1.1s);
  }
  .js .cases .claim-text,
  .js .cases .code {
    transition-delay: calc(3s + var(--n) * 1.1s);
  }
  .js .cases .outcome {
    transition-delay: calc(3.2s + var(--n) * 1.1s);
  }
  .case.is-stamped {
    animation: thud 0.35s ease-out;
  }
  @keyframes thud {
    30% {
      translate: 0 3px;
    }
  }

  @media (max-width: 600px) {
    .stamp {
      top: auto;
      bottom: var(--space-4);
      right: var(--space-4);
    }
    .outcome {
      padding-right: 8.5rem;
    }
  }
</style>

<script>
  // The answer types itself out, then the card takes the stamp.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const scene of document.querySelectorAll<HTMLElement>('[data-defence]')) {
    if (still) continue;
    const cases = [...scene.querySelectorAll<HTMLElement>('.case')];
    const answers = cases.map((k) => k.querySelector<HTMLElement>('.bubble.person')!);
    answers.forEach((a) => (a.textContent = ''));

    scene.addEventListener(
      'scene:play',
      () => {
        cases.forEach((k, i) => {
          const answer = answers[i];
          const text = answer.dataset.type ?? '';
          setTimeout(() => {
            answer.classList.add('is-typing');
            let n = 0;
            const step = () => {
              n += 1;
              answer.textContent = text.slice(0, n);
              if (n < text.length) setTimeout(step, 26);
              else answer.classList.remove('is-typing');
            };
            step();
          }, 1650 + i * 1100);
          setTimeout(() => k.classList.add('is-stamped'), 3050 + i * 1100);
        });
      },
      { once: true },
    );
  }
</script>
