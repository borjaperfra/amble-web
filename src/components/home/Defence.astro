---
// Defence questions (PRODUCT_SPEC §10.2) as two short scenes: a claim from
// co-produced work, the Rep's question, the answer, and a stamp. One stays,
// one is struck out and kept on record as retracted.
import SectionIntro from '../SectionIntro.astro';
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['defence'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="defence-title">
  <SectionIntro id="defence-title" kicker={c.kicker} title={c.title} body={c.line} align="center" />

  <div class="cases" data-scene>
    {
      c.cases.map((k, i) => (
        <article class:list={['case', k.verdict]} style={`--n:${i}`}>
          <p class="claim">
            <span class="claim-text">{k.claim}</span>
            <span class="assisted">⚠ {k.assisted}</span>
          </p>
          <div class="thread">
            <p class="bubble rep">
              <Symbol size={18} />
              <span>{k.ask}</span>
            </p>
            <p class="bubble person">{k.answer}</p>
          </div>
          <p class="stamp" aria-label={k.stamp}>
            <span aria-hidden="true">{k.verdict === 'defended' ? '✓' : '⊘'}</span> {k.stamp}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .cases {
    display: grid;
    gap: var(--space-6);
    max-width: var(--width-wide);
    margin: var(--space-8) auto 0;
  }
  @media (min-width: 860px) {
    .cases {
      grid-template-columns: 1fr 1fr;
    }
  }
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: clamp(var(--space-5), 1rem + 2vw, var(--space-7));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
    overflow: hidden;
  }

  .claim {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    /* room for the stamp */
    padding-right: 8.5rem;
  }
  .claim-text {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    line-height: var(--leading-tight);
    text-decoration-line: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    transition:
      text-decoration-color var(--motion-slow) ease,
      color var(--motion-slow) ease;
  }
  .assisted {
    font-size: var(--text-body-sm);
    color: var(--color-caution);
  }

  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .bubble {
    max-width: 88%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-body);
    line-height: var(--leading-tight);
  }
  .bubble.rep {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    border-bottom-left-radius: var(--radius-sm);
  }
  .bubble.person {
    align-self: flex-end;
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-bottom-right-radius: var(--radius-sm);
  }

  .stamp {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-sm);
    rotate: -6deg;
  }
  /* On phones the stamp lands at the foot of the card instead. */
  @media (max-width: 600px) {
    .claim {
      padding-right: 0;
    }
    .stamp {
      position: static;
      align-self: flex-start;
    }
  }
  .defended .stamp {
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
  }
  .retracted .stamp {
    color: var(--color-retracted);
    background: var(--color-retracted-soft);
  }

  /* The verdict lands */
  .retracted .claim-text {
    color: var(--color-text-faint);
    text-decoration-color: var(--color-retracted);
  }
  .defended .assisted {
    color: var(--color-accent-strong);
  }

  /* Choreography: claim, question, answer, then the stamp comes down. */
  .js .cases:not(.is-playing) .bubble {
    opacity: 0;
    translate: 0 8px;
  }
  .js .cases:not(.is-playing) .stamp {
    opacity: 0;
    scale: 1.6;
  }
  .js .cases:not(.is-playing) .retracted .claim-text {
    color: var(--color-text);
    text-decoration-color: transparent;
  }
  .js .cases .bubble {
    transition:
      opacity var(--motion-arrive) ease,
      translate var(--motion-arrive) var(--ease-standard);
  }
  .js .cases .bubble.rep {
    transition-delay: calc(0.3s + var(--n) * 0.9s);
  }
  .js .cases .bubble.person {
    transition-delay: calc(1.1s + var(--n) * 0.9s);
  }
  .js .cases .stamp {
    transition:
      opacity 0.25s ease,
      scale 0.45s cubic-bezier(0.3, 1.4, 0.5, 1);
    transition-delay: calc(1.9s + var(--n) * 0.9s);
  }
  .js .cases .claim-text {
    transition-delay: calc(2s + var(--n) * 0.9s);
  }
</style>
