---
// Defence questions (PRODUCT_SPEC §10.2), shown on the code itself: a line from
// co-produced work, the claim the Rep drew from it, the question, the answer
// typed out, and the verdict stamped. One stays; one is struck and kept on
// record as retracted.
import SectionIntro from '../SectionIntro.astro';
import Symbol from '../Symbol.astro';
import SourceIcon from '../SourceIcon.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['defence'];
}

const { c } = Astro.props;
---

<section class="night" aria-labelledby="defence-title">
  <div class="container">
  <SectionIntro id="defence-title" kicker={c.kicker} title={c.title} body={c.line} align="center" level="observation" />

  <div class="cases" data-scene data-defence>
    {
      c.cases.map((k, i) => (
        <article class:list={['case', k.verdict]} style={`--n:${i}`}>
          <div class="code">
            <p class="code-head">
              <span class="file">
                <SourceIcon source="gh" size={14} /> {k.file}
              </span>
              <span class="assisted">⚠ {k.assisted}</span>
            </p>
            <pre>
              {k.code.map((line) => (
                <code class:list={['code-line', { key: line.key }]}>{line.text}</code>
              ))}
            </pre>
          </div>

          <p class="claim">
            <span class="claim-text">{k.claim}</span>
          </p>

          <div class="thread">
            <p class="bubble rep">
              <Symbol size={18} />
              <span>{k.ask}</span>
            </p>
            <p class="bubble person">
              <span class="ghost" aria-hidden="true">{k.answer}</span>
              <span class="typed">{k.answer}</span>
            </p>
          </div>

          <p class="outcome">{k.outcome}</p>

          <p class="stamp" aria-label={k.stamp}>
            <span aria-hidden="true">{k.verdict === 'defended' ? '✓' : '⊘'}</span> {k.stamp}
          </p>
        </article>
      ))
    }
  </div>
  </div>
</section>

<style>
  /* Night: the one dark section, where the code lives. */
  .night {
    padding-block: var(--space-section);
    background: var(--color-code-bg);
    color: var(--color-text-inverse);
  }
  .night :global(.intro .kicker) {
    color: var(--color-code-faint);
  }
  .night :global(.intro .lede) {
    color: var(--color-code-text);
  }
  .night .case {
    color: var(--color-text);
    border-color: transparent;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.35);
  }
  .night .code {
    background: #34342d;
  }
  .cases {
    display: grid;
    gap: var(--space-6);
    max-width: var(--width-wide);
    margin: var(--space-scene) auto 0;
  }
  @media (min-width: 860px) {
    .cases {
      grid-template-columns: 1fr 1fr;
    }
  }
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(var(--space-5), 1rem + 1.6vw, var(--space-6));
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sheet);
  }

  /* The code the claim came from */
  .code {
    overflow: hidden;
    background: var(--color-code-bg);
    border-radius: var(--radius-md);
    transition: background var(--motion-slow) ease;
  }
  .code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-code-faint);
    border-bottom: var(--border-width) solid rgb(250 248 243 / 0.08);
  }
  .file {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
  .assisted {
    font-size: var(--text-body-sm);
    color: var(--color-code-caution);
  }
  pre {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-3) 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: 1.7;
    white-space: normal;
  }
  .code-line {
    display: block;
    padding: 0 var(--space-4);
    color: var(--color-code-text);
    white-space: pre;
    background-image: linear-gradient(90deg, var(--color-code-mark), var(--color-code-mark));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition:
      background-size 0.8s var(--ease-standard),
      text-decoration-color var(--motion-slow) ease;
  }
  .code-line.key {
    color: var(--color-text-inverse);
    box-shadow: inset 2px 0 0 var(--color-accent-soft);
    background-size: 100% 100%;
  }

  /* The claim drawn from it */
  .claim-text {
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    line-height: var(--leading-tight);
    text-decoration-line: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    transition:
      text-decoration-color var(--motion-slow) ease,
      color var(--motion-slow) ease;
  }

  /* Question and answer */
  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .bubble {
    max-width: 90%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    font-size: var(--text-body);
    line-height: var(--leading-tight);
  }
  .bubble.rep {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border-subtle);
    border-bottom-left-radius: var(--radius-sm);
  }
  .bubble.person {
    align-self: flex-end;
    min-height: 2.9em;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-inverse);
    background: var(--color-action);
    border-bottom-right-radius: var(--radius-sm);
  }
  .bubble.person {
    position: relative;
  }
  .ghost {
    visibility: hidden;
  }
  .typed {
    position: absolute;
    inset: var(--space-3) var(--space-4);
  }
  .bubble.person.is-typing .typed::after {
    content: '▍';
    margin-left: 1px;
    opacity: 0.6;
    animation: caret 0.9s steps(2) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* Verdict */
  .outcome {
    min-height: 2.6em;
    padding-top: var(--space-4);
    padding-right: 9.5rem;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .defended .outcome {
    color: var(--color-accent-strong);
  }
  .retracted .outcome {
    color: var(--color-retracted);
  }
  /* The verdict sits with the outcome, at the foot of the card: it comes after the answer. */
  .stamp {
    position: absolute;
    bottom: calc(var(--space-5) - 4px);
    right: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border: 2px solid currentColor;
    border-radius: var(--radius-md);
    rotate: -8deg;
    box-shadow: 0 6px 18px rgb(37 37 31 / 0.12);
  }
  .defended .stamp {
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
  }
  .retracted .stamp {
    color: var(--color-retracted);
    background: var(--color-retracted-soft);
  }
  .retracted .claim-text {
    color: var(--color-text-faint);
    text-decoration-color: var(--color-retracted);
  }
  /* Retracted: the code stays legible, the decision in it is struck through. */
  .retracted .code {
    background: var(--color-code-bg-dim);
  }
  .night .retracted .code {
    background: #43433b;
  }
  .retracted .code-line.key {
    text-decoration: line-through;
    text-decoration-color: var(--color-code-strike);
    text-decoration-thickness: 1.5px;
  }

  /* ---------- Choreography ----------
     Driven by the script, one step after another: the key line lights up, the
     question is asked, the answer is typed, and only then the verdict lands.
     Everything is visible by default; the hidden states apply only once
     motion is running. */
  .claim,
  .bubble,
  .outcome,
  .stamp {
    transition:
      opacity 0.6s ease,
      translate 0.7s var(--ease-standard),
      scale 0.7s var(--ease-standard);
  }
  :global(.motion) .case:not(.is-read) .code-line.key {
    background-size: 0% 100%;
  }
  :global(.motion) .case:not(.is-read) .claim,
  :global(.motion) .case:not(.is-asked) .bubble.rep,
  :global(.motion) .case:not(.is-answering) .bubble.person,
  :global(.motion) .case:not(.is-judged) .outcome {
    opacity: 0;
    translate: 0 8px;
  }
  :global(.motion) .case:not(.is-judged) .stamp {
    opacity: 0;
    scale: 1.12;
  }
  :global(.motion) .case.retracted:not(.is-judged) .claim-text {
    color: var(--color-text);
    text-decoration-color: transparent;
  }
  :global(.motion) .case.retracted:not(.is-judged) .code {
    background: var(--color-code-bg);
  }
  :global(.motion) .case.retracted:not(.is-judged) .code-line.key {
    text-decoration-color: transparent;
  }
  .case.is-judged .outcome {
    transition-delay: 0.35s;
  }

  @media (max-width: 600px) {
    .stamp {
      right: var(--space-4);
    }
    .outcome {
      padding-right: 8.5rem;
    }
  }
</style>

<script>
  // One case at a time: read, ask, type the answer, then the verdict.
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const scene of document.querySelectorAll<HTMLElement>('[data-defence]')) {
    const cases = [...scene.querySelectorAll<HTMLElement>('.case')];
    if (calm) {
      cases.forEach((k) => k.classList.add('is-read', 'is-asked', 'is-answering', 'is-judged'));
      continue;
    }
    // The bubble keeps the size of the full answer (the ghost) from the start;
    // only the visible text is typed, so nothing around it grows.
    const answers = cases.map((k) => k.querySelector<HTMLElement>('.bubble.person .typed')!);
    const texts = answers.map((a) => a.textContent ?? '');
    answers.forEach((a) => (a.textContent = ''));

    // The answer arrives word by word, at the pace of someone thinking it through.
    const type = async (el: HTMLElement, text: string) => {
      el.parentElement!.classList.add('is-typing');
      const words = text.split(' ');
      for (let n = 1; n <= words.length; n++) {
        el.textContent = words.slice(0, n).join(' ');
        await wait(/[.?]$/.test(words[n - 1]) ? 380 : 90);
      }
      el.parentElement!.classList.remove('is-typing');
    };

    scene.addEventListener(
      'scene:play',
      async () => {
        for (const [i, k] of cases.entries()) {
          k.classList.add('is-read');
          await wait(700);
          k.classList.add('is-asked');
          await wait(800);
          k.classList.add('is-answering');
          await wait(250);
          await type(answers[i], texts[i]);
          await wait(450);
          k.classList.add('is-judged');
          await wait(900);
        }
      },
      { once: true },
    );
  }
</script>
