---
// The one moment of colour on the page: the listening screen, full bleed in
// moss, with the eye breathing. Almost nothing to read — silence is the point.
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['listening'];
}

const { c } = Astro.props;
---

<section class="listening" aria-labelledby="listening-title">
  <div class="container inner">
    <p class="kicker" data-reveal>{c.kicker}</p>
    <h2 class="display title" id="listening-title" data-reveal>{c.title}</h2>
    <p class="line" data-reveal>{c.line}</p>

    <div class="eye" data-reveal>
      <Symbol size={148} breathe watch />
    </div>

    <p class="status" data-reveal>
      <span class="pulse" aria-hidden="true"></span>
      {c.status}
    </p>

    <ul class="items" role="list">
      {
        c.items.map((item, i) => (
          <li class:list={{ learned: item.learned }} data-reveal style={`--i:${i}`}>
            {item.learned && <span class="mark" aria-hidden="true" />}
            {item.text}
          </li>
        ))
      }
    </ul>
    <p class="learned-note" data-reveal><span class="mark" aria-hidden="true"></span>{c.learnedNote}</p>

    <div class="filter" data-scene>
      <p class="filter-body">{c.filter.body}</p>
      <p class="wrongs">
        {c.filter.wrongs.map((w, i) => <span class="wrong" style={`--w:${i}`}>{w}</span>)}
      </p>
      <p class="gone">{c.filter.gone}</p>
    </div>

    <p class="point heading" data-reveal>{c.point}</p>

    <p class="empty" data-reveal>
      <span class="heading">{c.empty[0]}</span>
      <span>{c.empty[1]}</span>
    </p>
  </div>
</section>

<style>
  .listening {
    --symbol-iris: var(--color-accent-soft);
    padding-block: var(--space-section);
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
    overflow: hidden;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    color: var(--color-accent-soft);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-display-lg);
  }
  .eye {
    margin-top: var(--space-9);
    color: var(--color-text-inverse);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    animation: pulse var(--motion-breath) ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.5;
      scale: 1;
    }
    50% {
      opacity: 1;
      scale: 1.25;
    }
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    max-width: 36rem;
    margin-top: var(--space-6);
  }
  .items li {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    border: var(--border-width) solid rgb(250 248 243 / 0.28);
    border-radius: var(--radius-full);
  }
  /* Learned, not declared: the rules the triage revealed, marked as such. */
  .items li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .learned-note .mark {
    margin-right: var(--space-3);
  }
  .items li.learned {
    background: rgb(250 248 243 / 0.1);
    border-color: var(--color-accent-soft);
  }
  .mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    flex: none;
    vertical-align: 0.1em;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 3px rgb(221 227 216 / 0.25);
  }
  .learned-note {
    margin-top: var(--space-5);
    max-width: 34rem;
    font-size: var(--text-body);
    color: var(--color-accent-soft);
    text-wrap: balance;
  }
  .line {
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-accent-soft);
  }
  /* The filter: four ways an offer is wrong, each struck through, then gone. */
  .filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 40rem;
    margin-top: var(--space-9);
  }
  .filter-body {
    font-size: var(--text-body-lg);
  }
  .wrongs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
  }
  .wrong {
    text-decoration: line-through;
    text-decoration-color: var(--color-accent-soft);
    text-decoration-thickness: 2px;
    opacity: 0.55;
    transition:
      opacity 0.6s ease,
      text-decoration-color 0.6s ease;
    transition-delay: calc(0.3s + var(--w) * 0.45s);
  }
  :global(.motion) .filter:not(.is-playing) .wrong {
    opacity: 1;
    text-decoration-color: transparent;
  }
  .gone {
    color: var(--color-accent-soft);
    transition: opacity 0.6s ease 2.2s;
  }
  :global(.motion) .filter:not(.is-playing) .gone {
    opacity: 0;
  }
  .point {
    margin-top: var(--space-8);
    font-size: var(--text-heading-lg);
  }
  .empty {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-5);
    color: var(--color-accent-soft);
  }
  .empty .heading {
    font-size: var(--text-heading-md);
    color: var(--color-text-inverse);
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
