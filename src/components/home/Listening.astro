---
// The one moment of colour on the page: the listening screen, full bleed in
// moss, with the eye breathing. Almost nothing to read — silence is the point.
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['listening'];
}

const { c } = Astro.props;
---

<section class="listening" aria-labelledby="listening-title">
  <div class="container inner">
    <p class="kicker" data-reveal>{c.kicker}</p>
    <h2 class="display title" id="listening-title" data-reveal>{c.title}</h2>

    <div class="eye" data-reveal>
      <Symbol size={148} breathe watch />
    </div>

    <p class="status" data-reveal>
      <span class="pulse" aria-hidden="true"></span>
      {c.status}
    </p>

    <ul class="items" role="list">
      {
        c.items.map((item, i) => (
          <li class:list={{ learned: item.learned }} data-reveal style={`--i:${i}`}>
            {item.learned && <span class="mark" aria-hidden="true" />}
            {item.text}
          </li>
        ))
      }
    </ul>
    <p class="learned-note" data-reveal><span class="mark" aria-hidden="true"></span>{c.learnedNote}</p>

    <p class="empty" data-reveal>
      <span class="heading">{c.empty[0]}</span>
      <span>{c.empty[1]}</span>
    </p>
  </div>
</section>

<style>
  .listening {
    --symbol-iris: var(--color-accent-soft);
    padding-block: var(--space-section);
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
    overflow: hidden;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    color: var(--color-accent-soft);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-display-lg);
  }
  .eye {
    margin-top: var(--space-9);
    color: var(--color-text-inverse);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    animation: pulse var(--motion-breath) ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.5;
      scale: 1;
    }
    50% {
      opacity: 1;
      scale: 1.25;
    }
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    max-width: 36rem;
    margin-top: var(--space-6);
  }
  .items li {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    border: var(--border-width) solid rgb(250 248 243 / 0.28);
    border-radius: var(--radius-full);
  }
  /* Learned, not declared: the rules the triage revealed, marked as such. */
  .items li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .learned-note .mark {
    margin-right: var(--space-3);
  }
  .items li.learned {
    background: rgb(250 248 243 / 0.1);
    border-color: var(--color-accent-soft);
  }
  .mark {
    display: inline-block;
    width: 8px;
    height: 8px;
    flex: none;
    vertical-align: 0.1em;
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    box-shadow: 0 0 0 3px rgb(221 227 216 / 0.25);
  }
  .learned-note {
    margin-top: var(--space-5);
    max-width: 34rem;
    font-size: var(--text-body);
    color: var(--color-accent-soft);
    text-wrap: balance;
  }
  .empty {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-9);
    color: var(--color-accent-soft);
  }
  .empty .heading {
    font-size: var(--text-heading-md);
    color: var(--color-text-inverse);
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
