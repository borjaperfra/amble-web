---
// Trust, in one section: everything the Rep knows is a file you own.
// Left, career.md writing itself; right, what you can do with it.
import CareerMd from './CareerMd.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['ownership'];
  career: HomeContent['career'];
}

const { c, career } = Astro.props;

---

<section class="own container" aria-labelledby="own-title">
  <header class="head">
    <p class="kicker" data-reveal>{c.kicker}</p>
    <h2 class="display title" id="own-title" data-reveal>
      {c.title[0]}
      <br />
      <em>{c.title[1]}</em>
    </h2>
  </header>

  <div class="grid">
    <CareerMd c={career} />

    <div class="side">
      <p class="heading subtitle" data-reveal>{c.subtitle}</p>
      <p class="actions" data-reveal>
        {c.actions.map((a, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <span>{a.label}</span>
          </>
        ))}
      </p>
      <ul class="lines" role="list">
        {c.lines.map((l, i) => <li data-reveal style={`--i:${i + 4}`}>{l}</li>)}
      </ul>
      <p class="gone heading" data-reveal>{c.gone}</p>
    </div>
  </div>
</section>

<style>
  .own {
    max-width: calc(var(--width-wide) + var(--gutter) * 2);
    padding-block: var(--space-section);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-observation);
  }
  .grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    margin-top: var(--space-scene);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 5fr);
      gap: var(--space-9);
    }
    .grid > :global(.file) {
      max-width: 440px;
      rotate: -1deg;
    }
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .subtitle {
    font-size: var(--text-heading-md);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
  }
  .sep {
    color: var(--color-text-faint);
  }
  @media (max-width: 640px) {
    /* Tighter, so the four verbs stay on one line on a phone. */
    .actions {
      gap: var(--space-2);
    }
  }
  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }
  .gone {
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
  }
</style>
