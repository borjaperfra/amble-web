---
// The distinctive profile (DESIGN_SYSTEM §18) as a poster: three things,
// crossed. Typography and composition do the work; it should be screenshot-worthy.
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['distinctive'];
}

const { c } = Astro.props;
---

<section class="distinctive container" aria-labelledby="distinctive-title">
  <p class="kicker" data-reveal>{c.kicker}</p>
  <h2 class="display words" id="distinctive-title" data-ink>
    {
      c.words.map((w, i) => (
        <>
          {i > 0 && (
            <span class:list={['times', `x${i}`]} aria-hidden="true">
              <span class="word">×</span>
            </span>
          )}
          <span class:list={['term', `t${i}`]}>
            {w.split(' ').map((part) => (
              <span class="word">{part} </span>
            ))}
          </span>
        </>
      ))
    }
  </h2>
  <p class="lede line" data-reveal>{c.line}</p>
</section>

<style>
  .distinctive {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-section);
  }
  .words {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
    font-size: clamp(2.75rem, 0.5rem + 8.4vw, 8.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .t0 {
    align-self: flex-start;
  }
  .t1 {
    align-self: center;
    font-style: italic;
    color: var(--color-accent-strong);
  }
  .t2 {
    align-self: flex-end;
  }
  /* Each × sits on the diagonal between the two terms it joins, with the
     same breathing room above and below. */
  .times {
    align-self: flex-start;
    font-size: 0.6em;
    line-height: 0.9;
    margin-block: 0.08em 0;
    font-style: normal;
    color: var(--color-accent);
  }
  .x1 {
    margin-left: 30%;
  }
  .x2 {
    margin-left: 64%;
  }
  @media (max-width: 640px) {
    .x1 {
      margin-left: 22%;
    }
    .x2 {
      margin-left: 56%;
    }
  }
  .line {
    align-self: flex-end;
    margin-top: var(--space-7);
  }
</style>
