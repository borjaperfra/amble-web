---
import SectionIntro from '../SectionIntro.astro';
import EvidenceDots from '../EvidenceDots.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['map'];
  strength: HomeContent['strength'];
  sourceNames: HomeContent['sourceNames'];
}

const { c, strength, sourceNames } = Astro.props;
---

<section class="section container" aria-labelledby="map-title">
  <SectionIntro id="map-title" kicker={c.kicker} title={c.title} body={c.body} align="center" />

  <figure class="sheet map" data-reveal>
    <header class="map-head">
      <p class="sheet-kicker">{c.sheetKicker}</p>
      <p class="display name">{c.name}</p>
      <p class="headline">{c.headline}</p>
    </header>

    <div class="map-body">
      <div class="col">
        <p class="sheet-kicker">{c.demonstratesLabel}</p>
        <ul class="caps" role="list">
          {
            c.capabilities.map((cap) => (
              <li class="cap">
                <p class="cap-name">{cap.name}</p>
                <EvidenceDots strength={cap.strength} label={strength[cap.strength]} />
                <p class="cap-summary">{cap.summary}</p>
                <p class="cap-sources">
                  {cap.sources.map((s) => <span class="source-tag">{sourceNames[s]}</span>)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <p class="sheet-kicker">{c.distinctiveLabel}</p>
        <p class="distinctive heading">
          {
            c.distinctive.map((d, i) => (
              <>
                {i > 0 && <span class="times" aria-hidden="true">×</span>}
                <span>{d}</span>
              </>
            ))
          }
        </p>

        <p class="sheet-kicker unknown-label">{c.unknownLabel}</p>
        {
          c.unknowns.map((u) => (
            <div class="unknown">
              <p class="cap-name">{u.name}</p>
              <EvidenceDots strength={u.strength} label={strength[u.strength]} />
              <p class="cap-summary">{u.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </figure>
</section>

<style>
  .map {
    margin-top: var(--space-8);
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: clamp(var(--space-5), 1rem + 3vw, var(--space-8));
  }
  .map-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-7);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .name {
    font-size: var(--text-display-lg);
  }
  .headline {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    max-width: 32rem;
  }
  .map-body {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-7);
  }
  @media (min-width: 860px) {
    .map-body {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
    }
  }
  .caps {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .cap,
  .unknown {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cap-name {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
    line-height: var(--leading-tight);
  }
  .cap-summary {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .cap-sources {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }
  .distinctive {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    margin-top: var(--space-5);
    font-size: var(--text-heading-lg);
  }
  .times {
    padding-left: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--text-heading-xl);
    line-height: 0.9;
    color: var(--color-accent);
  }
  .unknown-label {
    margin-top: var(--space-8);
  }
  .unknown {
    margin-top: var(--space-5);
  }
</style>
