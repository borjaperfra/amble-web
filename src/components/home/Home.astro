---
import Base from '../../layouts/Base.astro';
import Hero from './Hero.astro';
import Interlude from './Interlude.astro';
import Story from './Story.astro';
import YourTurn from './YourTurn.astro';
import Interview from './Interview.astro';
import Defence from './Defence.astro';
import MapSection from './MapSection.astro';
import Problem from './Problem.astro';
import Triage from './Triage.astro';
import Listening from './Listening.astro';
import Opportunity from './Opportunity.astro';
import Agents from './Agents.astro';
import Roadmap from './Roadmap.astro';
import CareerMd from './CareerMd.astro';
import YourData from './YourData.astro';
import Finale from './Finale.astro';
import { home } from '../../content/home';
import type { Lang } from '../../i18n/ui';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const c = home[lang];
---

<Base joinHref="#join" stages={c.stages}>
  <main>
    <Hero c={c.hero} />
    <Problem c={c.problem} />
    <div data-stage="reads" id="stage-reads">
      <Interlude lines={c.story.interlude} body={c.story.interludeBody} bridge={c.problem.bridge} id="interlude-pdf" />
      <Story c={c.story} strength={c.strength} sourceNames={c.sourceNames} />
      <MapSection c={c.map} strength={c.strength} />
    </div>
    <div data-stage="asks" id="stage-asks">
      <Interview c={c.interview} sourceNames={c.sourceNames} />
    </div>
    <div data-stage="checks" id="stage-checks">
      <Defence c={c.defence} />
    </div>
    <div data-stage="learns" id="stage-learns">
      <Triage c={c.triage} />
    </div>
    <div data-stage="listens" id="stage-listens">
      <Listening c={c.listening} />
    </div>
    <div data-stage="tells" id="stage-tells">
      <Opportunity c={c.opportunity} />
      <Agents c={c.agents} />
    </div>
    <Roadmap c={c.roadmap} />
    <div data-count="yours">
      <CareerMd c={c.career} />
      <YourData c={c.data} />
    </div>
    <div data-count="turn"><YourTurn c={c.yourTurn} /></div>
    <div data-count="finale"><Finale c={c.finale} /></div>
  </main>
</Base>

<script>
  import { startSmoothScroll, inkStatements } from '../../scripts/motion';
  startSmoothScroll();
  inkStatements();
</script>
