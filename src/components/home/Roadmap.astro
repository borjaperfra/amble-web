---
// The road, drawn and alive: three small loops on one line.
//   v0  your work drifts into the Rep's eye
//   v1  offers stream past a window; only the one that fits lights up
//   v2  two eyes, yours and theirs, passing messages back and forth
import SectionIntro from '../SectionIntro.astro';
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['roadmap'];
}

const { c } = Astro.props;
---

<section class="section container" aria-labelledby="roadmap-title">
  <SectionIntro id="roadmap-title" kicker={c.kicker} title={c.title} align="center" />

  <ol class="road" role="list" data-scene>
    {
      c.steps.map((step, i) => (
        <li class:list={['stop', { current: i === 0 }]} style={`--i:${i}`}>
          <div class="art" aria-hidden="true">
            {i === 0 && <span class="here">{c.now}</span>}
            {i === 0 && <span class="halo" />}
            {i === 0 && (
              <div class="disc v0">
                <Symbol size={46} breathe />
                <span class="map">
                  {[4, 3, 1].map((n, r) => (
                    <span class="row" style={`--r:${r}`}>
                      <span class="bar" />
                      <span class="dots">
                        {[0, 1, 2, 3].map((k) => (
                          <span class:list={['d', { on: k < n }]} style={`--k:${k}`} />
                        ))}
                      </span>
                    </span>
                  ))}
                </span>
              </div>
            )}
            {i === 1 && (
              <div class="disc v1">
                <div class="stream">
                  {Array.from({ length: 12 }, (_, k) => (
                    <span class:list={['bar', { fit: k === 3 || k === 9 }]} />
                  ))}
                </div>
                <span class="window" />
              </div>
            )}
            {i === 2 && (
              <div class="disc v2">
                <span class="chat-b theirs">?</span>
                <span class="chat-b yours">✓</span>
                <span class="chat-b theirs small" />
              </div>
            )}
          </div>
          <p class="version">{step.version}</p>
          <p class="heading stop-title">{step.title}</p>
          <p class="stop-line">{step.line}</p>
          {step.extra && <p class="extra">{step.extra}</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .road {
    position: relative;
    display: grid;
    gap: var(--space-8);
    max-width: var(--width-wide);
    margin: var(--space-8) auto 0;
  }
  @media (min-width: 860px) {
    .road {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    /* The line the stops sit on: solid where we are, dashed where we're going. */
    .road::before,
    .road::after {
      content: '';
      position: absolute;
      top: 138px;
      height: 2px;
      transform-origin: left;
      transition: transform 1.4s var(--ease-standard) 0.2s;
    }
    .road::before {
      left: 17%;
      width: 16%;
      background: var(--color-accent);
    }
    .road::after {
      left: 33%;
      right: 17%;
      background-image: linear-gradient(to right, var(--color-border) 55%, transparent 0);
      background-size: 12px 2px;
      transition-delay: 0.7s;
    }
    .js .road:not(.is-playing)::before,
    .js .road:not(.is-playing)::after {
      transform: scaleX(0);
    }
  }

  .stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }
  .art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 276px;
    margin-bottom: var(--space-3);
  }
  .here {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: var(--color-accent);
    border-radius: var(--radius-full);
    z-index: 2;
  }
  .here::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -5px;
    width: 10px;
    height: 10px;
    background: inherit;
    translate: -50% 0;
    rotate: 45deg;
    border-radius: 2px;
    z-index: -1;
  }
  .disc {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 212px;
    height: 212px;
    border-radius: var(--radius-full);
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-subtle);
    box-shadow: var(--shadow-sheet);
    overflow: hidden;
    color: var(--color-text);
  }
  /* Now: a solid moss ring and a slow halo, so it's unmistakably where we are. */
  .current .disc {
    border: 3px solid var(--color-accent);
    box-shadow:
      0 0 0 10px var(--color-accent-soft),
      var(--shadow-sheet);
  }
  /* The halo sits behind the disc, so the disc can keep its own clipping. */
  .halo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 212px;
    height: 212px;
    translate: -50% -50%;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-accent);
    animation: halo 3.6s ease-out infinite;
    pointer-events: none;
  }
  @keyframes halo {
    from {
      opacity: 0.55;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 1.28;
    }
  }

  /* v0: the eye over a small map — three capabilities whose evidence fills in,
     dot by dot, the language of chapter 1. */
  .v0 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .v0 :global(.symbol) {
    color: var(--color-text);
  }
  .map {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bar {
    width: 58px;
    height: 7px;
    border-radius: 4px;
    background: var(--color-surface-sunken);
  }
  .row:first-child .bar {
    background: var(--color-text-faint);
  }
  .dots {
    display: inline-flex;
    gap: 4px;
  }
  .d {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-accent);
  }
  .d.on {
    background: var(--color-accent);
    animation: fill 4.8s var(--ease-standard) infinite both;
    animation-delay: calc(var(--r) * 0.35s + var(--k) * 0.22s);
  }
  @keyframes fill {
    0%,
    6% {
      background: transparent;
    }
    16%,
    90% {
      background: var(--color-accent);
    }
    100% {
      background: transparent;
    }
  }

  /* v1: offers stream past a window; only the fitting one is moss */
  .v1 .stream {
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: stream 7s linear infinite;
  }
  .v1 .bar {
    display: block;
    width: 112px;
    height: 20px;
    border-radius: 5px;
    background: var(--color-surface-sunken);
  }
  .v1 .bar.fit {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .v1 .window {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 128px;
    height: 36px;
    translate: -50% -50%;
    border: 2px solid var(--color-accent);
    border-radius: 9px;
    box-shadow: 0 0 0 999px rgb(253 252 249 / 0.6);
  }
  @keyframes stream {
    from {
      translate: 0 -90px;
    }
    to {
      translate: 0 90px;
    }
  }

  /* v2: their agent asks (slate), yours answers (moss) — the agent-to-agent scene, in miniature */
  .v2 {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 0 38px;
  }
  .chat-b {
    display: grid;
    place-items: center;
    height: 34px;
    font-weight: var(--weight-semibold);
    border-radius: 14px;
    animation: turn 4.2s var(--ease-standard) infinite both;
  }
  .chat-b.theirs {
    align-self: flex-start;
    width: 86px;
    color: var(--color-other);
    background: var(--color-other-soft);
    border-bottom-left-radius: 5px;
  }
  .chat-b.yours {
    align-self: flex-end;
    width: 104px;
    color: var(--color-text-inverse);
    background: var(--color-accent-strong);
    border-bottom-right-radius: 5px;
    animation-delay: 0.9s;
  }
  .chat-b.small {
    width: 60px;
    height: 26px;
    animation-delay: 1.8s;
  }
  @keyframes turn {
    0%,
    8% {
      opacity: 0;
      translate: 0 6px;
    }
    18%,
    86% {
      opacity: 1;
      translate: none;
    }
    100% {
      opacity: 0;
    }
  }

  .version {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-text-faint);
  }
  .stop-title {
    font-size: var(--text-heading-lg);
  }
  .stop-line {
    max-width: 22ch;
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  .extra {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
    border-radius: var(--radius-full);
  }

  /* Stops arrive in order */
  .js .road .stop {
    transition:
      opacity var(--motion-arrive) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.2s + var(--i) * 0.3s);
  }
  .js .road:not(.is-playing) .stop {
    opacity: 0;
    translate: 0 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    .d.on,
    .v1 .stream,
    .chat-b,
    .halo {
      animation: none;
    }
  }
</style>
