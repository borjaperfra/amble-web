---
// Now / Next / Then as one piece: three points on a line, the first solid,
// the others still ahead. Transparent about what exists.
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['roadmap'];
}

const { c } = Astro.props;
---

<section class="roadmap container" aria-labelledby="roadmap-title">
  <p class="kicker" data-reveal>{c.kicker}</p>
  <h2 class="display title" id="roadmap-title" data-reveal>{c.title}</h2>

  <ol class="line" role="list" data-scene>
    {
      c.steps.map((st, i) => (
        <li class:list={['stop', { now: i === 0, soon: i === 1 }]} style={`--i:${i}`}>
          <span class="when">{st.when}</span>
          <span class="track" aria-hidden="true">
            <span class="point" />
          </span>
          <p class="heading stop-title">{st.title}</p>
          <p class="short">{st.short}</p>
          <p class="detail">{st.line}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .roadmap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-observation);
  }
  .line {
    position: relative;
    display: grid;
    gap: var(--space-8);
    width: 100%;
    max-width: var(--width-wide);
    margin-top: var(--space-scene);
  }
  @media (min-width: 860px) {
    .line {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
  .stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.2s + var(--i) * 0.3s);
  }
  :global(.motion) .line:not(.is-playing) .stop {
    opacity: 0;
    translate: 0 10px;
  }
  .when {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .now .when,
  .soon .when {
    color: var(--color-accent-strong);
  }
  /* The rail: each stop draws its own half-segments from the edge of its
     point, centred on it, so the line never runs through a circle. Solid
     from Now to Soon (nearly there), dashed ahead. */
  .track {
    --gap: 12px; /* air between a point and the line */
    --r: 11px;
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    margin: var(--space-2) 0 var(--space-3);
  }
  .now .track {
    --r: 17px; /* its halo */
  }
  @media (min-width: 860px) {
    .track::before,
    .track::after {
      content: '';
      position: absolute;
      top: 50%;
      height: 2px;
      margin-top: -1px;
      background-image: linear-gradient(to right, var(--color-text-faint) 50%, transparent 0);
      background-size: 10px 2px;
      transform-origin: left;
      transition: scale 0.9s var(--ease-standard);
      transition-delay: calc(0.3s + var(--i) * 0.3s);
    }
    .track::before {
      left: calc(var(--space-6) / -2);
      right: calc(50% + var(--r) + var(--gap));
    }
    .track::after {
      left: calc(50% + var(--r) + var(--gap));
      right: calc(var(--space-6) / -2);
    }
    .stop:first-child .track::before,
    .stop:last-child .track::after {
      display: none;
    }
    .now .track::after,
    .soon .track::before {
      background: var(--color-accent);
    }
    :global(.motion) .line:not(.is-playing) .track::before,
    :global(.motion) .line:not(.is-playing) .track::after {
      scale: 0 1;
    }
  }
  /* Stacked (phones): the rail runs down the left, each stop's words beside
     its point, so the line joins the three points without crossing any text.
     Each stop still draws its own half-segments, from its edges to the air
     around its point. */
  @media (max-width: 859px) {
    .line {
      --pad: var(--space-5); /* half the space between two stops */
      gap: 0;
      max-width: 24rem;
    }
    .stop {
      position: relative;
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr);
      column-gap: var(--space-5);
      row-gap: var(--space-2);
      align-items: start;
      justify-items: start;
      padding-block: var(--pad);
      text-align: left;
    }
    .stop > :not(.track) {
      grid-column: 2;
    }
    .track {
      --gap: 8px;
      grid-column: 1;
      grid-row: 1 / span 4;
      position: static;
      /* the point's centre sits on the "when" line */
      margin: -3px 0 0;
    }
    .detail {
      margin-top: 0;
    }
    .track::before,
    .track::after {
      content: '';
      position: absolute;
      left: 10px;
      width: 2px;
      background-image: linear-gradient(to bottom, var(--color-text-faint) 50%, transparent 0);
      background-size: 2px 10px;
      transform-origin: top;
      transition: scale 0.9s var(--ease-standard);
      transition-delay: calc(0.3s + var(--i) * 0.3s);
    }
    /* point centre: --pad - 3px + 11px */
    .track::before {
      top: 0;
      height: calc(var(--pad) + 8px - var(--r) - var(--gap));
    }
    .track::after {
      top: calc(var(--pad) + 8px + var(--r) + var(--gap));
      bottom: 0;
    }
    .stop:first-child .track::before,
    .stop:last-child .track::after {
      display: none;
    }
    .now .track::after,
    .soon .track::before {
      background: var(--color-accent);
    }
    :global(.motion) .line:not(.is-playing) .track::before,
    :global(.motion) .line:not(.is-playing) .track::after {
      scale: 1 0;
    }
  }
  .point {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 22px;
    background: var(--color-bg);
    border: 2px dashed var(--color-text-faint);
    border-radius: var(--radius-full);
  }
  .now .point {
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 0 6px var(--color-accent-soft);
  }
  /* Soon: nearly done, so no longer dashed. */
  .soon .point {
    border: 2px solid var(--color-accent);
    box-shadow:
      inset 0 0 0 4px var(--color-bg),
      inset 0 0 0 11px var(--color-accent-soft);
  }
  .now .point::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: inherit;
    border: 2px solid var(--color-accent);
    animation: halo 3.2s ease-out infinite;
  }
  @keyframes halo {
    from {
      opacity: 0.6;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 1.8;
    }
  }
  .stop-title {
    font-size: var(--text-heading-lg);
  }
  .short {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }
  .detail {
    max-width: 26ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  @media (prefers-reduced-motion: reduce) {
    .now .point::after {
      animation: none;
    }
  }
</style>
