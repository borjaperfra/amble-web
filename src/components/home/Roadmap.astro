---
// Now / Next / Then as one piece: three points on a line, the first solid,
// the others still ahead. Transparent about what exists.
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['roadmap'];
}

const { c } = Astro.props;
---

<section class="roadmap container" aria-labelledby="roadmap-title">
  <p class="kicker" data-reveal>{c.kicker}</p>
  <h2 class="display title" id="roadmap-title" data-reveal>{c.title}</h2>

  <ol class="line" role="list" data-scene>
    {
      c.steps.map((st, i) => (
        <li class:list={['stop', { now: i === 0 }]} style={`--i:${i}`}>
          <span class="when">{st.when}</span>
          <span class="point" aria-hidden="true" />
          <p class="heading stop-title">{st.title}</p>
          <p class="short">{st.short}</p>
          <p class="detail">{st.line}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .roadmap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-section);
  }
  .title {
    margin-top: var(--space-4);
    font-size: var(--text-display-lg);
  }
  .line {
    position: relative;
    display: grid;
    gap: var(--space-8);
    width: 100%;
    max-width: var(--width-wide);
    margin-top: var(--space-8);
  }
  @media (min-width: 860px) {
    .line {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
    /* The line: solid through Now, dashed ahead. */
    .line::before,
    .line::after {
      content: '';
      position: absolute;
      top: 52px;
      height: 2px;
      transform-origin: left;
      transition: transform 1.2s var(--ease-standard) 0.2s;
    }
    .line::before {
      left: 16.6%;
      width: 16.6%;
      background: var(--color-accent);
    }
    .line::after {
      left: 33.2%;
      right: 16.6%;
      background-image: linear-gradient(to right, var(--color-text-faint) 50%, transparent 0);
      background-size: 10px 2px;
      transition-delay: 0.7s;
    }
    :global(.motion) .line:not(.is-playing)::before,
    :global(.motion) .line:not(.is-playing)::after {
      transform: scaleX(0);
    }
  }
  .stop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-arrive) var(--ease-standard);
    transition-delay: calc(0.2s + var(--i) * 0.3s);
  }
  :global(.motion) .line:not(.is-playing) .stop {
    opacity: 0;
    translate: 0 10px;
  }
  .when {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .now .when {
    color: var(--color-accent-strong);
  }
  .point {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 22px;
    margin: var(--space-2) 0 var(--space-3);
    background: var(--color-bg);
    border: 2px dashed var(--color-text-faint);
    border-radius: var(--radius-full);
  }
  .now .point {
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 0 6px var(--color-accent-soft);
  }
  .now .point::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: inherit;
    border: 2px solid var(--color-accent);
    animation: halo 3.2s ease-out infinite;
  }
  @keyframes halo {
    from {
      opacity: 0.6;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 1.8;
    }
  }
  .stop-title {
    font-size: var(--text-heading-lg);
  }
  .short {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }
  .detail {
    max-width: 26ch;
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    text-wrap: balance;
  }
  @media (prefers-reduced-motion: reduce) {
    .now .point::after {
      animation: none;
    }
  }
</style>
