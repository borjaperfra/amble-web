---
import Waitlist from '../Waitlist.astro';
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['hero'];
  // The "more" link down into the story; the launch page has no story below.
  more?: boolean;
}

const { c, more = true } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title" id="join">
  <Symbol size={108} watch breathe class="eye" />
  <h1 id="hero-title" class="display title rise d1">
    {c.title[0]}
    <br />
    <em>Amble</em>{' '}{c.title[1]}
  </h1>
  <div class="join rise d2">
    <p class="thesis">
      <span>{c.thesis[0]}</span>
      <em>{c.thesis[1]}</em>
    </p>
    <p class="lead">{c.subtitle}</p>
    <div class="form">
      <Waitlist id="hero" note="" />
    </div>
  </div>
  {
    more && (
      <a class="more text-link rise d3" href="#problem">
        {c.more}
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    )
  }
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(var(--space-8), 4rem + 6vw, var(--space-11)) var(--space-section);
  }
  .hero :global(.eye) {
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }
  .title {
    margin-top: var(--space-2);
    font-size: var(--text-display-xl);
  }
  /* One block: what the Rep is, and the form right under it. */
  .join {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 34rem;
    margin-top: var(--space-7);
  }
  .lead {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  /* The thesis in the manifesto's voice; what the Rep does, quieter, under it. */
  .thesis {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    line-height: var(--leading-heading);
    text-wrap: balance;
  }
  .thesis em {
    color: var(--color-accent-strong);
  }
  .thesis + .lead {
    margin-top: var(--space-4);
  }
  .form {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-6);
  }

  .more {
    margin-top: var(--space-9);
    font-size: var(--text-body-sm);
  }
  .arrow {
    display: inline-block;
    animation: nudge 2.4s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      translate: 0 3px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow {
      animation: none;
    }
  }

  .rise {
    animation: rise var(--motion-arrive) var(--ease-standard) both;
  }
  .d1 {
    animation-delay: 90ms;
  }
  .d2 {
    animation-delay: 220ms;
  }
  .d3 {
    animation-delay: 340ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

