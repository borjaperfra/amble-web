---
import Waitlist from '../Waitlist.astro';
import Symbol from '../Symbol.astro';
import type { HomeContent } from '../../content/home';

interface Props {
  c: HomeContent['hero'];
}

const { c } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title" id="join">
  <Symbol size={108} watch breathe class="eye" />
  <p class="live rise" aria-hidden="true" data-live={JSON.stringify(c.status.words)}>
    {c.status.prefix} <span class="live-word">{c.status.words[0]}</span>
  </p>
  <p class="tag rise">
    <span class="tag-dot" aria-hidden="true"></span>
    {c.tag}
  </p>
  <h1 id="hero-title" class="display title rise d1">
    {c.title[0]}
    <br />
    <em>Amble</em>{' '}{c.title[1]}
  </h1>
  <p class="subtitle rise d2">{c.subtitle}</p>
  <div class="form rise d3">
    <Waitlist id="hero" />
  </div>
  <a class="more text-link rise d4" href="#interlude-pdf">
    {c.more}
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(var(--space-8), 4rem + 6vw, var(--space-11)) var(--space-section);
  }
  .hero :global(.eye) {
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }
  /* What the Rep is doing, one quiet line that changes. */
  .live {
    margin: calc(var(--space-4) * -1) 0 var(--space-6);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .live-word {
    display: inline-block;
    color: var(--color-accent-strong);
    font-weight: var(--weight-medium);
    transition:
      opacity var(--motion-slow) ease,
      translate var(--motion-slow) var(--ease-standard);
  }
  .live-word.is-out {
    opacity: 0;
    translate: 0 -4px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 28px;
    padding: 0 var(--space-3);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent-strong);
    background: var(--color-accent-wash);
    border: var(--border-width) solid var(--color-accent-soft);
    border-radius: var(--radius-full);
  }
  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }
  .title {
    margin-top: var(--space-6);
    font-size: var(--text-display-xl);
  }
  .subtitle {
    margin-top: var(--space-6);
    max-width: 34rem;
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .form {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-7);
  }

  .more {
    margin-top: var(--space-8);
    font-size: var(--text-body-sm);
  }
  .arrow {
    display: inline-block;
    animation: nudge 2.4s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      translate: 0 3px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow {
      animation: none;
    }
  }

  .rise {
    animation: rise var(--motion-arrive) var(--ease-standard) both;
  }
  .d1 {
    animation-delay: 90ms;
  }
  .d2 {
    animation-delay: 220ms;
  }
  .d3 {
    animation-delay: 340ms;
  }
  .d4 {
    animation-delay: 460ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  const live = document.querySelector<HTMLElement>('[data-live]');
  if (live && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(live.dataset.live ?? '[]');
    const word = live.querySelector<HTMLElement>('.live-word')!;
    let i = 0;
    setInterval(() => {
      word.classList.add('is-out');
      setTimeout(() => {
        i = (i + 1) % words.length;
        word.textContent = words[i];
        word.classList.remove('is-out');
      }, 380);
    }, 2800);
  }
</script>
