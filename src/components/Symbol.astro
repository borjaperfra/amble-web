---
// The Amble symbol: a calm, half-lidded eye that looks out for you.
//
// The lid is one brush stroke, heavy where it starts and dry where it lifts
// off; it rests over the iris, so the eye is relaxed, never wide open. The iris
// is the Rep, the same moss dot that breathes when it's listening. Generated by
// design/symbol-c.mjs: change the geometry there, not here.
interface Props {
  size?: number;
  // The dot breathes, as on the listening screen (DESIGN_SYSTEM §22).
  breathe?: boolean;
  // The lid draws itself in and the iris follows the pointer, gently.
  watch?: boolean;
  label?: string;
  class?: string;
}

const { size = 28, breathe = false, watch = false, label, class: className } = Astro.props;
const clipId = `lid-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['symbol', className, { breathe, watch }]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {
    watch && (
      <defs>
        <clipPath id={clipId}>
          <rect class="draw" x="0" y="0" width="48" height="48" />
        </clipPath>
      </defs>
    )
  }
  <g class="iris"><path class="dot" d="M32.65 29.46C32.38 30.46 31.76 31.47 31.09 32.26C30.42 33.04 29.51 33.70 28.61 34.17C27.72 34.63 26.68 34.96 25.70 35.06C24.72 35.16 23.64 35.06 22.72 34.77C21.79 34.48 20.89 33.94 20.15 33.34C19.41 32.73 18.80 31.96 18.28 31.15C17.76 30.34 17.30 29.45 17.03 28.49C16.76 27.52 16.53 26.41 16.65 25.37C16.77 24.33 17.13 23.12 17.75 22.27C18.36 21.41 19.39 20.65 20.35 20.24C21.32 19.84 22.52 19.80 23.52 19.85C24.51 19.90 25.46 20.24 26.35 20.55C27.24 20.86 28.06 21.21 28.86 21.70C29.67 22.19 30.55 22.74 31.19 23.49C31.83 24.25 32.46 25.24 32.70 26.24C32.95 27.23 32.92 28.45 32.65 29.46Z" /></g>
  <path class="lid" clip-path={watch ? `url(#${clipId})` : undefined} d="M4.89 26.27C4.95 25.95 5.09 24.98 5.26 24.34C5.43 23.70 5.65 23.05 5.92 22.42C6.19 21.79 6.51 21.17 6.88 20.57C7.24 19.98 7.67 19.39 8.13 18.85C8.59 18.31 9.10 17.78 9.65 17.31C10.20 16.83 10.80 16.39 11.42 15.99C12.04 15.60 12.70 15.24 13.37 14.92C14.04 14.60 14.73 14.31 15.44 14.06C16.14 13.81 16.87 13.59 17.60 13.41C18.33 13.23 19.08 13.09 19.83 12.99C20.58 12.88 21.34 12.82 22.09 12.79C22.85 12.76 23.61 12.77 24.36 12.82C25.11 12.87 25.87 12.95 26.61 13.07C27.35 13.19 28.08 13.35 28.80 13.54C29.52 13.74 30.22 13.97 30.91 14.23C31.59 14.49 32.27 14.78 32.91 15.11C33.55 15.44 34.18 15.80 34.78 16.18C35.37 16.57 35.94 16.98 36.48 17.42C37.02 17.86 37.53 18.33 38.00 18.81C38.48 19.30 38.92 19.81 39.32 20.34C39.72 20.86 40.09 21.41 40.41 21.96C40.74 22.51 41.02 23.09 41.27 23.66C41.51 24.24 41.71 24.82 41.87 25.41C42.02 26.00 42.14 26.88 42.19 27.18L41.71 27.32C41.57 27.08 41.16 26.33 40.84 25.86C40.53 25.39 40.20 24.94 39.85 24.51C39.49 24.07 39.11 23.66 38.71 23.27C38.31 22.88 37.88 22.51 37.44 22.16C36.99 21.81 36.53 21.48 36.05 21.17C35.57 20.86 35.06 20.58 34.55 20.32C34.04 20.06 33.51 19.82 32.97 19.60C32.43 19.39 31.87 19.20 31.31 19.03C30.75 18.86 30.17 18.72 29.59 18.60C29.02 18.48 28.43 18.38 27.84 18.31C27.25 18.24 26.66 18.20 26.06 18.18C25.47 18.15 24.87 18.16 24.28 18.19C23.69 18.21 23.10 18.26 22.52 18.34C21.94 18.41 21.36 18.51 20.79 18.63C20.23 18.76 19.66 18.90 19.12 19.06C18.57 19.23 18.03 19.42 17.51 19.62C16.99 19.83 16.48 20.06 15.99 20.30C15.51 20.55 15.04 20.82 14.57 21.09C14.11 21.36 13.67 21.64 13.23 21.93C12.79 22.22 12.37 22.51 11.95 22.81C11.53 23.12 11.12 23.43 10.72 23.76C10.33 24.09 9.94 24.42 9.56 24.79C9.19 25.15 8.83 25.52 8.49 25.92C8.16 26.32 7.70 26.97 7.54 27.18Z" />
</svg>

<style>
  .symbol {
    flex: none;
    overflow: visible;
  }
  .lid {
    fill: currentColor;
  }
  .dot {
    fill: var(--symbol-iris, var(--color-accent));
    transform-origin: 24.6px 27.4px;
  }
  .breathe .dot {
    animation: breathe var(--motion-breath) ease-in-out infinite;
  }

  /* Watch: the eye opens once, then looks where you look. */
  .watch .draw {
    transform-origin: 4px 0;
    animation: draw 1.5s var(--ease-standard) 0.15s both;
  }
  .watch .iris {
    transition: transform 1.2s var(--ease-standard);
    animation: open var(--motion-arrive) ease 1.05s both;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes open {
    from {
      opacity: 0;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .breathe .dot,
    .watch .draw,
    .watch .iris {
      animation: none;
    }
  }
</style>

<script>
  // The iris drifts at most a couple of units toward the pointer, slowly.
  const eyes = document.querySelectorAll<SVGSVGElement>('svg.symbol.watch');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (eyes.length && !still) {
    let frame = 0;
    window.addEventListener(
      'pointermove',
      (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          for (const eye of eyes) {
            const box = eye.getBoundingClientRect();
            const dx = event.clientX - (box.left + box.width / 2);
            const dy = event.clientY - (box.top + box.height / 2);
            const reach = Math.min(1, Math.hypot(dx, dy) / 600);
            const angle = Math.atan2(dy, dx);
            const x = Math.cos(angle) * 2.2 * reach;
            const y = Math.max(-0.6, Math.sin(angle) * 1.6 * reach);
            eye.querySelector<SVGGElement>('.iris')!.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)`;
          }
        });
      },
      { passive: true },
    );
  }
</script>
