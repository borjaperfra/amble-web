---
// The Amble symbol: a calm, half-lidded eye that looks out for you.
//
// The lid is one brush stroke, heavy where it starts and dry where it lifts
// off; it rests over the iris, so the eye is relaxed, never wide open. The iris
// is the Rep, the same moss dot that breathes when it's listening.
//
// The lid's geometry lives in src/lib/eye.ts, open and closed, so the eye can
// blink: the lid sweeps down over the iris and the iris is clipped to the
// lid's edge, so it disappears from the top, the way an eye closes.
import { OPEN, lidPath, irisClipPath } from '../lib/eye';

interface Props {
  size?: number;
  // The dot breathes, as on the listening screen (DESIGN_SYSTEM §22).
  breathe?: boolean;
  // The lid draws itself in and the iris follows the pointer, gently.
  watch?: boolean;
  label?: string;
  class?: string;
}

const { size = 28, breathe = false, watch = false, label, class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const clipId = `lid-${uid}`;
const irisId = `iris-${uid}`;
---

<svg
  class:list={['symbol', className, { breathe, watch }]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <clipPath id={irisId}>
      <path class="iris-clip" d={irisClipPath(OPEN)} />
    </clipPath>
    {
      watch && (
        <clipPath id={clipId}>
          <rect class="draw" x="0" y="0" width="48" height="48" />
        </clipPath>
      )
    }
  </defs>
  <g clip-path={`url(#${irisId})`}>
    <g class="iris"><path class="dot" d="M32.65 29.46C32.38 30.46 31.76 31.47 31.09 32.26C30.42 33.04 29.51 33.70 28.61 34.17C27.72 34.63 26.68 34.96 25.70 35.06C24.72 35.16 23.64 35.06 22.72 34.77C21.79 34.48 20.89 33.94 20.15 33.34C19.41 32.73 18.80 31.96 18.28 31.15C17.76 30.34 17.30 29.45 17.03 28.49C16.76 27.52 16.53 26.41 16.65 25.37C16.77 24.33 17.13 23.12 17.75 22.27C18.36 21.41 19.39 20.65 20.35 20.24C21.32 19.84 22.52 19.80 23.52 19.85C24.51 19.90 25.46 20.24 26.35 20.55C27.24 20.86 28.06 21.21 28.86 21.70C29.67 22.19 30.55 22.74 31.19 23.49C31.83 24.25 32.46 25.24 32.70 26.24C32.95 27.23 32.92 28.45 32.65 29.46Z" /></g>
  </g>
  <path class="lid" clip-path={watch ? `url(#${clipId})` : undefined} d={lidPath(OPEN)} />
</svg>

<style>
  .symbol {
    flex: none;
    overflow: visible;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lid {
    fill: currentColor;
  }
  .dot {
    fill: var(--symbol-iris, var(--color-accent));
    transform-origin: 24.6px 27.4px;
  }
  .breathe .dot {
    animation: breathe var(--motion-breath) ease-in-out infinite;
  }

  /* Watch: the eye opens once, then looks where you look. */
  .watch .draw {
    transform-origin: 4px 0;
    animation: draw 1.5s var(--ease-standard) 0.15s both;
  }
  .watch .iris {
    animation: open var(--motion-arrive) ease 1.05s both;
    will-change: transform;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes open {
    from {
      opacity: 0;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .breathe .dot,
    .watch .draw,
    .watch .iris {
      animation: none;
    }
  }
</style>

<script>
  import { OPEN, CLOSED, mix, lidPath, irisClipPath } from '../lib/eye';

  // Blink: the lid sweeps down fast, rests a beat, and lifts a little slower —
  // the rhythm of a real blink. Driven frame by frame by interpolating the lid
  // between its open and closed shapes.
  const CLOSE_MS = 120;
  const HOLD_MS = 110;
  const OPEN_MS = 300;
  const easeIn = (t: number) => t * t * t;
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  const blinking = new WeakSet<SVGSVGElement>();
  function blink(eye: SVGSVGElement, hold = HOLD_MS) {
    if (blinking.has(eye)) return;
    const lid = eye.querySelector<SVGPathElement>('.lid');
    const clip = eye.querySelector<SVGPathElement>('.iris-clip');
    if (!lid || !clip) return;
    blinking.add(eye);
    const total = CLOSE_MS + hold + OPEN_MS;
    const t0 = performance.now();
    const frame = (now: number) => {
      const e = now - t0;
      const k =
        e < CLOSE_MS ? easeIn(e / CLOSE_MS) : e < CLOSE_MS + hold ? 1 : 1 - easeOut((e - CLOSE_MS - hold) / OPEN_MS);
      const shape = mix(OPEN, CLOSED, Math.max(0, Math.min(1, k)));
      lid.setAttribute('d', lidPath(shape));
      clip.setAttribute('d', irisClipPath(shape));
      if (e < total) requestAnimationFrame(frame);
      else {
        lid.setAttribute('d', lidPath(OPEN));
        clip.setAttribute('d', irisClipPath(OPEN));
        blinking.delete(eye);
      }
    };
    requestAnimationFrame(frame);
  }

  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Any eye closes when clicked or tapped — a longer, deliberate close. Inside a
  // link (the logo), the eye itself only blinks; the wordmark still navigates.
  document.addEventListener('click', (event) => {
    const eye = (event.target as Element | null)?.closest?.('svg.symbol') as SVGSVGElement | null;
    if (!eye) return;
    if (eye.closest('a')) event.preventDefault();
    if (!calm) blink(eye, 420);
  });

  // Watching eyes blink on their own now and then, unhurried.
  if (!calm) {
    for (const eye of document.querySelectorAll<SVGSVGElement>('svg.symbol.watch')) {
      const next = () =>
        window.setTimeout(() => {
          const box = eye.getBoundingClientRect();
          const visible = box.bottom > 0 && box.top < window.innerHeight && !document.hidden;
          if (visible) blink(eye);
          next();
        }, 4500 + Math.random() * 5500);
      next();
    }
  }

  // The iris follows the pointer: quickly enough to feel alive, eased so it
  // never jitters. It travels inside the eye — mostly sideways, a little down,
  // never up past the lid — and settles back to centre when the pointer leaves.
  const eyes = [...document.querySelectorAll<SVGSVGElement>('svg.symbol.watch')];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (eyes.length && !still) {
    const RANGE_X = 5.2; // viewBox units
    const RANGE_UP = 1.2;
    const RANGE_DOWN = 3;
    const FULL_AT = 260; // px from the eye where the iris reaches its edge

    const state = eyes.map((eye) => ({
      iris: eye.querySelector<SVGGElement>('.iris')!,
      eye,
      x: 0,
      y: 0,
      tx: 0,
      ty: 0,
    }));
    let pointer: { x: number; y: number } | null = null;
    let running = false;

    const aim = () => {
      for (const s of state) {
        if (!pointer) {
          s.tx = 0;
          s.ty = 0;
          continue;
        }
        const box = s.eye.getBoundingClientRect();
        const dx = pointer.x - (box.left + box.width / 2);
        const dy = pointer.y - (box.top + box.height * 0.57);
        const dist = Math.hypot(dx, dy) || 1;
        const reach = Math.min(1, dist / FULL_AT);
        s.tx = (dx / dist) * RANGE_X * reach;
        const vy = (dy / dist) * reach;
        s.ty = vy < 0 ? vy * RANGE_UP : vy * RANGE_DOWN;
      }
    };

    const tick = () => {
      let moving = false;
      for (const s of state) {
        s.x += (s.tx - s.x) * 0.16;
        s.y += (s.ty - s.y) * 0.16;
        if (Math.abs(s.tx - s.x) > 0.01 || Math.abs(s.ty - s.y) > 0.01) moving = true;
        s.iris.style.transform = `translate(${s.x.toFixed(2)}px, ${s.y.toFixed(2)}px)`;
      }
      running = moving;
      if (moving) requestAnimationFrame(tick);
    };

    const wake = () => {
      aim();
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    window.addEventListener('pointermove', (e) => ((pointer = { x: e.clientX, y: e.clientY }), wake()), { passive: true });
    window.addEventListener('scroll', wake, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => ((pointer = null), wake()));
  }
</script>
