---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import Waitlist from './Waitlist.astro';
import Logo from './Logo.astro';
import Symbol from './Symbol.astro';
import { useTranslations, type Lang } from '../i18n/ui';

// The quiet page after the waitlist form without JavaScript. It is static, so
// the error variant is picked from the query string on the client. Joining is
// the activation: the eye wakes.
interface Props {
  kind: 'joined';
}

const { kind } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const errors = {
  invalid: t('waitlist.invalid'),
  'slow-down': t('waitlist.slow-down'),
  error: t('waitlist.error'),
};
---

<Base path={kind} chrome={false}>
  <main class="notice">
    <Logo />

    <section data-variant="default">
      <Symbol size={120} wake watch breathe class="awake" />
      <h1 class="heading">{t(`${kind}.title`)}</h1>
      <p>{t(`${kind}.body`)}</p>
    </section>

    {
      kind === 'joined' && (
        <section data-variant="error" hidden>
          <h1 class="heading" data-error-text data-errors={JSON.stringify(errors)} />
          <Waitlist id="retry" />
        </section>
      )
    }

    <a class="text-link" href={getRelativeLocaleUrl(lang)}>← {t('back')}</a>
  </main>
</Base>

<style>
  .notice {
    min-height: 100svh;
    max-width: var(--width-reading);
    margin: 0 auto;
    padding: var(--space-7) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-7);
  }
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  section :global(.awake) {
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  section[hidden] {
    display: none;
  }
  h1 {
    font-size: var(--text-heading-xl);
  }
  section p {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }
  .text-link {
    align-self: flex-start;
    text-decoration: none;
  }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const show = (variant: string) => {
    for (const s of document.querySelectorAll<HTMLElement>('[data-variant]')) {
      s.hidden = s.dataset.variant !== variant;
    }
  };
  const error = params.get('error');
  const target = document.querySelector<HTMLElement>('[data-error-text]');
  if (error && target) {
    const errors = JSON.parse(target.dataset.errors ?? '{}');
    target.textContent = errors[error] ?? errors.error;
    show('error');
  }
</script>
