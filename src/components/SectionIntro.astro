---
// The head of every home section: kicker, serif title, at most one short line.
interface Props {
  kicker: string;
  title: string;
  body?: string;
  id?: string;
  align?: 'start' | 'center';
  level?: 'chapter' | 'observation';
}

const { kicker, title, body, id, align = 'start', level = 'chapter' } = Astro.props;
---

<div class:list={['intro', align]} data-reveal>
  <p class="kicker">{kicker}</p>
  <h2 class:list={['heading', 'title', level]} id={id}>{title}</h2>
  {body && <p class="lede">{body}</p>}
</div>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 44rem;
  }
  .intro.center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
    max-width: 52rem;
  }
  .title.chapter {
    font-size: var(--text-chapter);
  }
  .title.observation {
    font-size: var(--text-observation);
  }
  .lede {
    max-width: 34rem;
    margin-top: var(--space-2);
  }
</style>
