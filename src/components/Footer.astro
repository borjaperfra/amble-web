---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Symbol from './Symbol.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  path?: string;
}

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const { path = '' } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
---

<footer class="footer">
  <div class="container">
    <div class="row">
      <p class="tagline">{t('footer.tagline')}</p>
      <nav class="links" aria-label={t('footer.label')}>
        <a class="text-link" href={getRelativeLocaleUrl(lang, 'companies')}>{t('nav.companies')}</a>
        <a class="text-link" href={getRelativeLocaleUrl(lang, 'manifesto')}>{t('nav.manifesto')}</a>
        <a class="text-link" href={getRelativeLocaleUrl(lang, 'how-its-built')}>{t('nav.howBuilt')}</a>
        <a class="text-link" href={getRelativeLocaleUrl(lang, 'privacy')}>{t('footer.privacy')}</a>
        <a class="text-link" href={getRelativeLocaleUrl(other, path)} hreflang={other} lang={other}>{t('nav.otherLang')}</a>
        <span class="copy">© 2026 Amble</span>
      </nav>
    </div>

    <!-- The sign-off: the wordmark at full width, the eye still watching. -->
    <a class="signoff" href={getRelativeLocaleUrl(lang)} aria-label="Amble">
      <Symbol size={0} watch breathe class="signoff-eye" />
      <span class="signoff-word" aria-hidden="true">amble</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-9);
    overflow: hidden;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }
  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-heading-sm);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-body-sm);
  }
  .copy {
    color: var(--color-text-faint);
  }

  .signoff {
    display: flex;
    align-items: center;
    gap: 0.06em;
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: clamp(6rem, 1rem + 24vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--color-text);
    text-decoration: none;
    translate: -0.04em 0.12em;
  }
  .signoff :global(.signoff-eye) {
    width: 0.72em;
    height: 0.72em;
    translate: 0 0.06em;
  }
  .signoff-word {
    padding-bottom: 0.1em;
  }
</style>
