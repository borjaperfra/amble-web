---
// A pipeline drawn as steps and arrows, for the long-form pages. The last
// `emphasis` steps are shown in moss: where the idea lands. Long pipelines
// break into two even rows, the second picking up with an arrow, so no step
// is ever left alone on a line; on phones the steps run down the page.
interface Props {
  steps: string[];
  emphasis?: number;
  label?: string;
}

const { steps, emphasis = 1, label } = Astro.props;
const split = steps.length > 4 ? Math.ceil(steps.length / 2) : steps.length;
const rows = [steps.slice(0, split), steps.slice(split)].filter((r) => r.length);
const strong = (i: number) => i >= steps.length - emphasis;
---

<figure class="flow" aria-label={label ?? steps.join(' → ')}>
  {
    rows.map((row, r) => (
      <ol role="list" class:list={['row', { cont: r > 0 }]} aria-hidden="true">
        {row.map((step, j) => (
          <li class:list={{ strong: strong(r * split + j) }}>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    ))
  }
</figure>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }
  .row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
  }
  li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  li span {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
  }
  li.strong span {
    color: var(--color-text-inverse);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  li + li::before,
  .cont li:first-child::before {
    content: '→';
    padding: 0 var(--space-2);
    color: var(--color-accent);
  }
  .cont li:first-child::before {
    padding-left: 0;
  }

  /* Phones: one step per line, arrows pointing down. */
  @media (max-width: 640px) {
    .flow,
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    li {
      flex-direction: column;
      align-items: flex-start;
    }
    li + li::before,
    .cont li:first-child::before {
      content: '↓';
      padding: var(--space-1) 0 var(--space-1) var(--space-4);
    }
  }
</style>
