---
// Agent ↔ Rep, as calm as it should feel: two small eyes far apart, one
// hairline between them. Signals travel along it and come back answered;
// when everything aligns, a small point appears in the middle.
//
// On phones the line turns vertical: company above, Rep below.
import Symbol from './Symbol.astro';

interface Props {
  left: string; // the company's agent
  right: string; // the person's Rep
  signals: string[];
  result: string;
  note?: string;
}

const { left, right, signals, result, note } = Astro.props;
---

<figure class="agentline" data-scene data-agentline style={`--n:${signals.length}`}>
  <div class="track">
    <span class="end left">
      <span class="face other"><Symbol size={22} class="mirror" /></span>
      <span class="who">{left}</span>
    </span>

    <span class="wire" aria-hidden="true">
      {signals.map((_, i) => <span class="pulse" style={`--i:${i}`} />)}
      <span class="meet" />
    </span>

    <span class="end right">
      <span class="face"><Symbol size={22} /></span>
      <span class="who">{right}</span>
    </span>
  </div>

  <ol class="signals" role="list">
    {signals.map((s, i) => <li style={`--i:${i}`}><span class="tick" aria-hidden="true">✓</span>{s}</li>)}
  </ol>

  <p class="result">{result}</p>
  {note && <p class="note">{note}</p>}
</figure>

<style>
  .agentline {
    --step: 1.1s;
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .track {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
  }
  .end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .face {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--color-text);
  }
  .face.other {
    --symbol-iris: var(--color-other);
    color: var(--color-other);
  }
  .face :global(.mirror) {
    scale: -1 1;
  }
  .who {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .left .who {
    color: var(--color-other);
  }
  .wire {
    position: relative;
    height: 1px;
    margin-bottom: 26px; /* aligns with the eyes, above the labels */
    background: var(--color-text-faint);
  }
  /* A signal leaves the company, reaches the Rep, and comes back answered. */
  .pulse {
    position: absolute;
    top: 50%;
    left: 0;
    width: 7px;
    height: 7px;
    translate: -50% -50%;
    border-radius: var(--radius-full);
    background: var(--color-other);
    opacity: 0;
  }
  .agentline.is-playing .pulse {
    animation: round-trip var(--step) var(--ease-standard) both;
    animation-delay: calc(0.3s + var(--i) * var(--step));
  }
  @keyframes round-trip {
    0% {
      left: 0;
      opacity: 0;
      background: var(--color-other);
    }
    10% {
      opacity: 1;
    }
    50% {
      left: 100%;
      background: var(--color-other);
    }
    55% {
      background: var(--color-accent);
    }
    95% {
      opacity: 1;
    }
    100% {
      left: 0;
      opacity: 0;
      background: var(--color-accent);
    }
  }
  .meet {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 11px;
    translate: -50% -50%;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-wash);
    transition:
      opacity 0.6s ease,
      scale 0.8s var(--ease-standard);
    transition-delay: calc(0.4s + var(--n) * var(--step));
  }

  .signals {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-3);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }
  .signals li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: opacity 0.5s ease;
    transition-delay: calc(0.3s + (var(--i) + 1) * var(--step));
  }
  .tick {
    color: var(--color-accent);
  }
  .result {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-heading-md);
    color: var(--color-accent-strong);
    transition: opacity 0.6s ease;
    transition-delay: calc(0.6s + var(--n) * var(--step));
  }
  .note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    transition: opacity 0.6s ease;
    transition-delay: calc(0.9s + var(--n) * var(--step));
  }

  :global(.motion) .agentline:not(.is-playing) :is(.signals li, .result, .note) {
    opacity: 0;
  }
  :global(.motion) .agentline:not(.is-playing) .meet {
    opacity: 0;
    scale: 0.3;
  }

  /* Phones: the line stands up. */
  @media (max-width: 640px) {
    .track {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-3);
    }
    .wire {
      width: 1px;
      height: 120px;
      margin: 0;
    }
    .agentline.is-playing .pulse {
      animation-name: round-trip-v;
    }
    @keyframes round-trip-v {
      0% {
        left: 50%;
        top: 0;
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      50% {
        top: 100%;
        background: var(--color-other);
      }
      55% {
        background: var(--color-accent);
      }
      100% {
        left: 50%;
        top: 0;
        opacity: 0;
        background: var(--color-accent);
      }
    }
    .meet {
      top: 50%;
      left: 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }
  }
</style>
