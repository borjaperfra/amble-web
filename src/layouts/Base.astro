---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/sheet.css';

interface Props {
  title?: string;
  description?: string;
  // Path without locale prefix, used for hreflang alternates and the language switch.
  path?: string;
  // Header and footer. The quiet pages (joined, confirmed) go without.
  chrome?: boolean;
  joinHref?: string;
  stages?: { id: string; label: string }[];
}

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const {
  title = t('meta.title'),
  description = t('meta.description'),
  path = '',
  chrome = true,
  joinHref,
  stages,
} = Astro.props;
const canonical = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl('en', path), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(getRelativeLocaleUrl('es', path), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('en', path), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={new URL(`/og-${lang}.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Amble" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-newsreader" preload />
    <script is:inline define:vars={{ away: t('tab.away') }}>
      document.documentElement.classList.add('js');
      // In the background the tab says so, and its eye closes.
      document.addEventListener('visibilitychange', () => {
        const icon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        if (document.hidden) {
          document.documentElement.dataset.title = document.title;
          document.title = away;
          icon?.setAttribute('href', '/favicon-closed.svg');
        } else if (document.documentElement.dataset.title) {
          document.title = document.documentElement.dataset.title;
          icon?.setAttribute('href', '/favicon.svg');
        }
      });
    </script>
  </head>
  <body>
    {chrome && <Header path={path} joinHref={joinHref} stages={stages} />}
    <slot />
    {chrome && <Footer path={path} />}

    <script>
      // Things settle into place as they arrive, once (DESIGN_SYSTEM §12).
      const items = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      items.forEach((el) => observer.observe(el));

      // Scenes play once, when they reach the middle of the screen.
      const scenes = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-playing');
            entry.target.dispatchEvent(new CustomEvent('scene:play'));
            scenes.unobserve(entry.target);
          }
        },
        { rootMargin: '-30% 0px -30% 0px' },
      );
      document.querySelectorAll('[data-scene]').forEach((el) => scenes.observe(el));

      // Anonymous counts: a view, and how far down the story people get. No
      // cookies, no identifiers; skipped entirely under Do Not Track or GPC.
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
      if (!nav.globalPrivacyControl && nav.doNotTrack !== '1' && 'sendBeacon' in navigator) {
        const lang = document.documentElement.lang === 'es' ? 'es' : 'en';
        const ping = (msg: string) => navigator.sendBeacon('/api/beacon', msg);
        ping(`view:${lang}`);
        const reached = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              ping(`stage:${lang}:${el.dataset.stage ?? el.dataset.count}`);
              reached.unobserve(el);
            }
          },
          { rootMargin: '-40% 0px -40% 0px' },
        );
        document.querySelectorAll('[data-stage], [data-count]').forEach((el) => reached.observe(el));
      }
    </script>
  </body>
</html>
